<Project Sdk="Microsoft.NET.Sdk.Web">

    <ItemGroup>
      <ProjectReference Include="..\CafeStock.Back\CafeStock.Back.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Blazor-ApexCharts" Version="7.0.0" />
      <PackageReference Include="MailKit" Version="4.17.0" />
      <PackageReference Include="MudBlazor" Version="9.7.0" />
      <PackageReference Include="QuestPDF" Version="2026.7.1" />
      <!-- Dependencia transitiva de MimeKit/MailKit fijada a una versión parcheada.
           La 10.0.0 arrastra GHSA-846f-f764-76mx (alta) y GHSA-2fmv-rv2c-59x7 (moderada).
           Se puede quitar cuando MailKit/MimeKit dependan ya de una versión corregida. -->
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
      <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    </PropertyGroup>

</Project>
