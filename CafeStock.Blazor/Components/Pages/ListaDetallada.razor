@page "/lista-detallada"
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Productos</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Productos</MudText>
</div>

<div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Href="/productos/nuevo"
               Class="mb-4">
        Añadir producto
    </MudButton>
</div>

<div class="d-flex justify-center mb-4">
    <MudPaper Elevation="3" Style="border-radius:9999px; max-width:400px; width:100%; padding:2px 20px;">
        <MudTextField T="string"
                      @bind-Value="_busqueda"
                      @bind-Value:after="ActualizarUrl"
                      Immediate="true"
                      Placeholder="Buscar producto..."
                      Variant="Variant.Text"
                      Underline="false"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"/>
    </MudPaper>
</div>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_productos.Any())
{
    <MudAlert Severity="Severity.Info">No hay productos registrados.</MudAlert>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-4">
        <MudChip T="string" Color="@(_proveedorSeleccionado is null ? Color.Primary : Color.Default)"
                 Variant="@(_proveedorSeleccionado is null ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => FiltrarPorProveedor(null))">
            Todos
        </MudChip>
        @foreach (var proveedor in _proveedores)
        {
            <MudChip T="string" Color="@(_proveedorSeleccionado == proveedor.Id ? Color.Primary : Color.Default)"
                     Variant="@(_proveedorSeleccionado == proveedor.Id ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => FiltrarPorProveedor(proveedor.Id))">
                @proveedor.Nombre
            </MudChip>
        }
    </div>

    @if (!_productosFiltrados.Any())
    {
        <MudAlert Severity="Severity.Info">No hay productos que coincidan con estos filtros.</MudAlert>
    }
    else if (!_mostrarSeccionesUnidad)
    {
        @TarjetasProductos(_productosFiltrados)
    }
    else
    {
        @if (_productosFiltrados.Any(p => p.Unidad.Grupo() == GrupoUnidadMedida.Peso))
        {
            <MudText Typo="Typo.h6" Class="mb-2" Style="color:#3E2723;">@SeccionesUnidadLabels.UsoCafeteria</MudText>
            @TarjetasProductos(_productosFiltrados.Where(p => p.Unidad.Grupo() == GrupoUnidadMedida.Peso))
        }
        @if (_productosFiltrados.Any(p => p.Unidad.Grupo() == GrupoUnidadMedida.Unidad))
        {
            <MudText Typo="Typo.h6" Class="mb-2 mt-6" Style="color:#3E2723;">@SeccionesUnidadLabels.VentaAlPublico</MudText>
            @TarjetasProductos(_productosFiltrados.Where(p => p.Unidad.Grupo() == GrupoUnidadMedida.Unidad))
        }
        @if (_productosFiltrados.Any(p => p.Unidad.Grupo() == GrupoUnidadMedida.SinClasificar))
        {
            <MudText Typo="Typo.h6" Class="mb-2 mt-6" Style="color:#3E2723;">Sin clasificar</MudText>
            @TarjetasProductos(_productosFiltrados.Where(p => p.Unidad.Grupo() == GrupoUnidadMedida.SinClasificar))
        }
    }
}

@code {
    // El filtro (proveedor + búsqueda) vive en la query string para que al pulsar
    // "atrás" desde la ficha de un producto se recupere tal cual estaba.
    [Parameter, SupplyParameterFromQuery(Name = "proveedor")] public int? ProveedorQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? BusquedaQuery { get; set; }

    private IEnumerable<Producto> _productos = [];
    private IEnumerable<Proveedor> _proveedores = [];
    private Dictionary<int, string> _proveedoresPorId = [];
    private int? _proveedorSeleccionado;
    private bool _cargando = true;
    private string _busqueda = string.Empty;
    private bool _restaurarPosicion;

    private IEnumerable<Producto> _productosFiltrados =>
        _productos
            .Where(p => string.IsNullOrWhiteSpace(_busqueda) || p.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
            .Where(p => _proveedorSeleccionado is null || p.ProveedorId == _proveedorSeleccionado);

    // División puramente visual de las tarjetas por tipo de unidad de medida
    // (ver CafeStock.Blazor.Services.UnidadMedidaExtensions), solo cuando el
    // filtro activo es un proveedor concreto CON Proveedor.AgruparPorTipoUnidad
    // activo (hoy, solo Puchero). No basta con que el proveedor tenga productos
    // en más de un GrupoUnidadMedida: sin el flag explícito, cualquier proveedor
    // con productos mixtos (p.ej. Alcampo) se vería agrupado igual, que es
    // justamente el bug que este flag corrige. No tiene ningún efecto sobre
    // Compra/Factura.
    private bool _mostrarSeccionesUnidad =>
        _proveedorSeleccionado is not null &&
        _proveedores.FirstOrDefault(p => p.Id == _proveedorSeleccionado)?.AgruparPorTipoUnidad == true;

    private RenderFragment<IEnumerable<Producto>> TarjetasProductos => productos =>
        @<MudGrid>
            @foreach (var producto in productos)
            {
                <MudItem xs="12" sm="6" md="4" id="@($"prod-{producto.Id}")">
                    <MudCard Elevation="2"
                             Style="height:100%; display:flex; flex-direction:column; cursor:pointer;"
                             @onclick="@(() => AbrirProducto(producto.Id))">
                        @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                        {
                            <div style="height:160px; overflow:hidden;">
                                <img src="@producto.ImagenUrl" alt="@producto.Nombre"
                                     style="width:100%; height:100%; object-fit:cover; object-position:center; display:block;"/>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-center justify-center"
                                 style="height:160px; background-color:#F5F0EB;">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Style="font-size:3rem; color:#6D4C41;"/>
                            </div>
                        }
                        <div style="background-color:rgba(109,76,65,0.22); text-align:center; padding:8px 12px;">
                            <MudText Typo="Typo.h6" Style="color:#3E2723;">
                                @producto.Nombre
                            </MudText>
                        </div>
                        <MudCardContent Style="flex-grow:1;">
                            @if (producto.ProveedorId is not null && _proveedoresPorId.TryGetValue(producto.ProveedorId.Value, out var nombreProveedor))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Class="mt-2">@nombreProveedor</MudChip>
                            }

                            <div class="d-flex align-center mt-3">
                                <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Class="mr-1"/>
                                <MudText Typo="Typo.body2">@producto.StockActual / @producto.StockMaximo</MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>;

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await ProveedorService.GetAllAsync();
        _proveedoresPorId = _proveedores.ToDictionary(p => p.Id, p => p.Nombre);
        _productos = await ProductoService.GetAllAsync();

        // Estado inicial del filtro tomado de la URL (incluye la vuelta con "atrás").
        _proveedorSeleccionado = ProveedorQuery;
        _busqueda = BusquedaQuery ?? string.Empty;
        _restaurarPosicion = true;

        _cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Necesita el circuito interactivo y que las tarjetas ya estén pintadas,
        // por eso se espera a !_cargando en vez de a firstRender. Si no venimos
        // de una ficha, irAlProducto no hace nada.
        if (_restaurarPosicion && !_cargando)
        {
            _restaurarPosicion = false;
            await JS.InvokeVoidAsync("cafeStock.irAlProducto");
        }
    }

    private void FiltrarPorProveedor(int? proveedorId)
    {
        _proveedorSeleccionado = proveedorId;
        ActualizarUrl();
    }

    private void ActualizarUrl()
    {
        var parametros = new Dictionary<string, object?>
        {
            ["proveedor"] = _proveedorSeleccionado,
            ["q"] = string.IsNullOrWhiteSpace(_busqueda) ? null : _busqueda,
        };
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(parametros), forceLoad: false, replace: true);
    }

    private async Task AbrirProducto(int productoId)
    {
        await JS.InvokeVoidAsync("cafeStock.recordarProducto", productoId);
        var volver = Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery);
        Navigation.NavigateTo($"/productos/{productoId}?volver={volver}");
    }
}
