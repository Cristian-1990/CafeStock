@page "/proveedores/{Id:int}"
@inject IProveedorService ProveedorService
@inject IProductoService ProductoService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@(_proveedor?.Nombre ?? "Proveedor")</PageTitle>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (_proveedor is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se ha encontrado este proveedor.</MudAlert>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/proveedores">
        Volver al listado
    </MudButton>
}
else
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/proveedores"
               Class="mb-4">
        Volver al listado
    </MudButton>

    <div class="d-flex align-center mb-6" style="gap:1rem;">
        @if (!string.IsNullOrWhiteSpace(_proveedor.ImagenUrl))
        {
            <div style="width:88px; height:88px; border-radius:8px; overflow:hidden; flex-shrink:0; background-color:#F5F0EB;">
                <img src="@_proveedor.ImagenUrl" alt="@_proveedor.Nombre"
                     style="width:100%; height:100%; object-fit:contain; object-position:center; display:block;"/>
            </div>
        }
        else
        {
            <div class="d-flex align-center justify-center flex-shrink-0"
                 style="width:88px; height:88px; background-color:#F5F0EB; border-radius:8px;">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size:2.5rem; color:#6D4C41;"/>
            </div>
        }
        <div style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:8px 16px; display:inline-block;">
            <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">@_proveedor.Nombre</MudText>
        </div>
    </div>

    @if (TieneDatosDeContacto())
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1" Style="max-width:400px;">
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:#6D4C41; text-transform:uppercase; letter-spacing:0.5px; font-weight:600;">
                Contacto
            </MudText>
            @if (!string.IsNullOrWhiteSpace(_proveedor.Telefono))
            {
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                    <MudText Typo="Typo.body1">@_proveedor.Telefono</MudText>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_proveedor.PersonaContacto))
            {
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                    <MudText Typo="Typo.body1">@_proveedor.PersonaContacto</MudText>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_proveedor.Email))
            {
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                    <MudText Typo="Typo.body1">@_proveedor.Email</MudText>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_proveedor.DiaReparto))
            {
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                    <MudText Typo="Typo.body1">Reparto: @_proveedor.DiaReparto</MudText>
                </div>
            }
        </MudPaper>
    }

    @if (!string.IsNullOrWhiteSpace(_proveedor.Notas))
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1" Style="max-width:400px; background-color:rgba(109,76,65,0.06);">
            <MudText Typo="Typo.subtitle2" Class="mb-1" Style="color:#6D4C41; text-transform:uppercase; letter-spacing:0.5px; font-weight:600;">
                Notas
            </MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@_proveedor.Notas</MudText>
        </MudPaper>
    }

    <div class="d-flex gap-2 mb-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Edit"
                   Href="@($"/proveedores/editar/{Id}")">
            Editar proveedor
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="ConfirmarEliminarAsync">
            Eliminar proveedor
        </MudButton>
    </div>

    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Productos de este proveedor</MudText>

    @if (!_productos.Any())
    {
        <MudAlert Severity="Severity.Info">Este proveedor no tiene productos asignados todavía.</MudAlert>
    }
    else
    {
        <MudTable Items="_productos" Hover="true" Striped="true" Elevation="2">
            <HeaderContent>
                <MudTh>Nombre</MudTh>
                <MudTh>Stock actual</MudTh>
                <MudTh>Stock máximo</MudTh>
                <MudTh>Cantidad a comprar</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                <MudTd DataLabel="Stock actual">@context.StockActual</MudTd>
                <MudTd DataLabel="Stock máximo">@context.StockMaximo</MudTd>
                <MudTd DataLabel="Cantidad a comprar">
                    <MudText Style="@($"color:{(context.CantidadAComprar > 0 ? "#7A2410" : "#3B6D11")}; font-weight:700;")">
                        @context.CantidadAComprar
                    </MudText>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Proveedor? _proveedor;
    private IEnumerable<Producto> _productos = [];
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await ProveedorService.GetByIdAsync(Id);
        if (resultado.IsSuccess)
        {
            _proveedor = resultado.Value;
            var todosLosProductos = await ProductoService.GetAllAsync();
            _productos = todosLosProductos.Where(p => p.ProveedorId == Id);
        }
        _cargando = false;
    }

    private bool TieneDatosDeContacto() =>
        _proveedor is not null &&
        (!string.IsNullOrWhiteSpace(_proveedor.Telefono) ||
         !string.IsNullOrWhiteSpace(_proveedor.PersonaContacto) ||
         !string.IsNullOrWhiteSpace(_proveedor.Email) ||
         !string.IsNullOrWhiteSpace(_proveedor.DiaReparto));

    private async Task ConfirmarEliminarAsync()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"¿Seguro que quieres eliminar '{_proveedor!.Nombre}'? Esta acción no se puede deshacer." },
            { x => x.ConfirmText, "Eliminar" },
            { x => x.CancelText, "Cancelar" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Eliminar proveedor", parameters);
        var resultado = await dialog.Result;

        if (resultado is not null && !resultado.Canceled)
            await EliminarAsync();
    }

    private async Task EliminarAsync()
    {
        var resultado = await ProveedorService.DeleteAsync(Id);
        if (resultado.IsSuccess)
        {
            Snackbar.Add($"Proveedor '{_proveedor!.Nombre}' eliminado correctamente", Severity.Success);
            Navigation.NavigateTo("/proveedores");
        }
        else
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
        }
    }
}
