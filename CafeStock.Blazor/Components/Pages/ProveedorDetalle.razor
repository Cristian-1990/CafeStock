@page "/proveedores/{Id:int}"
@inject IProveedorService ProveedorService
@inject IProductoService ProductoService
@inject CafeStock.Back.Services.Facturas.IFacturaService FacturaService
@inject NavigationManager Navigation

<PageTitle>@(_proveedor?.Nombre ?? "Proveedor")</PageTitle>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (_proveedor is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se ha encontrado este proveedor.</MudAlert>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/proveedores">
        Volver al listado
    </MudButton>
}
else
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/proveedores"
               Class="mb-4">
        Volver al listado
    </MudButton>

    <div class="d-flex align-center mb-6" style="gap:1rem;">
        @if (!string.IsNullOrWhiteSpace(_proveedor.ImagenUrl))
        {
            <div style="width:88px; height:88px; border-radius:8px; overflow:hidden; flex-shrink:0; background-color:#F5F0EB;">
                <img src="@_proveedor.ImagenUrl" alt="@_proveedor.Nombre"
                     style="width:100%; height:100%; object-fit:contain; object-position:center; display:block;"/>
            </div>
        }
        else
        {
            <div class="d-flex align-center justify-center flex-shrink-0"
                 style="width:88px; height:88px; background-color:#F5F0EB; border-radius:8px;">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size:2.5rem; color:#6D4C41;"/>
            </div>
        }
        <div style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:8px 16px; display:inline-block;">
            <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">@_proveedor.Nombre</MudText>
        </div>
    </div>

    @if (TieneDatosDeContacto())
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1" Style="max-width:400px;">
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:#6D4C41; text-transform:uppercase; letter-spacing:0.5px; font-weight:600;">
                Contacto
            </MudText>
            @if (!string.IsNullOrWhiteSpace(_proveedor.NifCif))
            {
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                    <MudText Typo="Typo.body1">NIF/CIF: @_proveedor.NifCif</MudText>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_proveedor.Telefono))
            {
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                    <MudText Typo="Typo.body1">@_proveedor.Telefono</MudText>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_proveedor.PersonaContacto))
            {
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                    <MudText Typo="Typo.body1">@_proveedor.PersonaContacto</MudText>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_proveedor.Email))
            {
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                    <MudText Typo="Typo.body1">@_proveedor.Email</MudText>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_proveedor.DiaReparto))
            {
                <div class="d-flex align-center mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                    <MudText Typo="Typo.body1">Reparto: @_proveedor.DiaReparto</MudText>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_proveedor.Direccion))
            {
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                    <MudText Typo="Typo.body1">@_proveedor.Direccion</MudText>
                </div>
            }
        </MudPaper>
    }

    @if (!string.IsNullOrWhiteSpace(_proveedor.Notas))
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1" Style="max-width:400px; background-color:rgba(109,76,65,0.06);">
            <MudText Typo="Typo.subtitle2" Class="mb-1" Style="color:#6D4C41; text-transform:uppercase; letter-spacing:0.5px; font-weight:600;">
                Notas
            </MudText>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap;">@_proveedor.Notas</MudText>
        </MudPaper>
    }

    <div class="d-flex gap-2 mb-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Edit"
                   Href="@($"/proveedores/editar/{Id}")">
            Editar proveedor
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Receipt"
                   Href="@($"/facturas?proveedorId={Id}")">
            Ver facturas
        </MudButton>
    </div>

    @if (!_productos.Any())
    {
        <MudAlert Severity="Severity.Info">Este proveedor no tiene productos asignados todavía.</MudAlert>
    }
    else
    {
        <div class="d-flex justify-center mb-4">
            <MudPaper Elevation="3" Style="border-radius:9999px; max-width:400px; width:100%; padding:2px 20px;">
                <MudTextField T="string"
                              @bind-Value="_busquedaProductos"
                              Immediate="true"
                              Placeholder="Buscar producto..."
                              Variant="Variant.Text"
                              Underline="false"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"/>
            </MudPaper>
        </div>

        @if (!_productosFiltrados.Any())
        {
            <MudAlert Severity="Severity.Info">No hay productos que coincidan con esta búsqueda.</MudAlert>
        }
        else if (!_mostrarPestanasUnidad)
        {
            @TablaProductos(_productosFiltrados)
        }
        else
        {
            @if (_productosFiltrados.Any(p => p.Unidad.Grupo() == GrupoUnidadMedida.Peso))
            {
                <MudText Typo="Typo.subtitle1" Class="mb-2" Style="color:#3E2723;">@(EsPuchero ? "Uso cafetería" : "Por peso")</MudText>
                @TablaProductos(_productosFiltrados.Where(p => p.Unidad.Grupo() == GrupoUnidadMedida.Peso))
            }
            @if (_productosFiltrados.Any(p => p.Unidad.Grupo() == GrupoUnidadMedida.Unidad))
            {
                <MudText Typo="Typo.subtitle1" Class="mb-2 mt-6" Style="color:#3E2723;">@(EsPuchero ? "Venta al público" : "Por unidad")</MudText>
                @TablaProductos(_productosFiltrados.Where(p => p.Unidad.Grupo() == GrupoUnidadMedida.Unidad))
            }
            @if (_productosFiltrados.Any(p => p.Unidad.Grupo() == GrupoUnidadMedida.SinClasificar))
            {
                <MudText Typo="Typo.subtitle1" Class="mb-2 mt-6" Style="color:#3E2723;">Sin clasificar</MudText>
                @TablaProductos(_productosFiltrados.Where(p => p.Unidad.Grupo() == GrupoUnidadMedida.SinClasificar))
            }
        }
    }

    <MudText Typo="Typo.h5" Class="mb-2 mt-6" Style="color:#3E2723;">Historial de compras</MudText>

    @if (_cargandoFacturas)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
    }
    else if (!_facturas.Any())
    {
        <MudAlert Severity="Severity.Info">Este proveedor no tiene compras registradas todavía.</MudAlert>
    }
    else
    {
        <MudTable Items="_facturas" Hover="true" Dense="true" Striped="true" Elevation="2"
                  OnRowClick="@((TableRowClickEventArgs<Compra> args) => Navigation.NavigateTo($"/facturas/{args.Item!.Id}"))"
                  RowStyle="cursor:pointer;">
            <HeaderContent>
                <MudTh>Fecha</MudTh>
                <MudTh>Total</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Fecha">@context.Fecha.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Total">@context.Lineas.Sum(l => l.Cantidad * l.PrecioUnitario).ToString("F2") €</MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private Proveedor? _proveedor;
    private IEnumerable<Producto> _productos = [];
    private IEnumerable<Compra> _facturas = [];
    private bool _cargando = true;
    private bool _cargandoFacturas = true;
    private string _busquedaProductos = string.Empty;

    private IEnumerable<Producto> _productosFiltrados =>
        _productos.Where(p => string.IsNullOrWhiteSpace(_busquedaProductos) ||
                               p.Nombre.Contains(_busquedaProductos, StringComparison.OrdinalIgnoreCase));

    // Puchero es el único proveedor con distinción entre uso interno de
    // cafetería y venta al público; el resto de proveedores no manejan esta
    // distinción, así que conservan los títulos genéricos "Por peso"/"Por unidad".
    private bool EsPuchero =>
        string.Equals(_proveedor?.Nombre, "Puchero", StringComparison.OrdinalIgnoreCase);

    // División puramente visual de la tabla de productos por tipo de unidad de
    // medida (ver CafeStock.Blazor.Services.UnidadMedidaExtensions). No tiene
    // ningún efecto sobre Compra/Factura.
    //
    // Solo aplica a Puchero: el resto de proveedores no manejan esta distinción
    // y siempre muestran una única tabla, como antes.
    //
    // Se decide sobre el total de productos del proveedor (no sobre los
    // filtrados por búsqueda) para que las pestañas no aparezcan/desaparezcan
    // mientras el usuario escribe en el buscador.
    private bool _mostrarPestanasUnidad =>
        EsPuchero && _productos.Select(p => p.Unidad.Grupo()).Distinct().Count() > 1;

    private RenderFragment<IEnumerable<Producto>> TablaProductos => productos =>
        @<MudTable Items="productos" Hover="true" Striped="true" Elevation="2">
            <HeaderContent>
                <MudTh Style="background-color:var(--mud-palette-primary); color:var(--mud-palette-primary-text);">Nombre</MudTh>
                <MudTh Style="background-color:var(--mud-palette-primary); color:var(--mud-palette-primary-text);">Actual</MudTh>
                <MudTh Style="background-color:var(--mud-palette-primary); color:var(--mud-palette-primary-text);">Necesario</MudTh>
                <MudTh Style="background-color:var(--mud-palette-primary); color:var(--mud-palette-primary-text);">Precio</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                <MudTd DataLabel="Actual">@context.StockActual</MudTd>
                <MudTd DataLabel="Necesario">
                    <MudText Style="@($"color:{(context.CantidadAComprar > 0 ? "#7A2410" : "#3B6D11")}; font-weight:700;")">
                        @context.CantidadAComprar
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Precio">@context.PrecioUnitario.ToString("F2") €</MudTd>
            </RowTemplate>
        </MudTable>;

    protected override async Task OnInitializedAsync()
    {
        var resultado = await ProveedorService.GetByIdAsync(Id);
        if (resultado.IsSuccess)
        {
            _proveedor = resultado.Value;
            var todosLosProductos = await ProductoService.GetAllAsync();
            _productos = todosLosProductos.Where(p => p.ProveedorId == Id);
        }
        _cargando = false;

        _facturas = (await FacturaService.GetByProveedorAsync(Id)).OrderByDescending(f => f.Fecha);
        _cargandoFacturas = false;
    }

    private bool TieneDatosDeContacto() =>
        _proveedor is not null &&
        (!string.IsNullOrWhiteSpace(_proveedor.Telefono) ||
         !string.IsNullOrWhiteSpace(_proveedor.PersonaContacto) ||
         !string.IsNullOrWhiteSpace(_proveedor.Email) ||
         !string.IsNullOrWhiteSpace(_proveedor.DiaReparto) ||
         !string.IsNullOrWhiteSpace(_proveedor.Direccion) ||
         !string.IsNullOrWhiteSpace(_proveedor.NifCif));

}
