@page "/productos/{Id:int}"
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService

<PageTitle>@(_producto?.Nombre ?? "Producto")</PageTitle>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (_producto is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se ha encontrado este producto.</MudAlert>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/productos">
        Volver al listado
    </MudButton>
}
else
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/productos"
               Class="mb-4">
        Volver al listado
    </MudButton>

    <div class="d-flex align-center mb-6" style="gap:1rem;">
        @if (!string.IsNullOrWhiteSpace(_producto.ImagenUrl))
        {
            <div style="width:88px; height:88px; border-radius:8px; overflow:hidden; flex-shrink:0;">
                <img src="@_producto.ImagenUrl" alt="@_producto.Nombre"
                     style="width:100%; height:100%; object-fit:cover; object-position:center; display:block;"/>
            </div>
        }
        else
        {
            <div class="d-flex align-center justify-center flex-shrink-0"
                 style="width:88px; height:88px; background-color:#F5F0EB; border-radius:8px;">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Style="font-size:2.5rem; color:#6D4C41;"/>
            </div>
        }
        <div style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:8px 16px; display:inline-block;">
            <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">@_producto.Nombre</MudText>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_producto.Descripcion))
    {
        <MudText Typo="Typo.body1" Class="mb-4">@_producto.Descripcion</MudText>
    }
    else
    {
        <MudText Typo="Typo.body1" Class="mb-4" Style="color:#9E9E9E; font-style:italic;">Sin descripción</MudText>
    }

    <div class="d-flex flex-wrap gap-2 mb-4">
        @if (_nombreProveedor is not null)
        {
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled">@_nombreProveedor</MudChip>
        }
        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">@FormatearUnidad(_producto.Unidad)</MudChip>
    </div>

    <MudPaper Class="pa-4 mb-4" Elevation="1" Style="max-width:300px;">
        <div class="d-flex align-center mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-2"/>
            <MudText Typo="Typo.body1">Stock actual / máximo: <b>@_producto.StockActual / @_producto.StockMaximo</b></MudText>
        </div>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Euro" Class="mr-2"/>
            <MudText Typo="Typo.body1">Precio unitario: <b>@_producto.PrecioUnitario.ToString("F2") €</b></MudText>
        </div>
    </MudPaper>

    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Edit"
                   Href="@($"/productos/editar/{Id}")">
            Editar
        </MudButton>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Producto? _producto;
    private string? _nombreProveedor;
    private bool _cargando = true;

    private static string FormatearUnidad(UnidadMedida unidad) =>
        unidad == UnidadMedida.SinEspecificar ? "— Sin especificar —" : unidad.ToString();

    protected override async Task OnInitializedAsync()
    {
        var resultado = await ProductoService.GetByIdAsync(Id);
        if (resultado.IsSuccess)
        {
            _producto = resultado.Value;
            if (_producto.ProveedorId is not null)
            {
                var proveedor = await ProveedorService.GetByIdAsync(_producto.ProveedorId.Value);
                if (proveedor.IsSuccess)
                    _nombreProveedor = proveedor.Value.Nombre;
            }
        }
        _cargando = false;
    }
}
