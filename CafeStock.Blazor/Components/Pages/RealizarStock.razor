@page "/stock/realizar"
@attribute [Authorize(Policy = Politicas.Trabajador)]
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject ISnackbar Snackbar
@inject CafeStock.Back.Services.StocksRealizados.IStockRealizadoService StockRealizadoService
@inject IDialogService DialogService
@inject CafeStock.Blazor.Services.PdfService PdfService
@inject CafeStock.Blazor.Services.EmailService EmailService

<PageTitle>Realizar stock</PageTitle>

<div class="mb-4" style="background-color:rgba(var(--rgb-borde),0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:var(--color-dark); margin:0;">Realizar stock</MudText>
</div>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_enRecuento)
{
    <MudText Typo="Typo.body1" Class="mb-4">Elige un proveedor para empezar a contar sus productos.</MudText>

    <MudGrid>
        @foreach (var proveedor in _proveedores)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2"
                         Style="height:100%; cursor:pointer;"
                         @onclick="@(() => SeleccionarProveedor(proveedor))">
                    @if (!string.IsNullOrWhiteSpace(proveedor.ImagenUrl))
                    {
                        <div style="height:160px; overflow:hidden; background-color:var(--bg-panel);">
                            <img src="@proveedor.ImagenUrl" alt="@proveedor.Nombre"
                                 style="width:100%; height:100%; object-fit:contain; object-position:center; display:block;"/>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center"
                             style="height:160px; background-color:var(--bg-panel);">
                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size:3rem; color:var(--color-primary);"/>
                        </div>
                    }
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Style="color:var(--color-dark);">@proveedor.Nombre</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2"
                     Style="height:100%; cursor:pointer;"
                     @onclick="SeleccionarSinProveedor">
                <div class="d-flex align-center justify-center"
                     style="height:160px; background-color:var(--bg-panel);">
                    <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Style="font-size:3rem; color:var(--color-primary);"/>
                </div>
                <MudCardContent>
                    <MudText Typo="Typo.h6" Style="color:var(--color-dark);">Sin proveedor asignado</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}
else
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="Volver"
               Class="mb-4">
        Volver
    </MudButton>

    <div class="mb-4"
         style="position:sticky; top:8px; z-index:4; display:flex; align-items:center;
                background-color:var(--bg-page); padding:12px 16px; border-radius:12px;
                box-shadow:0 2px 8px rgba(var(--rgb-sombra),0.15);">
        <MudText Typo="Typo.h5" Style="color:var(--color-dark); margin:0;">@_nombreGrupoSeleccionado</MudText>
    </div>

    @* Supermercados (Alcampo...): "Cafetería" (por defecto) cuenta por armarios, donde se guarda cada cosa en
       el local; "Supermercado" sigue el recorrido de la tienda (pasillos) y A–Z es la lista plana. *@
    @if (_grupoSeleccionado?.EsSupermercadoGenerico == true)
    {
        <div class="d-flex flex-wrap align-center gap-2 mb-4">
            <MudText Typo="Typo.overline" Style="color:var(--color-primary);">Orden</MudText>
            <MudChip T="string" Color="@(_orden == OrdenLista.Armario ? Color.Primary : Color.Default)"
                     Variant="@(_orden == OrdenLista.Armario ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _orden = OrdenLista.Armario)">
                Cafetería
            </MudChip>
            <MudChip T="string" Color="@(_orden == OrdenLista.Pasillo ? Color.Primary : Color.Default)"
                     Variant="@(_orden == OrdenLista.Pasillo ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _orden = OrdenLista.Pasillo)">
                Supermercado
            </MudChip>
            <MudChip T="string" Color="@(_orden == OrdenLista.AZ ? Color.Primary : Color.Default)"
                     Variant="@(_orden == OrdenLista.AZ ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _orden = OrdenLista.AZ)">
                A–Z
            </MudChip>
        </div>
    }

    @if (!_productosDelGrupo.Any())
    {
        <MudAlert Severity="Severity.Info">Este grupo no tiene productos.</MudAlert>
    }
    else
    {
        <div class="d-flex justify-center mb-4">
            <MudPaper Elevation="3" Style="border-radius:9999px; max-width:400px; width:100%; padding:2px 20px;">
                <MudTextField T="string"
                              @bind-Value="_busqueda"
                              Immediate="true"
                              Clearable="true"
                              Placeholder="Buscar producto..."
                              Variant="Variant.Text"
                              Underline="false"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"/>
            </MudPaper>
        </div>

        @if (!_productosVisibles.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">Ningún producto coincide con la búsqueda.</MudAlert>
        }

        @* Por armario: una sola tabla con cabecera de grupo ("Armario 1", "Armario 2"... y "Sin armario" al
           final). En los demás órdenes no hay agrupación. *@
        <MudTable Items="_productosVisibles" Hover="true" Elevation="2" RowStyleFunc="FilaEstilo"
                  GroupBy="@(_agruparPorArmario ? _agrupacionArmario : null)"
                  GroupHeaderStyle="background-color:var(--bg-panel); font-weight:600;">
            <GroupHeaderTemplate>
                <MudTh colspan="3" Style="color:var(--color-dark); font-size:1.05rem;">
                    @NombreArmario((int)context.Key)
                </MudTh>
            </GroupHeaderTemplate>
            <HeaderContent>
                <MudTh>Nombre</MudTh>
                <MudTh>Cantidad actual</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                <MudTd DataLabel="Cantidad actual">
                    <MudNumericField T="int"
                                     Value="context.StockActual"
                                     ValueChanged="@(v => OnCantidadCambiada(context, v))"
                                     Min="0"
                                     Variant="Variant.Outlined"
                                     Style="max-width:120px;"/>
                </MudTd>
                <MudTd>
                    @{
                        var estado = EstadoDe(context);
                    }
                    @if (estado is EstadoFila.Guardado or EstadoFila.Verificado)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                   Disabled="true">
                            @(estado == EstadoFila.Verificado ? "Verificado" : "Guardado")
                        </MudButton>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap align-center gap-2">
                            <MudButton Variant="@(estado == EstadoFila.Pendiente ? Variant.Filled : Variant.Outlined)"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       Style="@(estado == EstadoFila.Pendiente
                                                ? "background-color:var(--accent-gold); color:#fff;"
                                                : "color:var(--color-primary); border-color:var(--color-primary);")"
                                       Disabled="@(estado == EstadoFila.SinCambios || _guardandoTodo)"
                                       OnClick="@(() => GuardarAsync(context))">
                                Actualizar
                            </MudButton>
                            @* Verificar: "lo he revisado y la cantidad está bien", sin tocar el stock. Solo con la fila
                               sin cambios: si hay una cantidad pendiente de guardar se usa Actualizar. *@
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.FactCheck"
                                       Style="color:var(--color-primary); border-color:var(--color-primary);"
                                       Disabled="@(estado != EstadoFila.SinCambios || _guardandoTodo)"
                                       OnClick="@(() => VerificarAsync(context))">
                                Verificar
                            </MudButton>
                        </div>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>

        @* Hueco para que la última fila no quede tapada por el botón fijo. *@
        <div style="height:96px;"></div>

        @* Barra fija: el botón "Actualizar todo" acompaña siempre al scroll, y a su lado "Generar pedido"
           (antes vivía en la pantalla Stock). Solo se activa con todo guardado, para que el pedido salga
           con las cantidades ya confirmadas, y pide confirmación antes de enviar el email. *@
        <div style="position:fixed; left:0; right:0; bottom:0; z-index:1000;
                    display:flex; justify-content:center; flex-wrap:wrap; gap:12px; padding:16px;
                    pointer-events:none;">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Storefront"
                       Style="@($"pointer-events:auto; box-shadow:0 6px 20px rgba(var(--rgb-sombra),0.35); {(PuedeGenerarPedido ? "background-color:var(--accent-terracota); color:#fff;" : "background-color:#EDE4D6; color:#8D7B6E;")}")"
                       Disabled="@(!PuedeGenerarPedido)"
                       OnClick="GenerarPedidoAsync">
                @(_generandoPedido ? "Generando..." : $"Generar pedido ({_productosAPedir.Count})")
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.DoneAll"
                       Style="@($"pointer-events:auto; box-shadow:0 6px 20px rgba(var(--rgb-sombra),0.35); {(_pendientesEnGrupo > 0 ? "background-color:var(--color-primary); color:#fff;" : "background-color:#EDE4D6; color:#8D7B6E;")}")"
                       Disabled="@(_pendientesEnGrupo == 0 || _guardandoTodo)"
                       OnClick="GuardarTodoAsync">
                @(_pendientesEnGrupo > 0 ? $"Actualizar todo ({_pendientesEnGrupo})" : "Todo actualizado")
            </MudButton>
        </div>
    }
}

@code {
    // Verificado = revisada con "Verificar" sin cambiar la cantidad (solo en esta pantalla, no se guarda nada).
    private enum EstadoFila { SinCambios, Pendiente, Guardado, Verificado }

    private List<Producto> _productos = [];
    private IEnumerable<Proveedor> _proveedores = [];
    private bool _cargando = true;
    private bool _guardandoTodo;

    // Última cantidad persistida en BD por producto (para detectar cambios sin tocar el modelo).
    private readonly Dictionary<int, int> _valorGuardado = new();
    private readonly Dictionary<int, EstadoFila> _estadoFila = new();

    // Ninguno de los dos marcado = paso 1 (elegir grupo).
    private Proveedor? _grupoSeleccionado;
    private bool _sinProveedorSeleccionado;

    private bool _enRecuento => _grupoSeleccionado is not null || _sinProveedorSeleccionado;

    private string _nombreGrupoSeleccionado =>
        _sinProveedorSeleccionado ? "Sin proveedor asignado" : _grupoSeleccionado?.Nombre ?? string.Empty;

    // Permite llegar con el proveedor ya elegido (logos de la pantalla Stock y botón de Inicio).
    [SupplyParameterFromQuery(Name = "proveedorId")]
    [Parameter]
    public int? ProveedorIdInicial { get; set; }

    // Igual, para los productos sin proveedor (botón de Inicio).
    [SupplyParameterFromQuery(Name = "sinProveedor")]
    [Parameter]
    public bool SinProveedorInicial { get; set; }

    // Producto destacado: llega desde "Hacer stock" de Lo más urgente (Inicio). Se pone el primero de la
    // lista y con su fila resaltada, para contarlo sin buscarlo entre decenas.
    [SupplyParameterFromQuery(Name = "productoId")]
    [Parameter]
    public int? ProductoDestacadoId { get; set; }

    private enum OrdenLista { Armario, AZ, Pasillo }

    // Solo cuenta en supermercados genéricos (los chips solo salen ahí); el resto siempre va A–Z.
    private OrdenLista _orden = OrdenLista.Armario;
    private bool _generandoPedido;

    private bool _esSupermercado => _grupoSeleccionado?.EsSupermercadoGenerico == true;
    private bool _agruparPorArmario => _esSupermercado && _orden == OrdenLista.Armario;

    // Los productos sin armario no tienen número: se agrupan con una clave muy alta para que salgan al final
    // ("Sin armario"). El cabecero de grupo traduce la clave a texto (ver NombreArmario).
    private const int SinArmario = int.MaxValue;

    private static string NombreArmario(int clave) => clave == SinArmario ? "Sin armario" : $"Armario {clave}";

    private readonly TableGroupDefinition<Producto> _agrupacionArmario = new()
    {
        GroupName = "Armario",
        Indentation = false,
        Expandable = false,
        Selector = p => p.Armario ?? SinArmario
    };

    // Siempre A–Z (ver OrdenAlfabetico), salvo en un supermercado: "Por armario" (armario, los sin armario al
    // final, y nombre) o "Por pasillo" (pasillo, los sin pasillo al final, posición dentro del pasillo y
    // nombre). Ninguno de los órdenes depende de la cantidad que se está tecleando, así que la lista no
    // salta mientras se cuenta.
    private IEnumerable<Producto> _productosDelGrupo
    {
        get
        {
            List<Producto> lista;
            if (_sinProveedorSeleccionado)
                lista = _productos.Where(p => p.ProveedorId is null).ToList();
            else if (_grupoSeleccionado is null)
                return [];
            else
            {
                var proveedorId = _grupoSeleccionado.Id;
                lista = _productos.Where(p => p.ProveedorId == proveedorId).ToList();
            }

            var ordenada = _esSupermercado && _orden == OrdenLista.Armario
                ? lista.OrderBy(p => p.Armario ?? SinArmario).LuegoAlfabeticamente(p => p.Nombre).ToList()
                : _esSupermercado && _orden == OrdenLista.Pasillo
                    ? lista.OrderBy(p => p.Pasillo ?? int.MaxValue).ThenBy(p => p.OrdenEnPasillo).LuegoAlfabeticamente(p => p.Nombre).ToList()
                    : lista.OrdenarAlfabeticamente(p => p.Nombre).ToList();

            // El producto destacado, si está en este grupo, va el primero (salvo agrupando por armario: ahí
            // moverlo rompería el orden de los grupos; se queda en su armario, igualmente resaltado).
            var destacado = _agruparPorArmario ? null : ordenada.FirstOrDefault(p => p.Id == ProductoDestacadoId);
            if (destacado is not null)
            {
                ordenada.Remove(destacado);
                ordenada.Insert(0, destacado);
            }
            return ordenada;
        }
    }

    // Texto de la barra de búsqueda. Solo filtra lo que se VE en la tabla (_productosVisibles): "Actualizar
    // todo" y "Generar pedido" siguen trabajando sobre TODO el grupo (_productosDelGrupo), para que buscar
    // un producto no deje fuera del pedido a los demás ni deje cambios pendientes sin guardar.
    private string _busqueda = string.Empty;

    // Sin tildes ni mayúsculas, igual que el orden A–Z ("cafe" encuentra "Café"). Se materializa con
    // ToList para no recorrer una consulta diferida mientras el estado puede cambiar.
    private List<Producto> _productosVisibles
    {
        get
        {
            var lista = _productosDelGrupo.ToList();
            var clave = OrdenAlfabetico.Clave(_busqueda);
            return clave.Length == 0
                ? lista
                : lista.Where(p => OrdenAlfabetico.Clave(p.Nombre).Contains(clave, StringComparison.Ordinal)).ToList();
        }
    }

    // Lo que hay que pedir de este grupo: los productos por debajo de su máximo.
    private List<Producto> _productosAPedir => _productosDelGrupo.Where(p => p.CantidadAComprar > 0).ToList();

    private bool PuedeGenerarPedido => !_generandoPedido && !_guardandoTodo && _pendientesEnGrupo == 0 && _productosAPedir.Count > 0;

    private int _pendientesEnGrupo => _productosDelGrupo.Count(p => EstadoDe(p) == EstadoFila.Pendiente);

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await ProveedorService.GetAllAsync();
        // Los productos con seguimiento individual (ver Producto.SeguimientoIndividual) no
        // se cuentan aquí: su stock se controla desde "Venta", el recuento manual semanal
        // no tiene sentido para ellos.
        _productos = (await ProductoService.GetAllAsync()).Where(p => !p.SeguimientoIndividual).ToList();
        foreach (var p in _productos)
        {
            _valorGuardado[p.Id] = p.StockActual;
            _estadoFila[p.Id] = EstadoFila.SinCambios;
        }

        if (ProveedorIdInicial is int id)
        {
            var proveedor = _proveedores.FirstOrDefault(p => p.Id == id);
            if (proveedor is not null) SeleccionarProveedor(proveedor);
        }
        else if (SinProveedorInicial)
        {
            SeleccionarSinProveedor();
        }

        _cargando = false;
    }

    private async Task GenerarPedidoAsync()
    {
        var aPedir = _productosAPedir;
        if (aPedir.Count == 0) return;

        // Pregunta de seguridad: enviar el pedido manda un email real al encargado.
        var confirmado = await DialogService.ShowMessageBoxAsync(
            "Generar pedido",
            $"Se enviará por email el pedido de {_nombreGrupoSeleccionado} ({aPedir.Count} producto{(aPedir.Count == 1 ? "" : "s")} por reponer). ¿Quieres enviarlo?",
            yesText: "Sí, enviar",
            cancelText: "Cancelar");
        if (confirmado != true) return;

        _generandoPedido = true;
        try
        {
            var pdf = PdfService.GenerarInformePedido(aPedir, _proveedores);
            await EmailService.EnviarInformePedidoAsync(pdf);
            Snackbar.Add($"Pedido de {_nombreGrupoSeleccionado} enviado por email", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _generandoPedido = false;
        }
    }

    private EstadoFila EstadoDe(Producto p) =>
        _estadoFila.TryGetValue(p.Id, out var e) ? e : EstadoFila.SinCambios;

    /// <summary>
    /// "Verificar": la cantidad que hay es la correcta, así que la fila se da por revisada sin tocar el stock
    /// (no hay nada que guardar). Solo desde SinCambios; si luego se edita la cantidad, vuelve a Pendiente.
    /// </summary>
    private async Task VerificarAsync(Producto p)
    {
        if (EstadoDe(p) != EstadoFila.SinCambios)
            return;

        _estadoFila[p.Id] = EstadoFila.Verificado;
        await ComprobarStockCompletoAsync();
    }

    // Grupos (proveedores) cuyo "stock realizado" ya se ha marcado en esta visita, para avisar una sola vez.
    private readonly HashSet<int?> _avisados = [];

    /// <summary>
    /// El stock de un proveedor está hecho cuando TODAS sus filas están revisadas (guardadas o verificadas).
    /// Entonces, si tiene algo por reponer, se marca para que aparezca en Recepcionar; si no hay nada que
    /// recibir se quita cualquier marca vieja, para que no salga sin motivo.
    /// </summary>
    private async Task ComprobarStockCompletoAsync()
    {
        var grupo = _productosDelGrupo.ToList();
        if (grupo.Count == 0 || !grupo.All(p => EstadoDe(p) is EstadoFila.Guardado or EstadoFila.Verificado))
            return;

        var proveedorId = _sinProveedorSeleccionado ? null : _grupoSeleccionado?.Id;
        if (!grupo.Any(p => p.CantidadAComprar > 0))
        {
            await StockRealizadoService.QuitarAsync(proveedorId);
            return;
        }

        var resultado = await StockRealizadoService.MarcarAsync(proveedorId);
        if (resultado.IsFailure)
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
            return;
        }

        if (_avisados.Add(proveedorId))
            Snackbar.Add($"Stock de {_nombreGrupoSeleccionado} completo: ya aparece en Recepcionar", Severity.Success);
    }

    private void OnCantidadCambiada(Producto p, int nuevoValor)
    {
        p.StockActual = nuevoValor;
        var guardado = _valorGuardado.TryGetValue(p.Id, out var v) ? v : nuevoValor;
        _estadoFila[p.Id] = nuevoValor == guardado ? EstadoFila.SinCambios : EstadoFila.Pendiente;
    }

    private string FilaEstilo(Producto p, int index) => EstadoDe(p) switch
    {
        EstadoFila.Pendiente => "background-color:rgba(193,120,23,0.12);",
        EstadoFila.Guardado or EstadoFila.Verificado => "background-color:rgba(102,187,106,0.16);",
        _ when p.Id == ProductoDestacadoId => "box-shadow:inset 5px 0 0 var(--accent-terracota); background-color:rgba(168,72,31,0.08);",
        _                    => string.Empty
    };

    private void SeleccionarProveedor(Proveedor proveedor)
    {
        _busqueda = string.Empty;
        _sinProveedorSeleccionado = false;
        _grupoSeleccionado = proveedor;
    }

    private void SeleccionarSinProveedor()
    {
        _busqueda = string.Empty;
        _sinProveedorSeleccionado = true;
        _grupoSeleccionado = null;
    }

    private void Volver()
    {
        _busqueda = string.Empty;
        _grupoSeleccionado = null;
        _sinProveedorSeleccionado = false;
    }

    private async Task GuardarAsync(Producto producto)
    {
        var resultado = await ProductoService.ActualizarStockActualAsync(producto.Id, producto.StockActual);
        if (resultado.IsSuccess)
        {
            _valorGuardado[producto.Id] = producto.StockActual;
            _estadoFila[producto.Id] = EstadoFila.Guardado;
            await ComprobarStockCompletoAsync();
        }
        else
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
        }
    }

    private async Task GuardarTodoAsync()
    {
        var pendientes = _productosDelGrupo.Where(p => EstadoDe(p) == EstadoFila.Pendiente).ToList();
        if (pendientes.Count == 0)
            return;

        _guardandoTodo = true;
        var ok = 0;
        var errores = new List<string>();

        foreach (var producto in pendientes)
        {
            var resultado = await ProductoService.ActualizarStockActualAsync(producto.Id, producto.StockActual);
            if (resultado.IsSuccess)
            {
                _valorGuardado[producto.Id] = producto.StockActual;
                _estadoFila[producto.Id] = EstadoFila.Guardado;
                ok++;
            }
            else
            {
                errores.Add($"{producto.Nombre}: {resultado.Error.Message}");
            }
        }

        _guardandoTodo = false;

        if (ok > 0)
            Snackbar.Add($"{ok} producto{(ok == 1 ? "" : "s")} actualizado{(ok == 1 ? "" : "s")}", Severity.Success);
        foreach (var error in errores)
            Snackbar.Add(error, Severity.Error);

        await ComprobarStockCompletoAsync();
    }
}
