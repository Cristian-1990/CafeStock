@page "/stock/realizar"
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject ISnackbar Snackbar

<PageTitle>Realizar stock</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Realizar stock</MudText>
</div>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_enRecuento)
{
    <MudText Typo="Typo.body1" Class="mb-4">Elige un proveedor para empezar a contar sus productos.</MudText>

    <MudGrid>
        @foreach (var proveedor in _proveedores)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2"
                         Style="height:100%; cursor:pointer;"
                         @onclick="@(() => SeleccionarProveedor(proveedor))">
                    @if (!string.IsNullOrWhiteSpace(proveedor.ImagenUrl))
                    {
                        <div style="height:160px; overflow:hidden; background-color:#F5F0EB;">
                            <img src="@proveedor.ImagenUrl" alt="@proveedor.Nombre"
                                 style="width:100%; height:100%; object-fit:contain; object-position:center; display:block;"/>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center"
                             style="height:160px; background-color:#F5F0EB;">
                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size:3rem; color:#6D4C41;"/>
                        </div>
                    }
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Style="color:#3E2723;">@proveedor.Nombre</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2"
                     Style="height:100%; cursor:pointer;"
                     @onclick="SeleccionarSinProveedor">
                <div class="d-flex align-center justify-center"
                     style="height:160px; background-color:#F5F0EB;">
                    <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Style="font-size:3rem; color:#6D4C41;"/>
                </div>
                <MudCardContent>
                    <MudText Typo="Typo.h6" Style="color:#3E2723;">Sin proveedor asignado</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}
else
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="Volver"
               Class="mb-4">
        Volver
    </MudButton>

    <div class="mb-4"
         style="position:sticky; top:8px; z-index:4; display:flex; align-items:center;
                background-color:#F5EFE6; padding:12px 16px; border-radius:12px;
                box-shadow:0 2px 8px rgba(62,39,35,0.15);">
        <MudText Typo="Typo.h5" Style="color:#3E2723; margin:0;">@_nombreGrupoSeleccionado</MudText>
    </div>

    @if (!_productosDelGrupo.Any())
    {
        <MudAlert Severity="Severity.Info">Este grupo no tiene productos.</MudAlert>
    }
    else
    {
        <MudTable Items="_productosDelGrupo" Hover="true" Elevation="2" RowStyleFunc="FilaEstilo">
            <HeaderContent>
                <MudTh>Nombre</MudTh>
                <MudTh>Cantidad actual</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                <MudTd DataLabel="Cantidad actual">
                    <MudNumericField T="int"
                                     Value="context.StockActual"
                                     ValueChanged="@(v => OnCantidadCambiada(context, v))"
                                     Min="0"
                                     Variant="Variant.Outlined"
                                     Style="max-width:120px;"/>
                </MudTd>
                <MudTd>
                    @{
                        var estado = EstadoDe(context);
                    }
                    @if (estado == EstadoFila.Guardado)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                   Disabled="true">
                            Guardado
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="@(estado == EstadoFila.Pendiente ? Variant.Filled : Variant.Outlined)"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Style="@(estado == EstadoFila.Pendiente
                                            ? "background-color:#C17817; color:#fff;"
                                            : "color:#6D4C41; border-color:#6D4C41;")"
                                   Disabled="@(estado == EstadoFila.SinCambios || _guardandoTodo)"
                                   OnClick="@(() => GuardarAsync(context))">
                            Actualizar
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>

        @* Hueco para que la última fila no quede tapada por el botón fijo. *@
        <div style="height:96px;"></div>

        @* Barra fija: el botón "Actualizar todo" acompaña siempre al scroll. *@
        <div style="position:fixed; left:0; right:0; bottom:0; z-index:1000;
                    display:flex; justify-content:center; padding:16px;
                    pointer-events:none;">
            <MudButton Variant="Variant.Filled"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.DoneAll"
                       Style="@($"pointer-events:auto; box-shadow:0 6px 20px rgba(62,39,35,0.35); {(_pendientesEnGrupo > 0 ? "background-color:#6D4C41; color:#fff;" : "background-color:#EDE4D6; color:#8D7B6E;")}")"
                       Disabled="@(_pendientesEnGrupo == 0 || _guardandoTodo)"
                       OnClick="GuardarTodoAsync">
                @(_pendientesEnGrupo > 0 ? $"Actualizar todo ({_pendientesEnGrupo})" : "Todo actualizado")
            </MudButton>
        </div>
    }
}

@code {
    private enum EstadoFila { SinCambios, Pendiente, Guardado }

    private List<Producto> _productos = [];
    private IEnumerable<Proveedor> _proveedores = [];
    private bool _cargando = true;
    private bool _guardandoTodo;

    // Última cantidad persistida en BD por producto (para detectar cambios sin tocar el modelo).
    private readonly Dictionary<int, int> _valorGuardado = new();
    private readonly Dictionary<int, EstadoFila> _estadoFila = new();

    // Ninguno de los dos marcado = paso 1 (elegir grupo).
    private Proveedor? _grupoSeleccionado;
    private bool _sinProveedorSeleccionado;

    private bool _enRecuento => _grupoSeleccionado is not null || _sinProveedorSeleccionado;

    private string _nombreGrupoSeleccionado =>
        _sinProveedorSeleccionado ? "Sin proveedor asignado" : _grupoSeleccionado?.Nombre ?? string.Empty;

    private IEnumerable<Producto> _productosDelGrupo
    {
        get
        {
            if (_sinProveedorSeleccionado)
                return _productos.Where(p => p.ProveedorId is null).ToList();
            if (_grupoSeleccionado is null)
                return [];
            var proveedorId = _grupoSeleccionado.Id;
            return _productos.Where(p => p.ProveedorId == proveedorId).ToList();
        }
    }

    private int _pendientesEnGrupo => _productosDelGrupo.Count(p => EstadoDe(p) == EstadoFila.Pendiente);

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await ProveedorService.GetAllAsync();
        // Los productos con seguimiento individual (ver Producto.SeguimientoIndividual) no
        // se cuentan aquí: su stock se controla desde "Venta", el recuento manual semanal
        // no tiene sentido para ellos.
        _productos = (await ProductoService.GetAllAsync()).Where(p => !p.SeguimientoIndividual).ToList();
        foreach (var p in _productos)
        {
            _valorGuardado[p.Id] = p.StockActual;
            _estadoFila[p.Id] = EstadoFila.SinCambios;
        }
        _cargando = false;
    }

    private EstadoFila EstadoDe(Producto p) =>
        _estadoFila.TryGetValue(p.Id, out var e) ? e : EstadoFila.SinCambios;

    private void OnCantidadCambiada(Producto p, int nuevoValor)
    {
        p.StockActual = nuevoValor;
        var guardado = _valorGuardado.TryGetValue(p.Id, out var v) ? v : nuevoValor;
        _estadoFila[p.Id] = nuevoValor == guardado ? EstadoFila.SinCambios : EstadoFila.Pendiente;
    }

    private string FilaEstilo(Producto p, int index) => EstadoDe(p) switch
    {
        EstadoFila.Pendiente => "background-color:rgba(193,120,23,0.12);",
        EstadoFila.Guardado  => "background-color:rgba(102,187,106,0.16);",
        _                    => string.Empty
    };

    private void SeleccionarProveedor(Proveedor proveedor)
    {
        _sinProveedorSeleccionado = false;
        _grupoSeleccionado = proveedor;
    }

    private void SeleccionarSinProveedor()
    {
        _sinProveedorSeleccionado = true;
        _grupoSeleccionado = null;
    }

    private void Volver()
    {
        _grupoSeleccionado = null;
        _sinProveedorSeleccionado = false;
    }

    private async Task GuardarAsync(Producto producto)
    {
        var resultado = await ProductoService.ActualizarStockActualAsync(producto.Id, producto.StockActual);
        if (resultado.IsSuccess)
        {
            _valorGuardado[producto.Id] = producto.StockActual;
            _estadoFila[producto.Id] = EstadoFila.Guardado;
        }
        else
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
        }
    }

    private async Task GuardarTodoAsync()
    {
        var pendientes = _productosDelGrupo.Where(p => EstadoDe(p) == EstadoFila.Pendiente).ToList();
        if (pendientes.Count == 0)
            return;

        _guardandoTodo = true;
        var ok = 0;
        var errores = new List<string>();

        foreach (var producto in pendientes)
        {
            var resultado = await ProductoService.ActualizarStockActualAsync(producto.Id, producto.StockActual);
            if (resultado.IsSuccess)
            {
                _valorGuardado[producto.Id] = producto.StockActual;
                _estadoFila[producto.Id] = EstadoFila.Guardado;
                ok++;
            }
            else
            {
                errores.Add($"{producto.Nombre}: {resultado.Error.Message}");
            }
        }

        _guardandoTodo = false;

        if (ok > 0)
            Snackbar.Add($"{ok} producto{(ok == 1 ? "" : "s")} actualizado{(ok == 1 ? "" : "s")}", Severity.Success);
        foreach (var error in errores)
            Snackbar.Add(error, Severity.Error);
    }
}
