@page "/"
@attribute [Authorize(Policy = Politicas.Trabajador)]
@implements IDisposable
@inject MascotSettingsService MascotSettings

<PageTitle>CafeStock</PageTitle>

<div class="home">
    <section class="home-hero">
        <img src="LogoCafeteria.png" alt="" class="home-logo"/>
        <div class="home-hero-texto">
            <p class="home-eyebrow">Café de especialidad</p>
            <h1 class="home-titulo">CafeStock</h1>
            <p class="home-subtitulo">Stock, proveedores y compras de la cafetería, de un vistazo.</p>
        </div>
    </section>

    @* Accesos rápidos: tarjetas grandes y táctiles (mín. 44 px) en vez de botones sueltos.
       Cada una lleva a una página que ya existía; las de Encargado se esconden al Trabajador
       (la protección real es el [Authorize] de cada página). *@
    <nav class="home-acciones" aria-label="Accesos rápidos">
        <a class="accion accion--principal" href="/stock/realizar">
            <MudIcon Icon="@Icons.Material.Filled.Checklist" Class="accion-icono"/>
            <span class="accion-titulo">Realizar stock</span>
            <span class="accion-texto">Cuenta lo que hay, proveedor a proveedor</span>
        </a>
        <a class="accion" href="/productos">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="accion-icono"/>
            <span class="accion-titulo">Ver stock</span>
            <span class="accion-texto">Qué hay y qué falta reponer</span>
        </a>
        <a class="accion" href="/lista-compra">
            <MudIcon Icon="@Icons.Material.Filled.MoveToInbox" Class="accion-icono"/>
            <span class="accion-titulo">Recepcionar</span>
            <span class="accion-texto">Confirma lo que ha llegado</span>
        </a>
        <a class="accion" href="/vender">
            <MudIcon Icon="@CustomIcons.CoffeeBean" Class="accion-icono"/>
            <span class="accion-titulo">Venta de café</span>
            <span class="accion-texto">Registra cada café vendido</span>
        </a>
        <AuthorizeView Policy="@Politicas.Encargado">
            <a class="accion" href="/lista-detallada">
                <MudIcon Icon="@Icons.Material.Filled.ViewModule" Class="accion-icono"/>
                <span class="accion-titulo">Catálogo</span>
                <span class="accion-texto">Todos los productos, con su ficha</span>
            </a>
            <a class="accion" href="/proveedores">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="accion-icono"/>
                <span class="accion-titulo">Proveedores</span>
                <span class="accion-texto">Contacto y día de reparto</span>
            </a>
        </AuthorizeView>
    </nav>

    <MudButton Variant="Variant.Text"
               Color="Color.Secondary"
               StartIcon="@(MascotSettings.Enabled ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
               OnClick="ToggleMascotAsync"
               Class="home-mascota-toggle">
        @(MascotSettings.Enabled ? "Desactivar mascota guía" : "Activar mascota guía")
    </MudButton>

    @if (MascotSettings.Enabled)
    {
        <div class="home-presentation">
            <div class="home-welcome-bubble">
                <MudText Typo="Typo.body2">
                    ¡Bienvenido a CafeStock! Desde aquí gestionas proveedores, tu catálogo de productos, la reposición de stock y las ventas. Vamos paso a paso.
                </MudText>
            </div>
            <img src="images/mascot/mascot-saludo.png"
                 alt="Mascota CafeStock"
                 class="mascot-home-image"/>
        </div>
    }
    @* El bocadillo va primero en el marcado a propósito: en desktop se saca del flujo con
       position:absolute (no importa el orden), pero en el fallback de tablet estrecha
       (position:static, ver media query) necesita aparecer ANTES que el león en el
       documento para que la pila vertical normal lo muestre arriba, no debajo. *@
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Prerender sin circuito JS: la lectura de localStorage va aquí, no en OnInitializedAsync.
            await MascotSettings.InitializeAsync();
            MascotSettings.EnabledChanged += OnMascotEnabledChanged;
            StateHasChanged();
        }
    }

    private async Task ToggleMascotAsync()
    {
        await MascotSettings.SetEnabledAsync(!MascotSettings.Enabled);
    }

    private void OnMascotEnabledChanged(bool enabled) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        MascotSettings.EnabledChanged -= OnMascotEnabledChanged;
    }
}
