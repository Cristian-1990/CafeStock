@page "/"
@attribute [Authorize(Policy = Politicas.Trabajador)]
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject CafeStock.Back.Services.Facturas.IFacturaService FacturaService
@inject CafeStock.Back.Services.Informes.IInformeService Informes
@inject IUsuarioService UsuarioService

<PageTitle>CafeStock</PageTitle>

<div class="home">
    @* La mascota de Inicio la pinta AppMascot, igual que en el resto de pantallas (mensaje de bienvenida en
       MascotMessageProvider), en el margen izquierdo. *@

    @* Resumen del día: en vez de repetir el logo y el nombre (ya están en la cabecera), la banda de
       arriba saluda y da lo que importa al empezar el turno: cuánto hay que reponer. *@
    <section class="home-resumen" aria-label="Resumen del stock">
        <div class="home-saludo">
            <p class="home-eyebrow">@FechaHoy</p>
            <h1 class="home-titulo">
                <AuthorizeView>
                    <Authorized>@Saludo, @context.User.Identity?.Name</Authorized>
                    <NotAuthorized>@Saludo</NotAuthorized>
                </AuthorizeView>
            </h1>
            <p class="home-subtitulo">@FraseResumen</p>
        </div>

        @* Tres accesos a lo que el menú lateral tiene más escondido: la última factura, el informe de ahorro y
           los usuarios. Cada uno solo aparece a quien puede entrar (la protección real es el [Authorize] de
           cada página). El stock ya tiene su sitio justo debajo (Lo más urgente) y en el menú. *@
        <div class="home-cifras">
            <AuthorizeView Policy="@Politicas.Encargado">
                <a class="cifra" href="@EnlaceUltimaFactura">
                    <span class="cifra-numero cifra-numero--medio">@(_ultimaFactura is null ? "—" : $"{_importeUltimaFactura:F2} €")</span>
                    <span class="cifra-texto">Revisar última factura</span>
                </a>
                <a class="cifra" href="/informes">
                    <span class="cifra-numero cifra-numero--medio">@_ahorroPrecio.ToString("F2") €</span>
                    <span class="cifra-texto">Informe de ahorro</span>
                </a>
            </AuthorizeView>
            <AuthorizeView Policy="@Politicas.Admin">
                <a class="cifra" href="/admin/usuarios">
                    <span class="cifra-numero cifra-numero--medio">@_numeroUsuarios</span>
                    <span class="cifra-texto">Usuarios</span>
                </a>
            </AuthorizeView>
        </div>
    </section>

    @* Lo más urgente: los TRES productos más urgentes (los que están en mínimos), cada uno con su imagen
       del catálogo, su proveedor, su barra de nivel y un botón que abre Realizar stock en el proveedor
       al que pertenece, con ese producto destacado. "Ver todos" lleva a Stock con todos los productos por
       reponer en orden de urgencia (ver NivelStock.PorUrgencia). *@
    @if (_urgentes.Count > 0)
    {
        <section class="home-urgente" aria-labelledby="urgente-titulo">
            <div class="home-urgente-cabecera">
                <h2 id="urgente-titulo" class="home-urgente-titulo">Lo más urgente</h2>
                <a class="home-urgente-enlace" href="/productos?orden=urgencia">Ver todos</a>
            </div>
            <ul class="home-urgente-lista">
                @foreach (var urgente in _urgentes)
                {
                    var producto = urgente.Producto;
                    <li>
                        <span class="urgente-foto">
                            @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                            {
                                <img src="@producto.ImagenUrl" alt="" loading="lazy" decoding="async"/>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="urgente-foto-icono"/>
                            }
                        </span>
                        <span class="urgente-datos">
                            <span class="urgente-nombre">@producto.Nombre</span>
                            <span class="etiqueta-proveedor urgente-proveedor" style="@urgente.EstiloProveedor">@urgente.NombreProveedor</span>
                            <span class="urgente-nivel">
                                <span class="medidor @NivelStock.Clase(producto.StockActual, producto.StockMaximo)" role="img"
                                      aria-label="Stock @producto.StockActual de @producto.StockMaximo">
                                    <span class="medidor-relleno" style="width:@(NivelStock.Porcentaje(producto.StockActual, producto.StockMaximo))%"></span>
                                </span>
                                <span class="urgente-cifras">@producto.StockActual / @producto.StockMaximo</span>
                            </span>
                        </span>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Checklist"
                                   Href="@urgente.EnlaceHacerStock"
                                   Class="urgente-boton">
                            Hacer stock
                        </MudButton>
                    </li>
                }
            </ul>
        </section>
    }

    @* Accesos rápidos: tarjetas grandes y táctiles (mín. 44 px). Cada una lleva a una página que
       ya existía; Proveedores se esconde al Trabajador (la protección real es el [Authorize] de
       cada página). *@
    <nav class="home-acciones" aria-label="Accesos rápidos">
        <a class="accion accion--principal" href="/productos">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Class="accion-icono"/>
            <span class="accion-titulo">Stock</span>
            <span class="accion-texto">Qué hay, qué falta y el recuento</span>
        </a>
        <AuthorizeView Policy="@Politicas.Encargado">
            <a class="accion" href="/proveedores">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="accion-icono"/>
                <span class="accion-titulo">Proveedores</span>
                <span class="accion-texto">Contacto y día de reparto</span>
            </a>
        </AuthorizeView>
        <a class="accion" href="/vender">
            <MudIcon Icon="@CustomIcons.CoffeeBean" Class="accion-icono"/>
            <span class="accion-titulo">Venta de café</span>
            <span class="accion-texto">Registra cada café vendido</span>
        </a>
        <a class="accion" href="/lista-compra">
            <MudIcon Icon="@CustomIcons.DeliveryBox" Class="accion-icono"/>
            <span class="accion-titulo">Recepcionar</span>
            <span class="accion-texto">Confirma lo que ha llegado</span>
        </a>
    </nav>

</div>

@code {
    private static readonly string[] DiasSemana = ["domingo", "lunes", "martes", "miércoles", "jueves", "viernes", "sábado"];
    private static readonly string[] Meses =
        ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"];

    // Resumen del stock para la banda superior: solo lectura de lo que ya devuelve ProductoService.
    private int _porReponer;
    private int _sinStock;
    private int _completos;

    // Los tres accesos de la banda: última factura, ahorro por precio y nº de usuarios.
    private Compra? _ultimaFactura;
    private decimal _importeUltimaFactura;
    private decimal _ahorroPrecio;
    private int _numeroUsuarios;

    private string EnlaceUltimaFactura => _ultimaFactura is null ? "/facturas" : $"/facturas/{_ultimaFactura.Id}";

    // Un producto urgente, con lo necesario para pintar su fila: su proveedor (nombre y estilo de color) y
    // el enlace a Realizar stock en ese proveedor, con el producto destacado.
    private record ProductoUrgente(Producto Producto, string NombreProveedor, string EstiloProveedor, string EnlaceHacerStock);

    private List<ProductoUrgente> _urgentes = [];

    // Texto escrito a mano (sin CultureInfo): en la Pi la globalización puede no tener es-ES.
    private static string FechaHoy
    {
        get
        {
            var hoy = DateTime.Now;
            return $"{DiasSemana[(int)hoy.DayOfWeek]} {hoy.Day} de {Meses[hoy.Month - 1]}";
        }
    }

    private static string Saludo
    {
        get
        {
            var hora = DateTime.Now.Hour;
            if (hora >= 21) return "Buenas noches";
            if (hora >= 13) return "Buenas tardes";
            return "Buenos días";
        }
    }

    private string FraseResumen => _porReponer switch
    {
        0 => "Todo el stock está completo. ¡Buen turno!",
        1 => "Hay 1 producto por reponer.",
        _ => $"Hay {_porReponer} productos por reponer."
    };

    protected override async Task OnInitializedAsync()
    {
        var productos = (await ProductoService.GetAllAsync()).ToList();
        _porReponer = productos.Count(p => p.CantidadAComprar > 0);
        _sinStock = productos.Count(p => p.StockMaximo > 0 && p.StockActual <= 0);
        _completos = productos.Count(p => p.CantidadAComprar <= 0);

        // Accesos de la banda. Última factura = la compra más reciente; ahorro = lo que se ha dejado de pagar por
        // bajadas de precio respecto a la compra anterior (la suma de los impactos negativos, ver
        // CalcularVariacionesPrecio); usuarios = cuántas cuentas hay.
        var compras = (await FacturaService.GetAllAsync()).ToList();
        _ultimaFactura = compras.OrderByDescending(c => c.Fecha).FirstOrDefault();
        _importeUltimaFactura = _ultimaFactura is null ? 0m : CafeStock.Back.Services.Informes.InformeService.ImporteDe(_ultimaFactura);
        _ahorroPrecio = -Informes.CalcularVariacionesPrecio(compras).Where(v => v.ImpactoEuros < 0).Sum(v => v.ImpactoEuros);
        _numeroUsuarios = (await UsuarioService.ListarAsync()).Count;

        // Los tres productos más urgentes (ver NivelStock.PorUrgencia). Los de seguimiento individual (los
        // cafés de Venta) no entran: su stock no se cuenta en Realizar stock y el botón no los encontraría.
        var proveedores = (await ProveedorService.GetAllAsync()).ToDictionary(p => p.Id);
        _urgentes = NivelStock.PorUrgencia(productos.Where(p => !p.SeguimientoIndividual))
            .Take(3)
            .Select(p =>
            {
                var proveedor = p.ProveedorId is int id && proveedores.TryGetValue(id, out var prov) ? prov : null;
                var enlace = proveedor is null
                    ? $"/stock/realizar?sinProveedor=true&productoId={p.Id}"
                    : $"/stock/realizar?proveedorId={proveedor.Id}&productoId={p.Id}";
                return new ProductoUrgente(
                    p,
                    proveedor?.Nombre ?? "Sin proveedor",
                    PaletaProveedores.VariablesCss(proveedor),
                    enlace);
            })
            .ToList();
    }
}
