@page "/"
@implements IDisposable
@inject MascotSettingsService MascotSettings

<PageTitle>CafeStock</PageTitle>

<MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height:70vh;">
    <img src="LogoCafeteria.png" alt="Logo" style="height:180px; margin-bottom:24px;"/>
    <MudText Typo="Typo.h3" Align="Align.Center" Style="color:#3E2723;" Class="mb-2">
        CafeStock
    </MudText>
    <MudText Typo="Typo.subtitle1" Align="Align.Center" Style="color:#6D4C41;">
        Sistema de gestión de stock de la cafetería
    </MudText>

    <div class="d-flex gap-3 mt-6">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Inventory2"
                   Href="/productos">
            Ver productos
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.LocalShipping"
                   Href="/proveedores">
            Ver proveedores
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Checklist"
                   Href="/stock/realizar">
            Realizar stock
        </MudButton>
    </div>

    <MudButton Variant="Variant.Text"
               Color="Color.Secondary"
               StartIcon="@(MascotSettings.Enabled ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
               OnClick="ToggleMascotAsync"
               Class="mt-6">
        @(MascotSettings.Enabled ? "Desactivar mascota guía" : "Activar mascota guía")
    </MudButton>

    @if (MascotSettings.Enabled)
    {
        <div class="home-presentation">
            <div class="home-welcome-bubble">
                <MudText Typo="Typo.body2">
                    ¡Bienvenido a CafeStock! Desde aquí accedes a proveedores, productos, stock y ventas. Vamos paso a paso.
                </MudText>
            </div>
            <img src="images/mascot/mascot-saludo-home.png"
                 alt="Mascota CafeStock"
                 class="mascot-home-image"/>
        </div>
    }
    @* El bocadillo va primero en el marcado a propósito: en desktop se saca del flujo con
       position:absolute (no importa el orden), pero en el fallback de tablet estrecha
       (position:static, ver media query) necesita aparecer ANTES que el león en el
       documento para que la pila vertical normal lo muestre arriba, no debajo. *@
</MudContainer>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Prerender sin circuito JS: la lectura de localStorage va aquí, no en OnInitializedAsync.
            await MascotSettings.InitializeAsync();
            MascotSettings.EnabledChanged += OnMascotEnabledChanged;
            StateHasChanged();
        }
    }

    private async Task ToggleMascotAsync()
    {
        await MascotSettings.SetEnabledAsync(!MascotSettings.Enabled);
    }

    private void OnMascotEnabledChanged(bool enabled) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        MascotSettings.EnabledChanged -= OnMascotEnabledChanged;
    }
}