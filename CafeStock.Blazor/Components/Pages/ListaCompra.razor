@page "/lista-compra"
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject CafeStock.Blazor.Services.PdfService PdfService
@inject CafeStock.Blazor.Services.EmailService EmailService
@inject ISnackbar Snackbar

<PageTitle>Compra</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Compra</MudText>
</div>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_productos.Any())
{
    <MudAlert Severity="Severity.Success">Todo completo, no hay nada que comprar.</MudAlert>
}
else
{
    <div class="d-flex gap-2 mb-4">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Email"
                   OnClick="CrearListaCompra"
                   Disabled="_creandoListaCompra">
            @(_creandoListaCompra ? "Enviando..." : "Crear lista de la compra")
        </MudButton>
    </div>

    <MudPaper Class="pa-4" Elevation="2">
        <MudText Class="mb-3">Productos que necesitas comprar hoy:</MudText>
        <MudTable Items="_productos" Hover="true" Striped="true" Elevation="0">
            <HeaderContent>
                <MudTh>Producto</MudTh>
                <MudTh>Cantidad a comprar</MudTh>
                <MudTh>Cantidad recibida</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Producto">@context.Nombre</MudTd>
                <MudTd DataLabel="Cantidad a comprar">
                    <MudText Typo="Typo.subtitle1" Style="color:#7A2410; font-weight:700;">@context.CantidadAComprar</MudText>
                </MudTd>
                <MudTd DataLabel="Cantidad recibida">
                    <MudNumericField T="int"
                                      Value="_cantidadesRecibidas[context.Id]"
                                      ValueChanged="@((int v) => _cantidadesRecibidas[context.Id] = v)"
                                      Min="1"
                                      Variant="Variant.Outlined"
                                      Style="max-width:100px;"/>
                </MudTd>
                <MudTd DataLabel="Acciones">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Check"
                               OnClick="@(() => ConfirmarRecepcionAsync(context))">
                        Confirmar
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private IEnumerable<Producto> _productos = [];
    private Dictionary<int, Proveedor> _proveedoresPorId = [];
    private Dictionary<int, int> _cantidadesRecibidas = [];
    private bool _cargando = true;
    private bool _creandoListaCompra;

    private IEnumerable<Producto> _productosSupermercado =>
        _productos.Where(p =>
            p.ProveedorId.HasValue &&
            _proveedoresPorId.TryGetValue(p.ProveedorId.Value, out var proveedor) &&
            proveedor.EsSupermercadoGenerico);

    protected override async Task OnInitializedAsync()
    {
        var proveedores = await ProveedorService.GetAllAsync();
        _proveedoresPorId = proveedores.ToDictionary(p => p.Id);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _productos = await ProductoService.GetProductosBajoMinimoAsync();
        _cantidadesRecibidas = _productos.ToDictionary(p => p.Id, p => p.CantidadAComprar);
        _cargando = false;
    }

    private async Task CrearListaCompra()
    {
        var productosSupermercado = _productosSupermercado.ToList();
        if (!productosSupermercado.Any())
        {
            Snackbar.Add("No hay productos de supermercado pendientes de comprar", Severity.Warning);
            return;
        }

        _creandoListaCompra = true;
        try
        {
            var pdf = PdfService.GenerarListaCompra(productosSupermercado);
            await EmailService.EnviarListaCompraAsync(pdf);
            Snackbar.Add("Lista de la compra enviada por email", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _creandoListaCompra = false;
        }
    }

    private async Task ConfirmarRecepcionAsync(Producto producto)
    {
        var cantidadRecibida = _cantidadesRecibidas[producto.Id];
        var resultado = await ProductoService.ConfirmarRecepcionAsync(producto.Id, cantidadRecibida);
        if (resultado.IsSuccess)
        {
            Snackbar.Add($"Stock repuesto: {producto.Nombre} (+{cantidadRecibida})", Severity.Success);
            await CargarAsync();
        }
        else
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
        }
    }
}
