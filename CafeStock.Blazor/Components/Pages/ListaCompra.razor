@page "/lista-compra"
@using System.Text
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject CafeStock.Blazor.Services.PdfService PdfService
@inject CafeStock.Blazor.Services.EmailService EmailService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Lista de la compra</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Lista de la compra</MudText>
</div>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_productos.Any())
{
    <MudAlert Severity="Severity.Success">Todo completo, no hay nada que comprar.</MudAlert>
}
else
{
    <div class="d-flex gap-2 mb-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PictureAsPdf"
                   OnClick="DescargarPdf">
            Descargar PDF
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Email"
                   OnClick="EnviarPorEmail"
                   Disabled="_enviandoEmail">
            @(_enviandoEmail ? "Enviando..." : "Enviar por email")
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Storefront"
                   OnClick="GenerarPedido"
                   Disabled="_generandoPedido">
            @(_generandoPedido ? "Generando..." : "Generar pedido")
        </MudButton>
    </div>

    <MudPaper Class="pa-4" Elevation="2">
        <MudText Class="mb-3">Productos que necesitas comprar hoy:</MudText>
        <MudTable Items="_productos" Hover="true" Striped="true" Elevation="0">
            <HeaderContent>
                <MudTh>Producto</MudTh>
                <MudTh>Cantidad a comprar</MudTh>
                <MudTh>Cantidad recibida</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Producto">@context.Nombre</MudTd>
                <MudTd DataLabel="Cantidad a comprar">
                    <MudText Typo="Typo.subtitle1" Style="color:#7A2410; font-weight:700;">@context.CantidadAComprar</MudText>
                </MudTd>
                <MudTd DataLabel="Cantidad recibida">
                    <MudNumericField T="int"
                                      Value="_cantidadesRecibidas[context.Id]"
                                      ValueChanged="@((int v) => _cantidadesRecibidas[context.Id] = v)"
                                      Min="1"
                                      Variant="Variant.Outlined"
                                      Style="max-width:100px;"/>
                </MudTd>
                <MudTd DataLabel="Acciones">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Check"
                               OnClick="@(() => ConfirmarRecepcionAsync(context))">
                        Confirmar
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private IEnumerable<Producto> _productos = [];
    private Dictionary<int, int> _cantidadesRecibidas = [];
    private bool _cargando = true;
    private bool _enviandoEmail;
    private bool _generandoPedido;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _productos = await ProductoService.GetProductosBajoMinimoAsync();
        _cantidadesRecibidas = _productos.ToDictionary(p => p.Id, p => p.CantidadAComprar);
        _cargando = false;
    }

    private async Task DescargarPdf()
    {
        var pdf = PdfService.GenerarListaCompra(_productos);
        var base64 = Convert.ToBase64String(pdf);
        await JS.InvokeVoidAsync("descargarArchivo", "lista-compra.pdf", base64);
    }

    private async Task EnviarPorEmail()
    {
        _enviandoEmail = true;
        try
        {
            var pdf = PdfService.GenerarListaCompra(_productos);
            await EmailService.EnviarListaCompraAsync(pdf);
            Snackbar.Add("Lista de la compra enviada por email", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _enviandoEmail = false;
        }
    }

    private async Task GenerarPedido()
    {
        _generandoPedido = true;
        try
        {
            var proveedores = await ProveedorService.GetAllAsync();
            var cuerpo = ConstruirInformePedido(_productos, proveedores);
            await EmailService.EnviarInformePedidoAsync(cuerpo);
            Snackbar.Add("Pedido agrupado por proveedor enviado por email", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _generandoPedido = false;
        }
    }

    private static string ConstruirInformePedido(IEnumerable<Producto> productos, IEnumerable<Proveedor> proveedores)
    {
        var proveedoresPorId = proveedores.ToDictionary(p => p.Id);
        var grupos = productos
            .GroupBy(p => p.ProveedorId.HasValue && proveedoresPorId.ContainsKey(p.ProveedorId.Value) ? p.ProveedorId : null)
            .OrderBy(g => g.Key is null)
            .ThenBy(g => proveedoresPorId[g.Key!.Value].Nombre);

        var texto = new StringBuilder();
        texto.AppendLine("Pedido agrupado por proveedor:");
        texto.AppendLine();

        foreach (var grupo in grupos)
        {
            var titulo = grupo.Key.HasValue ? proveedoresPorId[grupo.Key.Value].Nombre : "Sin proveedor asignado";
            texto.AppendLine(titulo);
            foreach (var producto in grupo)
                texto.AppendLine($"  - {producto.Nombre}: pedir {producto.CantidadAComprar}, quedan {producto.StockActual}");
            texto.AppendLine();
        }

        return texto.ToString();
    }

    private async Task ConfirmarRecepcionAsync(Producto producto)
    {
        var cantidadRecibida = _cantidadesRecibidas[producto.Id];
        var resultado = await ProductoService.ConfirmarRecepcionAsync(producto.Id, cantidadRecibida);
        if (resultado.IsSuccess)
        {
            Snackbar.Add($"Stock repuesto: {producto.Nombre} (+{cantidadRecibida})", Severity.Success);
            await CargarAsync();
        }
        else
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
        }
    }
}
