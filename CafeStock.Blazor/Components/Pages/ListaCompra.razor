@page "/lista-compra"
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject CafeStock.Back.Services.Compras.ICompraService CompraService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Recepcionar</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Recepcionar</MudText>
</div>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_productos.Any())
{
    <MudAlert Severity="Severity.Success">Todo completo, no hay nada que comprar.</MudAlert>
}
else
{
    @foreach (var grupo in _grupos)
    {
        var proveedorId = grupo.Proveedor?.Id;
        var nombreProveedor = grupo.Proveedor?.Nombre ?? "Sin proveedor asignado";
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3" Style="color:#3E2723;">
                @nombreProveedor
            </MudText>

            <MudTable Items="grupo.Productos" Hover="true" Striped="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Producto</MudTh>
                    <MudTh>Cantidad a recibir</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Producto">@context.Nombre</MudTd>
                    <MudTd DataLabel="Cantidad a recibir">
                        <MudNumericField T="int"
                                          Value="_cantidadesRecibidas[context.Id]"
                                          ValueChanged="@((int v) => _cantidadesRecibidas[context.Id] = v)"
                                          Min="0"
                                          Variant="Variant.Outlined"
                                          Style="max-width:100px;"/>
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3"
                       StartIcon="@Icons.Material.Filled.Check"
                       OnClick="@(() => ConfirmarRecepcionGrupoAsync(proveedorId, nombreProveedor, grupo.Productos))"
                       Disabled="_confirmandoGrupo.Contains(proveedorId)">
                @(_confirmandoGrupo.Contains(proveedorId) ? "Confirmando..." : "Confirmar recepción")
            </MudButton>
        </MudPaper>
    }
}

@code {
    private IEnumerable<Producto> _productos = [];
    private IEnumerable<Proveedor> _proveedores = [];
    private Dictionary<int, int> _cantidadesRecibidas = [];
    private HashSet<int?> _confirmandoGrupo = [];
    private bool _cargando = true;

    private IEnumerable<(Proveedor? Proveedor, List<Producto> Productos)> _grupos =>
        AgrupadorProveedor.AgruparPorProveedor(_productos, _proveedores);

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await ProveedorService.GetAllAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _productos = await ProductoService.GetProductosBajoMinimoAsync();
        _cantidadesRecibidas = _productos.ToDictionary(p => p.Id, p => p.CantidadAComprar);
        _cargando = false;
    }

    /// <summary>
    /// Pide una confirmación extra antes de procesar la recepción del grupo — actualiza stock
    /// y registra una Compra, así que conviene un paso de seguridad antes de disparar la acción.
    /// </summary>
    private async Task ConfirmarRecepcionGrupoAsync(int? proveedorId, string nombreProveedor, List<Producto> productosGrupo)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"¿Seguro que quieres confirmar la recepción de '{nombreProveedor}'? Esto actualizará el stock y registrará la compra; no se puede deshacer." },
            { x => x.ConfirmText, "Confirmar" },
            { x => x.CancelText, "Cancelar" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar recepción", parameters);
        var resultado = await dialog.Result;

        if (resultado is not null && !resultado.Canceled)
            await ProcesarRecepcionGrupoAsync(proveedorId, productosGrupo);
    }

    /// <summary>
    /// Por cada producto con cantidad > 0 y precio unitario fijado (el que tiene el producto,
    /// no editable aquí), actualiza su stock (ConfirmarRecepcionAsync, que ya soporta recepción
    /// parcial) y añade una línea a la Compra que se registra al final. Los productos con
    /// cantidad 0 o sin precio fijado se saltan sin bloquear el resto del grupo.
    /// </summary>
    private async Task ProcesarRecepcionGrupoAsync(int? proveedorId, List<Producto> productosGrupo)
    {
        _confirmandoGrupo.Add(proveedorId);
        try
        {
            var lineas = new List<LineaCompra>();
            foreach (var producto in productosGrupo)
            {
                var cantidad = _cantidadesRecibidas[producto.Id];

                if (cantidad <= 0 || producto.PrecioUnitario <= 0)
                    continue;

                var resultado = await ProductoService.ConfirmarRecepcionAsync(producto.Id, cantidad);
                if (resultado.IsSuccess)
                {
                    lineas.Add(new LineaCompra { ProductoId = producto.Id, Cantidad = cantidad, PrecioUnitario = producto.PrecioUnitario });
                }
                else
                {
                    Snackbar.Add($"{producto.Nombre}: {resultado.Error.Message}", Severity.Error);
                }
            }

            if (!lineas.Any())
            {
                Snackbar.Add("Ningún producto de este grupo tenía cantidad y precio válidos", Severity.Warning);
                return;
            }

            var compra = new Compra { ProveedorId = proveedorId, Fecha = DateTime.Now, Lineas = lineas };
            var resultadoCompra = await CompraService.CreateAsync(compra);
            if (resultadoCompra.IsSuccess)
                Snackbar.Add($"Recepción confirmada: {lineas.Count} producto(s)", Severity.Success);
            else
                Snackbar.Add(resultadoCompra.Error.Message, Severity.Error);

            await CargarAsync();
        }
        finally
        {
            _confirmandoGrupo.Remove(proveedorId);
        }
    }
}
