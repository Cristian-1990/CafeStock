@page "/lista-compra"
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject CafeStock.Back.Services.Compras.ICompraService CompraService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Recepcionar</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Recepcionar</MudText>
</div>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_productos.Any())
{
    <MudAlert Severity="Severity.Success">Todo completo, no hay nada que comprar.</MudAlert>
}
else
{
    @foreach (var grupo in _grupos)
    {
        var proveedorId = grupo.Proveedor?.Id;
        var nombreProveedor = grupo.Proveedor?.Nombre ?? "Sin proveedor asignado";
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3" Style="color:#3E2723;">
                @nombreProveedor
            </MudText>

            <MudTable Items="grupo.Productos" Hover="true" Striped="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Producto</MudTh>
                    <MudTh>Cantidad a recibir</MudTh>
                    <MudTh>Precio unitario</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Producto">
                        @context.Nombre
                        @if (context.UnidadesPorPack is > 1)
                        {
                            <MudSwitch T="bool"
                                       Value="_recibidoEnPacks[context.Id]"
                                       ValueChanged="@((bool v) => _recibidoEnPacks[context.Id] = v)"
                                       Color="Color.Primary"
                                       Label="Recibido en packs"/>
                        }
                    </MudTd>
                    @if (_recibidoEnPacks[context.Id])
                    {
                        <MudTd DataLabel="Nº de packs">
                            <MudNumericField T="int"
                                              Label="Nº de packs"
                                              Value="_numPacksRecibidos[context.Id]"
                                              ValueChanged="@((int v) => _numPacksRecibidos[context.Id] = v)"
                                              Min="0"
                                              Variant="Variant.Outlined"
                                              Style="max-width:100px;"/>
                        </MudTd>
                        <MudTd DataLabel="Precio del pack">
                            <MudNumericField T="decimal"
                                              Label="Precio del pack"
                                              Value="_precioPackRecibido[context.Id]"
                                              ValueChanged="@((decimal v) => _precioPackRecibido[context.Id] = v)"
                                              Min="0"
                                              Format="F2"
                                              Adornment="Adornment.Start"
                                              AdornmentText="€"
                                              Variant="Variant.Outlined"
                                              Style="max-width:120px;"/>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="Cantidad a recibir">
                            <MudNumericField T="int"
                                              Value="_cantidadesRecibidas[context.Id]"
                                              ValueChanged="@((int v) => _cantidadesRecibidas[context.Id] = v)"
                                              Min="0"
                                              Variant="Variant.Outlined"
                                              Style="max-width:100px;"/>
                        </MudTd>
                        <MudTd DataLabel="Precio unitario">
                            <MudNumericField T="decimal"
                                              Value="_preciosRecibidos[context.Id]"
                                              ValueChanged="@((decimal v) => _preciosRecibidos[context.Id] = v)"
                                              Min="0"
                                              Format="F2"
                                              Adornment="Adornment.Start"
                                              AdornmentText="€"
                                              Variant="Variant.Outlined"
                                              Style="max-width:120px;"/>
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3"
                       StartIcon="@Icons.Material.Filled.Check"
                       OnClick="@(() => ConfirmarRecepcionGrupoAsync(proveedorId, nombreProveedor, grupo.Productos))"
                       Disabled="_confirmandoGrupo.Contains(proveedorId)">
                @(_confirmandoGrupo.Contains(proveedorId) ? "Confirmando..." : "Confirmar recepción")
            </MudButton>
        </MudPaper>
    }
}

@code {
    private IEnumerable<Producto> _productos = [];
    private IEnumerable<Proveedor> _proveedores = [];
    private Dictionary<int, int> _cantidadesRecibidas = [];
    private Dictionary<int, decimal> _preciosRecibidos = [];

    /// <summary>
    /// Toggle "Recibido en packs" por producto — solo se muestra (y solo importa) para
    /// productos con UnidadesPorPack > 1; desactivado por defecto para no cambiar el
    /// comportamiento actual sin que el usuario lo active explícitamente.
    /// </summary>
    private Dictionary<int, bool> _recibidoEnPacks = [];
    private Dictionary<int, int> _numPacksRecibidos = [];
    private Dictionary<int, decimal> _precioPackRecibido = [];
    private HashSet<int?> _confirmandoGrupo = [];
    private bool _cargando = true;

    private IEnumerable<(Proveedor? Proveedor, List<Producto> Productos)> _grupos =>
        AgrupadorProveedor.AgruparPorProveedor(_productos, _proveedores);

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await ProveedorService.GetAllAsync();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _productos = await ProductoService.GetProductosBajoMinimoAsync();
        _cantidadesRecibidas = _productos.ToDictionary(p => p.Id, p => p.CantidadAComprar);
        _preciosRecibidos = _productos.ToDictionary(p => p.Id, p => p.PrecioUnitario);
        _recibidoEnPacks = _productos.ToDictionary(p => p.Id, _ => false);
        _numPacksRecibidos = _productos.ToDictionary(p => p.Id, _ => 0);
        _precioPackRecibido = _productos.ToDictionary(p => p.Id, _ => 0m);
        _cargando = false;
    }

    /// <summary>
    /// Pide una confirmación extra antes de procesar la recepción del grupo — actualiza stock
    /// y registra una Compra, así que conviene un paso de seguridad antes de disparar la acción.
    /// </summary>
    private async Task ConfirmarRecepcionGrupoAsync(int? proveedorId, string nombreProveedor, List<Producto> productosGrupo)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"¿Seguro que quieres confirmar la recepción de '{nombreProveedor}'? Esto actualizará el stock y registrará la compra; no se puede deshacer." },
            { x => x.ConfirmText, "Confirmar" },
            { x => x.CancelText, "Cancelar" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirmar recepción", parameters);
        var resultado = await dialog.Result;

        if (resultado is not null && !resultado.Canceled)
            await ProcesarRecepcionGrupoAsync(proveedorId, productosGrupo);
    }

    /// <summary>
    /// Por cada producto con cantidad > 0 y precio introducido en el formulario > 0 (el precio
    /// de referencia previo del producto, si no tenía, ya no bloquea que aparezca aquí — solo
    /// se exige que se haya introducido uno válido en esta recepción), actualiza su stock
    /// (ConfirmarRecepcionAsync, que ya soporta recepción parcial) y añade una línea a la
    /// Compra que se registra al final. Los productos con cantidad 0 o sin precio introducido
    /// se saltan sin bloquear el resto del grupo.
    /// </summary>
    private async Task ProcesarRecepcionGrupoAsync(int? proveedorId, List<Producto> productosGrupo)
    {
        _confirmandoGrupo.Add(proveedorId);
        try
        {
            var lineas = new List<LineaCompra>();
            foreach (var producto in productosGrupo)
            {
                int cantidad;
                decimal precio;

                // Si "Recibido en packs" está activo para este producto, la Cantidad y el
                // PrecioUnitario finales se calculan aquí a partir de Nº de packs/Precio del
                // pack — a partir de este punto el flujo sigue exactamente igual que siempre
                // (ConfirmarRecepcionAsync, captura del excedente, LineaCompra), sin saber que
                // el origen fue un pack en vez de unidades sueltas.
                if (_recibidoEnPacks[producto.Id] && producto.UnidadesPorPack is > 1)
                {
                    var unidadesPorPack = producto.UnidadesPorPack.Value;
                    cantidad = _numPacksRecibidos[producto.Id] * unidadesPorPack;
                    precio = Math.Round(_precioPackRecibido[producto.Id] / unidadesPorPack, 2);
                }
                else
                {
                    cantidad = _cantidadesRecibidas[producto.Id];
                    precio = _preciosRecibidos[producto.Id];
                }

                if (cantidad <= 0 || precio <= 0)
                    continue;

                var resultado = await ProductoService.ConfirmarRecepcionAsync(producto.Id, cantidad);
                if (resultado.IsSuccess)
                {
                    // Captura silenciosa del excedente sobre StockMaximo (si lo hay): los dos
                    // valores en crudo, tal como quedan justo después de esta recepción — sin
                    // bloquear ni avisar nada aquí, solo quedan guardados en la línea para poder
                    // consultarlos más adelante (excedente = StockResultanteTrasRecepcion -
                    // StockMaximoEnMomento). Ambos vienen del Producto ya actualizado que
                    // devuelve ConfirmarRecepcionAsync, no de una consulta aparte.
                    lineas.Add(new LineaCompra
                    {
                        ProductoId = producto.Id,
                        Cantidad = cantidad,
                        PrecioUnitario = precio,
                        StockResultanteTrasRecepcion = resultado.Value.StockActual,
                        StockMaximoEnMomento = resultado.Value.StockMaximo
                    });
                }
                else
                {
                    Snackbar.Add($"{producto.Nombre}: {resultado.Error.Message}", Severity.Error);
                }
            }

            if (!lineas.Any())
            {
                Snackbar.Add("Ningún producto de este grupo tenía cantidad y precio válidos", Severity.Warning);
                return;
            }

            var compra = new Compra { ProveedorId = proveedorId, Fecha = DateTime.Now, Lineas = lineas };
            var resultadoCompra = await CompraService.CreateAsync(compra);
            if (resultadoCompra.IsSuccess)
                Snackbar.Add($"Recepción confirmada: {lineas.Count} producto(s)", Severity.Success);
            else
                Snackbar.Add(resultadoCompra.Error.Message, Severity.Error);

            await CargarAsync();
        }
        finally
        {
            _confirmandoGrupo.Remove(proveedorId);
        }
    }
}
