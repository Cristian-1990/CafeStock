@page "/informes"
@using ApexCharts

<PageTitle>Informes</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Informes</MudText>
</div>

@* TODO: datos de ejemplo, sustituir por consulta real a Compra/LineaCompra cuando se elija el diseño final *@

<MudText Typo="Typo.h6" Class="mb-2" Style="color:#3E2723;">Gasto mensual</MudText>
<MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
    <ApexChart TItem="PuntoDato" Title="Gasto mensual">
        <ApexPointSeries TItem="PuntoDato"
                         Items="_gastoMensual"
                         Name="Gasto"
                         SeriesType="SeriesType.Bar"
                         XValue="e => e.Etiqueta"
                         YValue="e => (decimal?)e.Valor"/>
    </ApexChart>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2" Style="color:#3E2723;">Evolución del precio de la Harina</MudText>
<MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
    <ApexChart TItem="PuntoDato" Title="Evolución del precio de la Harina">
        <ApexPointSeries TItem="PuntoDato"
                         Items="_precioHarina"
                         Name="Precio unitario"
                         SeriesType="SeriesType.Line"
                         XValue="e => e.Etiqueta"
                         YValue="e => (decimal?)e.Valor"/>
    </ApexChart>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2" Style="color:#3E2723;">Reparto de gasto por proveedor</MudText>
<MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
    <ApexChart TItem="PuntoDato" Title="Reparto de gasto por proveedor">
        <ApexPointSeries TItem="PuntoDato"
                         Items="_repartoProveedor"
                         Name="Porcentaje"
                         SeriesType="SeriesType.Pie"
                         XValue="e => e.Etiqueta"
                         YValue="e => (decimal?)e.Valor"/>
    </ApexChart>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2" Style="color:#3E2723;">Gasto total por proveedor</MudText>
<MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
    <ApexChart TItem="PuntoDato" Title="Gasto total por proveedor">
        <ApexPointSeries TItem="PuntoDato"
                         Items="_gastoPorProveedor"
                         Name="Total"
                         SeriesType="SeriesType.Bar"
                         XValue="e => e.Etiqueta"
                         YValue="e => (decimal?)e.Valor"/>
    </ApexChart>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2" Style="color:#3E2723;">Unidades compradas por mes</MudText>
<MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
    <ApexChart TItem="PuntoDato" Title="Unidades compradas por mes">
        <ApexPointSeries TItem="PuntoDato"
                         Items="_unidadesPorMes"
                         Name="Unidades"
                         SeriesType="SeriesType.Area"
                         XValue="e => e.Etiqueta"
                         YValue="e => (decimal?)e.Valor"/>
    </ApexChart>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2" Style="color:#3E2723;">Stock actual vs máximo (Harina)</MudText>
<MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
    <ApexChart TItem="PuntoDato" Title="Stock actual vs máximo (Harina)">
        <ApexPointSeries TItem="PuntoDato"
                         Items="_stockHarina"
                         Name="% de stock"
                         SeriesType="SeriesType.RadialBar"
                         XValue="e => e.Etiqueta"
                         YValue="e => (decimal?)e.Valor"/>
    </ApexChart>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2" Style="color:#3E2723;">Gasto por proveedor y mes</MudText>
<MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
    <ApexChart TItem="PuntoDato" Title="Gasto por proveedor y mes">
        @foreach (var (proveedor, datosDelMes) in _gastoPorProveedorYMes)
        {
            <ApexPointSeries TItem="PuntoDato"
                             Items="datosDelMes"
                             Name="@proveedor"
                             SeriesType="SeriesType.Heatmap"
                             XValue="e => e.Etiqueta"
                             YValue="e => (decimal?)e.Valor"/>
        }
    </ApexChart>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2" Style="color:#3E2723;">Productos más comprados</MudText>
<MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
    <ApexChart TItem="PuntoDato" Title="Productos más comprados" Options="_opcionesBarrasHorizontales">
        <ApexPointSeries TItem="PuntoDato"
                         Items="_productosMasComprados"
                         Name="Cantidad"
                         SeriesType="SeriesType.Bar"
                         XValue="e => e.Etiqueta"
                         YValue="e => (decimal?)e.Valor"/>
    </ApexChart>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2" Style="color:#3E2723;">Reparto del gasto: con proveedor vs sin asignar</MudText>
<MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
    <ApexChart TItem="PuntoDato" Title="Reparto del gasto: con proveedor vs sin asignar">
        <ApexPointSeries TItem="PuntoDato"
                         Items="_repartoConSinProveedor"
                         Name="Porcentaje"
                         SeriesType="SeriesType.Donut"
                         XValue="e => e.Etiqueta"
                         YValue="e => (decimal?)e.Valor"/>
    </ApexChart>
</MudPaper>

