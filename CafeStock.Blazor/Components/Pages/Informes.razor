@page "/informes"
@using ApexCharts

<PageTitle>Informes</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Informes</MudText>
</div>

<MudPaper Class="pa-4" Elevation="2" Style="max-width:600px;">
    <ApexChart TItem="GastoMensual" Title="Gasto mensual (ejemplo)">
        <ApexPointSeries TItem="GastoMensual"
                         Items="_datosEjemplo"
                         Name="Gasto"
                         SeriesType="SeriesType.Bar"
                         XValue="e => e.Mes"
                         YValue="e => (decimal?)e.Total"/>
    </ApexChart>
</MudPaper>

@code {
    private readonly List<GastoMensual> _datosEjemplo =
    [
        new("Ene", 120),
        new("Feb", 95),
        new("Mar", 140)
    ];

    private record GastoMensual(string Mes, int Total);
}
