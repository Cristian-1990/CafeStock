    protected override async Task OnInitializedAsync()
    {
        // No depende de JS ni del circuito interactivo (solo lee/escribe en la base de datos
        // por debajo), así que va aquí y no en OnAfterRenderAsync — a diferencia de lo que
        // aplica a diálogos u otra lógica que sí necesita el circuito ya montado.
        await SnapshotInventarioService.AsegurarSnapshotDeHoyAsync();

        _compras = (await FacturaService.GetAllAsync()).ToList();
        _productos = (await ProductoService.GetAllAsync()).OrderBy(p => p.Nombre).ToList();
        _proveedores = (await ProveedorService.GetAllAsync()).ToList();
        _presupuestos = (await PresupuestoService.GetAllAsync()).ToList();
        _snapshotsInventario = (await SnapshotInventarioService.GetAllAsync()).OrderBy(s => s.Fecha).ToList();

        CalcularGastoMesActual();
        _gastoPorProveedor = CalcularGastoPorProveedor(_rangoGastoProveedor);
        _productosPorGastoTotal = CalcularProductosPorGastoTotal();
        _gastoPorMetodoPago = CalcularGastoPorMetodoPago();
        _proveedoresSinCompraReciente = CalcularProveedoresSinCompraReciente();
        _ppvPorProducto = CalcularPpvPorProducto();
        _gastoPorTipoProveedor = CalcularGastoPorTipoProveedor();

        // Gasto por proveedor sin filtro (RangoFechas.Todo), reutilizado para el % de
        // concentración y para el € que muestra su tooltip (problema 2) — un único cálculo.
        var gastoPorProveedorEuros = CalcularGastoPorProveedor(RangoFechas.Todo);
        _concentracionGastoPorProveedor = CalcularConcentracionGastoPorProveedor(gastoPorProveedorEuros);
        _opcionesBarrasConcentracion.Tooltip = new Tooltip
        {
            Y = new TooltipY { Formatter = ConstruirFormatterConcentracion(gastoPorProveedorEuros) }
        };

        _ticketMedioPorProveedor = CalcularTicketMedioPorProveedor();
        _frecuenciaRepartoVsEsperado = CalcularFrecuenciaRepartoVsEsperado();
        RecalcularPresupuestoVsReal();
        _evolucionValorInventario = _snapshotsInventario.Select(s => new PuntoDato(s.Fecha.ToString("dd/MM/yy"), s.ValorTotal)).ToList();

        _cargando = false;
    }

    // ---- 1. Gasto del mes actual ----

    private void CalcularGastoMesActual()
    {
        var ahora = DateTime.Now;
        var inicioMesActual = new DateTime(ahora.Year, ahora.Month, 1);
        var inicioMesAnterior = inicioMesActual.AddMonths(-1);

        _gastoMesActual = _compras
            .Where(c => c.Fecha >= inicioMesActual && c.Fecha < inicioMesActual.AddMonths(1))
            .SelectMany(c => c.Lineas)
            .Sum(l => l.Cantidad * l.PrecioUnitario);

        var gastoMesAnterior = _compras
            .Where(c => c.Fecha >= inicioMesAnterior && c.Fecha < inicioMesActual)
            .SelectMany(c => c.Lineas)
            .Sum(l => l.Cantidad * l.PrecioUnitario);

        _variacionPct = gastoMesAnterior > 0
            ? (_gastoMesActual - gastoMesAnterior) / gastoMesAnterior * 100
            : null;
    }

    // ---- 2. Gasto por proveedor ----

    private async Task CambiarRangoGastoProveedorAsync(RangoFechas rango)
    {
        _rangoGastoProveedor = rango;
        _gastoPorProveedor = CalcularGastoPorProveedor(rango);
        // Guarda defensiva: si ya no queda ningún dato el gráfico se desmonta (rama else de
        // arriba), así que no llamamos a UpdateSeriesAsync sobre una instancia que va a morir.
        if (_gastoPorProveedor.Any() && _chartGastoProveedor is not null)
            await _chartGastoProveedor.UpdateSeriesAsync();
    }

    private List<PuntoDato> CalcularGastoPorProveedor(RangoFechas rango) =>
        AgruparGastoPorProveedorConId(FiltrarPorRango(_compras, rango))
            .Select(g => new PuntoDato(g.Nombre, g.Gasto))
            .ToList();

    /// <summary>
    /// Núcleo de "Gasto por proveedor" (Σ Cantidad×PrecioUnitario, agrupado por proveedor),
    /// conservando el ProveedorId además del nombre ya resuelto — el informe 2 y "Presupuesto
    /// vs Real" (12) reutilizan este mismo cálculo. PuntoDato no basta para el 12: necesita el
    /// Id para cruzar con Presupuesto.ProveedorId, no solo el nombre.
    /// </summary>
    private static List<(int? ProveedorId, string Nombre, decimal Gasto)> AgruparGastoPorProveedorConId(IEnumerable<Compra> compras) =>
        compras
            .GroupBy(c => c.ProveedorId)
            .Select(g => (
                ProveedorId: g.Key,
                Nombre: g.First().ProveedorNombre ?? "Sin proveedor asignado",
                Gasto: g.SelectMany(c => c.Lineas).Sum(l => l.Cantidad * l.PrecioUnitario)))
            .OrderByDescending(t => t.Gasto)
            .ToList();

    private static IEnumerable<Compra> FiltrarPorRango(IEnumerable<Compra> compras, RangoFechas rango)
    {
        var ahora = DateTime.Now;
        return rango switch
        {
            RangoFechas.EsteMes => compras.Where(c => c.Fecha.Year == ahora.Year && c.Fecha.Month == ahora.Month),
            RangoFechas.Ultimos3Meses => compras.Where(c => c.Fecha >= ahora.AddMonths(-3)),
            _ => compras
        };
    }

    // ---- 3. Evolución de precio por producto ----

    private Task<IEnumerable<Producto>> BuscarProductos(string valor, CancellationToken token)
    {
        var resultado = string.IsNullOrWhiteSpace(valor)
            ? _productos.AsEnumerable()
            : _productos.Where(p => p.Nombre.Contains(valor, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(resultado);
    }

    private async Task OnCambioProductoSeleccionadoAsync()
    {
        _evolucionPrecioProducto = CalcularEvolucionPrecio(_productoSeleccionado?.Id);
        // Misma guarda defensiva que en el punto 2: si no hay suficiente historial el gráfico
        // no se monta (rama else de arriba), así que no actualizamos una instancia inexistente.
        if (_evolucionPrecioProducto.Count >= 2 && _chartEvolucionPrecio is not null)
            await _chartEvolucionPrecio.UpdateSeriesAsync();
    }

    private List<PuntoDato> CalcularEvolucionPrecio(int? productoId)
    {
        if (productoId is null) return [];
        return _compras
            .SelectMany(c => c.Lineas.Where(l => l.ProductoId == productoId).Select(l => new { c.Fecha, l.PrecioUnitario }))
            .OrderBy(x => x.Fecha)
            .Select(x => new PuntoDato(x.Fecha.ToString("dd/MM/yy"), x.PrecioUnitario))
            .ToList();
    }

    // ---- 4. Productos con más peso en el gasto ----

    private List<PuntoDato> CalcularProductosPorGastoTotal() =>
        _compras
            .SelectMany(c => c.Lineas)
            .GroupBy(l => l.ProductoNombre ?? $"Producto #{l.ProductoId}")
            .Select(g => new PuntoDato(g.Key, g.Sum(l => l.Cantidad * l.PrecioUnitario)))
            .OrderByDescending(p => p.Valor)
            .Take(10)
            .ToList();

    // ---- 5. Gasto por método de pago ----

    private List<PuntoDato> CalcularGastoPorMetodoPago() =>
        _compras
            .GroupBy(c => string.IsNullOrWhiteSpace(c.MetodoPago) ? "Sin especificar" : c.MetodoPago)
            .Select(g => new PuntoDato(g.Key, g.SelectMany(c => c.Lineas).Sum(l => l.Cantidad * l.PrecioUnitario)))
            .OrderByDescending(p => p.Valor)
            .ToList();

    // ---- 6. Proveedores sin compra reciente ----

    private List<ProveedorAlerta> CalcularProveedoresSinCompraReciente()
    {
        var ultimaCompraPorProveedor = _compras
            .Where(c => c.ProveedorId is not null)
            .GroupBy(c => c.ProveedorId!.Value)
            .ToDictionary(g => g.Key, g => g.Max(c => c.Fecha));

        return _proveedores
            .Where(p => !string.IsNullOrWhiteSpace(p.DiaReparto))
            .Select(p => ultimaCompraPorProveedor.TryGetValue(p.Id, out var ultimaFecha)
                ? new ProveedorAlerta(p.Nombre, (DateTime.Now - ultimaFecha).Days)
                : new ProveedorAlerta(p.Nombre, null))
            .Where(a => a.DiasDesdeUltimaCompra is null or > UmbralDiasSinCompra)
            .OrderByDescending(a => a.DiasDesdeUltimaCompra ?? int.MaxValue)
            .ToList();
    }

    // ---- 7. PPV (Purchase Price Variance) por producto ----

    /// <summary>
    /// Para cada producto con al menos una LineaCompra histórica y precio de referencia
    /// fijado (Producto.PrecioUnitario > 0 — sin referencia no hay desviación que calcular):
    /// PPV = Σ (PrecioUnitario real de cada línea − PrecioUnitario de referencia) × Cantidad.
    /// PPV > 0 significa que se pagó de más respecto al precio de referencia; PPV &lt; 0, de menos.
    /// El % de desviación compara el precio real medio ponderado por cantidad (no la media
    /// simple, que pesaría igual una línea de 1 unidad que una de 100) contra la referencia.
    /// </summary>
    private List<PuntoDatoPpv> CalcularPpvPorProducto()
    {
        var productosPorId = _productos.ToDictionary(p => p.Id);

        return _compras
            .SelectMany(c => c.Lineas)
            .GroupBy(l => l.ProductoId)
            .Where(g => productosPorId.TryGetValue(g.Key, out var producto) && producto.PrecioUnitario > 0)
            .Select(g =>
            {
                var producto = productosPorId[g.Key];
                var ppv = g.Sum(l => (l.PrecioUnitario - producto.PrecioUnitario) * l.Cantidad);
                var cantidadTotal = g.Sum(l => l.Cantidad);
                var precioMedioPonderado = cantidadTotal > 0 ? g.Sum(l => l.PrecioUnitario * l.Cantidad) / cantidadTotal : 0;
                var porcentajeDesviacion = (precioMedioPonderado - producto.PrecioUnitario) / producto.PrecioUnitario * 100;
                return new PuntoDatoPpv(producto.Nombre, ppv, porcentajeDesviacion);
            })
            .OrderByDescending(p => Math.Abs(p.Valor))
            .ToList();
    }

    // ---- 8. Gasto en supermercado genérico vs proveedores habituales ----

    /// <summary>
    /// Compras sin proveedor asignado (ProveedorId null) quedan fuera: no se pueden
    /// clasificar como genérico/habitual sin proveedor.
    /// </summary>
    private List<PuntoDato> CalcularGastoPorTipoProveedor()
    {
        var proveedoresPorId = _proveedores.ToDictionary(p => p.Id);

        return _compras
            .Where(c => c.ProveedorId is not null && proveedoresPorId.ContainsKey(c.ProveedorId.Value))
            .GroupBy(c => proveedoresPorId[c.ProveedorId!.Value].EsSupermercadoGenerico)
            .Select(g => new PuntoDato(
                g.Key ? "Supermercado genérico" : "Proveedores habituales",
                g.SelectMany(c => c.Lineas).Sum(l => l.Cantidad * l.PrecioUnitario)))
            .OrderByDescending(p => p.Valor)
            .ToList();
    }

    // ---- 9. Concentración de gasto por proveedor ----

    /// <summary>
    /// Reutiliza CalcularGastoPorProveedor (informe 2, con RangoFechas.Todo — la concentración
    /// siempre es sobre el histórico completo, no está sujeta al filtro de fecha del informe 2)
    /// en vez de repetir el mismo GroupBy+Sum. El € por proveedor que devuelve esa llamada es
    /// justo lo que necesita también el tooltip combinado %+€ (problema 2, ver
    /// ConstruirFormatterConcentracion) — un único cálculo, dos usos.
    /// </summary>
    private List<PuntoDato> CalcularConcentracionGastoPorProveedor(List<PuntoDato> gastoPorProveedorEuros)
    {
        var gastoTotal = gastoPorProveedorEuros.Sum(g => g.Valor);
        if (gastoTotal <= 0) return [];

        return gastoPorProveedorEuros
            .Select(g => new PuntoDato(g.Etiqueta, g.Valor / gastoTotal * 100))
            .OrderByDescending(p => p.Valor)
            .ToList();
    }

    /// <summary>
    /// Tooltip específico de esta gráfica (problema 2): además del %, muestra el € real entre
    /// paréntesis, para no dejar ambigüedad sobre si un 63% son 100€ o 10.000€. Necesita un
    /// formatter distinto de FormatterPorcentaje porque tiene que mirar el € correspondiente a
    /// cada punto — se le pasa como un objeto JS embebido (proveedor → €), construido aquí a
    /// partir de gastoPorProveedorEuros (la misma lista reutilizada arriba).
    /// </summary>
    private static string ConstruirFormatterConcentracion(List<PuntoDato> gastoPorProveedorEuros)
    {
        var mapaEuros = string.Join(",", gastoPorProveedorEuros.Select(g =>
            $"{JsonSerializer.Serialize(g.Etiqueta)}:{g.Valor.ToString(CultureInfo.InvariantCulture)}"));

        return $$"""
            function(val, opts) {
                var eurosPorProveedor = {{{mapaEuros}}};
                var etiqueta = (opts && opts.w) ? opts.w.globals.labels[opts.dataPointIndex] : null;
                var euros = etiqueta !== null ? eurosPorProveedor[etiqueta] : undefined;
                var pctTexto = (typeof val === 'number' ? val.toFixed(1).replace('.', ',') : val) + ' %';
                if (typeof euros !== 'number') return pctTexto;
                return pctTexto + ' (' + euros.toFixed(2).replace('.', ',') + ' €)';
            }
            """;
    }

    // ---- 10. Ticket medio de compra por proveedor ----

    private List<PuntoDato> CalcularTicketMedioPorProveedor() =>
        _compras
            .GroupBy(c => c.ProveedorNombre ?? "Sin proveedor asignado")
            .Select(g => new PuntoDato(g.Key, g.Average(c => c.Lineas.Sum(l => l.Cantidad * l.PrecioUnitario))))
            .OrderByDescending(p => p.Valor)
            .ToList();

    // ---- 11. Frecuencia real de compra vs día de reparto esperado ----

    // Proveedor.DiaReparto es texto libre ("Miércoles 9:00", "Martes, Miércoles y Jueves"),
    // no un día limpio — ver valores reales comprobados en la base de datos de desarrollo.
    // Por eso la comparación es "¿el nombre del día real está contenido en el texto?" en vez
    // de una igualdad estricta contra un único DayOfWeek.
    private static readonly string[] NombresDiasSemana =
        ["Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado"];

    /// <summary>
    /// StringComparison.OrdinalIgnoreCase ignora mayúsculas/minúsculas pero NO tildes: "MIERCOLES"
    /// tecleado a mano (sin tilde) no haría match contra "Miércoles". CompareInfo con
    /// IgnoreNonSpace sí ignora diacríticos además de mayúsculas, así que "MIERCOLES",
    /// "miercoles" y "MIÉRCOLES" coinciden igual contra el texto libre de DiaReparto.
    /// </summary>
    private static bool DiaRepartoContiene(string diaReparto, string nombreDia) =>
        CultureInfo.InvariantCulture.CompareInfo.IndexOf(
            diaReparto, nombreDia, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0;

    /// <summary>
    /// Por cada proveedor con DiaReparto definido: de sus compras históricas, cuántas cayeron
    /// en un día que aparece mencionado en DiaReparto. Se marca Desviacion cuando hay compras
    /// registradas pero menos de la mitad (UmbralPorcentajeCumplimientoReparto) cayeron en el
    /// día esperado — mismo nivel de sencillez que el umbral fijo de "Proveedores sin compra
    /// reciente" (informe 6).
    /// </summary>
    private List<InformeReparto> CalcularFrecuenciaRepartoVsEsperado()
    {
        return _proveedores
            .Where(p => !string.IsNullOrWhiteSpace(p.DiaReparto))
            .Select(p =>
            {
                var comprasProveedor = _compras.Where(c => c.ProveedorId == p.Id).ToList();
                var total = comprasProveedor.Count;
                var enDiaEsperado = comprasProveedor.Count(c =>
                    DiaRepartoContiene(p.DiaReparto, NombresDiasSemana[(int)c.Fecha.DayOfWeek]));
                var porcentaje = total > 0 ? (decimal)enDiaEsperado / total * 100 : 0;
                var desviacion = total > 0 && porcentaje < UmbralPorcentajeCumplimientoReparto;

                return new InformeReparto(p.Nombre, p.DiaReparto, total, enDiaEsperado, porcentaje, desviacion);
            })
            .OrderByDescending(r => r.Desviacion)
            .ThenBy(r => r.Proveedor)
            .ToList();
    }

    // ---- 12. Presupuesto vs Real ----

    private async Task RecalcularPresupuestoVsRealAsync()
    {
        RecalcularPresupuestoVsReal();
        // Misma guarda defensiva que en los demás informes con selector: si ya no queda
        // ningún proveedor con presupuesto la gráfica se desmonta (rama @if de arriba), así
        // que no se llama a UpdateSeriesAsync sobre una instancia que va a morir.
        if (_presupuestoVsRealChartReal.Any() && _chartPresupuestoVsReal is not null)
            await _chartPresupuestoVsReal.UpdateSeriesAsync();
    }

    /// <summary>
    /// Todos los proveedores con al menos una Compra en el Mes/Año elegido (reutilizando
    /// AgruparGastoPorProveedorConId, el mismo cálculo del informe 2 — no se repite el
    /// GroupBy+Sum). Los que no tengan Presupuesto para ese Mes/Año no se excluyen: se marcan
    /// SinPresupuesto para que la tabla los muestre igualmente, tal como se pidió.
    /// </summary>
    private void RecalcularPresupuestoVsReal()
    {
        var comprasDelMes = _compras.Where(c => c.Fecha.Year == _anioPresupuestoVsReal && c.Fecha.Month == _mesPresupuestoVsReal);
        var gastoReal = AgruparGastoPorProveedorConId(comprasDelMes);

        _presupuestoVsReal = gastoReal
            .Select(g =>
            {
                var presupuesto = g.ProveedorId is int proveedorId
                    ? _presupuestos.FirstOrDefault(p => p.ProveedorId == proveedorId && p.Mes == _mesPresupuestoVsReal && p.Anio == _anioPresupuestoVsReal)
                    : null;
                var porcentajeDesviacion = presupuesto is not null && presupuesto.ImporteAsignado > 0
                    ? (g.Gasto - presupuesto.ImporteAsignado) / presupuesto.ImporteAsignado * 100
                    : (decimal?)null;

                return new PresupuestoVsRealFila(
                    g.Nombre, presupuesto?.ImporteAsignado, g.Gasto, porcentajeDesviacion, presupuesto is null);
            })
            .OrderByDescending(f => f.Real)
            .ToList();

        // La gráfica solo tiene sentido para quien tiene los dos valores que comparar; los
        // "Sin presupuesto" quedan solo en la tabla (nunca excluidos del informe entero).
        var conPresupuesto = _presupuestoVsReal.Where(f => !f.SinPresupuesto).ToList();
        _presupuestoVsRealChartPresupuesto = conPresupuesto.Select(f => new PuntoDato(f.Proveedor, f.Presupuesto!.Value)).ToList();
        _presupuestoVsRealChartReal = conPresupuesto.Select(f => new PuntoDato(f.Proveedor, f.Real)).ToList();
    }

    private record PuntoDato(string Etiqueta, decimal Valor);
    private record ProveedorAlerta(string Nombre, int? DiasDesdeUltimaCompra);
    private record PuntoDatoPpv(string Etiqueta, decimal Valor, decimal PorcentajeDesviacion);
    private record InformeReparto(string Proveedor, string DiaRepartoEsperado, int TotalCompras, int ComprasEnDiaEsperado, decimal PorcentajeCumplimiento, bool Desviacion);
    private record PresupuestoVsRealFila(string Proveedor, decimal? Presupuesto, decimal Real, decimal? PorcentajeDesviacion, bool SinPresupuesto);
}
