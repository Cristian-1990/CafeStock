@page "/informes"

<PageTitle>Informes</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Informes</MudText>
</div>

<MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height:50vh;">
    <MudIcon Icon="@Icons.Material.Filled.Insights" Style="font-size:4rem; color:#6D4C41;" Class="mb-4"/>
    <MudText Typo="Typo.h5" Align="Align.Center" Style="color:#3E2723;" Class="mb-2">
        En construcción
    </MudText>
    <MudText Typo="Typo.body1" Align="Align.Center" Style="color:#6D4C41; max-width:480px;">
        Próximamente: gasto mensual total, comparación de precios entre proveedores, y más análisis sobre tus compras.
    </MudText>
</MudContainer>
