@page "/informes"
@attribute [Authorize(Policy = Politicas.Encargado)]
@using System.Globalization
@using ApexCharts
@using CafeStock.Back.Models.Informes
@inject CafeStock.Back.Services.Facturas.IFacturaService FacturaService
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject CafeStock.Back.Services.SnapshotsInventario.ISnapshotInventarioService SnapshotInventarioService
@inject CafeStock.Back.Services.Presupuestos.IPresupuestoService PresupuestoService
@inject CafeStock.Back.Services.Informes.IInformeService InformeService

<PageTitle>Informes</PageTitle>

<div class="mb-4" style="background-color:rgba(var(--rgb-borde),0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:var(--color-dark); margin:0;">Informes</MudText>
</div>

@if (_cargando)
{
    <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true"/>
}
else
{
    @* Cuatro pestañas, de lo que se mira cada día (Resumen) a lo que se consulta de vez en cuando.
       Solo se pinta la pestaña activa: los gráficos se montan al abrirla. *@
    <MudTabs Elevation="0" Rounded="true" Class="informes-pestanas">

        @* ============================== RESUMEN ============================== *@
        <MudTabPanel Text="Resumen" Icon="@Icons.Material.Filled.Dashboard">
            <section class="kpi-rejilla" aria-label="Cifras clave del mes">
                <article class="kpi">
                    <p class="kpi-etiqueta">Gasto de este mes</p>
                    <p class="kpi-valor">@_resumen.GastoMes.ToString("F2") €</p>
                    <p class="kpi-detalle">Compras de @NombresMesesInformes[DateTime.Now.Month - 1], con los artículos sueltos</p>
                </article>

                <article class="kpi">
                    <p class="kpi-etiqueta">Mes anterior</p>
                    <p class="kpi-valor">@_gastoMesAnterior.ToString("F2") €</p>
                    @if (_resumen.VariacionGastoPorcentual is decimal variacion)
                    {
                        <p class="kpi-detalle" style="@($"color:{(variacion <= 0 ? "var(--color-good)" : "var(--color-bad)")}; font-weight:600;")">
                            <MudIcon Icon="@(variacion <= 0 ? Icons.Material.Filled.TrendingDown : Icons.Material.Filled.TrendingUp)" Size="MudBlazor.Size.Small" Class="kpi-icono"/>
                            Este mes @(variacion <= 0 ? "baja" : "sube") un @(Math.Abs(variacion).ToString("F1")) %
                        </p>
                    }
                    else
                    {
                        <p class="kpi-detalle">Sin gasto el mes anterior para comparar</p>
                    }
                </article>

                <article class="kpi">
                    <p class="kpi-etiqueta">Presupuesto consumido</p>
                    @if (_resumen.PorcentajePresupuestoConsumido is decimal consumido && _resumen.PresupuestoMes is decimal presupuesto)
                    {
                        <p class="kpi-valor">@consumido.ToString("F0") %</p>
                        <span class="kpi-barra" role="img" aria-label="Presupuesto consumido: @consumido.ToString("F0") %">
                            <span class="kpi-barra-relleno @ClaseBarraPresupuesto(consumido)" style="width:@(Math.Min(100m, consumido).ToString("F0", CultureInfo.InvariantCulture))%"></span>
                        </span>
                        <p class="kpi-detalle">Presupuesto del mes: @presupuesto.ToString("F2") €</p>
                    }
                    else
                    {
                        <p class="kpi-valor kpi-valor--apagado">—</p>
                        <p class="kpi-detalle">Sin presupuesto asignado este mes. Se pone en la ficha de cada proveedor.</p>
                    }
                </article>

                <article class="kpi">
                    <p class="kpi-etiqueta">Valor del inventario</p>
                    <p class="kpi-valor">@_resumen.ValorInventario.ToString("F2") €</p>
                    <p class="kpi-detalle">Stock actual a precio de referencia</p>
                </article>

                <a class="kpi kpi--enlace" href="/productos">
                    <p class="kpi-etiqueta">Productos sin stock</p>
                    <p class="@($"kpi-valor {(_resumen.ProductosAgotados > 0 ? "kpi-valor--alerta" : string.Empty)}")">@_resumen.ProductosAgotados</p>
                    <p class="kpi-detalle">@(_resumen.ProductosAgotados == 0 ? "Todo con existencias" : "Ver el stock")</p>
                </a>

                <a class="kpi kpi--enlace" href="/proveedores">
                    <p class="kpi-etiqueta">Proveedores sin compra reciente</p>
                    <p class="@($"kpi-valor {(_resumen.ProveedoresSinCompra > 0 ? "kpi-valor--alerta" : string.Empty)}")">@_resumen.ProveedoresSinCompra</p>
                    <p class="kpi-detalle">Más de @InformeService.UmbralDiasSinCompra días sin comprarles</p>
                </a>
            </section>

            <h2 class="informes-subtitulo">Lo que requiere tu atención</h2>
            @if (!_avisos.Any())
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">Todo en orden: no hay presupuestos superados, subidas de precio relevantes ni proveedores parados.</MudAlert>
            }
            else
            {
                <div class="informes-avisos">
                    @foreach (var aviso in _avisos)
                    {
                        <MudAlert Severity="@SeveridadDe(aviso.Nivel)" Variant="Variant.Outlined" Class="informes-aviso">
                            <strong>@aviso.Titulo</strong><br/>
                            <span>@aviso.Detalle</span>
                        </MudAlert>
                    }
                </div>
            }
        </MudTabPanel>

        @* ============================== GASTO ============================== *@
        <MudTabPanel Text="Gasto" Icon="@Icons.Material.Filled.Payments">
            <h2 class="informes-subtitulo">Gasto de los últimos 12 meses</h2>
            <MudPaper Class="pa-4 mb-6 informe-grafico" Elevation="2">
                <ApexChart TItem="PuntoDato" Title="Gasto mensual (€)" Options="_opcionesBarrasGastoMensual">
                    <ApexPointSeries TItem="PuntoDato"
                                     Items="_evolucionGastoMensual"
                                     Name="Gasto"
                                     SeriesType="SeriesType.Bar"
                                     XValue="e => e.Etiqueta"
                                     YValue="e => (decimal?)e.Valor"/>
                </ApexChart>
            </MudPaper>

            <h2 class="informes-subtitulo">¿Dónde se va el dinero?</h2>
            <div class="d-flex gap-2 mb-3">
                <MudChip T="string" Color="@(EsRangoActivoFiltroProveedores(RangoFechas.UltimaSemana) ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                         Variant="@(EsRangoActivoFiltroProveedores(RangoFechas.UltimaSemana) ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => CambiarRangoFiltroProveedoresAsync(RangoFechas.UltimaSemana))">
                    Esta semana
                </MudChip>
                <MudChip T="string" Color="@(EsRangoActivoFiltroProveedores(RangoFechas.UltimoMes) ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                         Variant="@(EsRangoActivoFiltroProveedores(RangoFechas.UltimoMes) ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => CambiarRangoFiltroProveedoresAsync(RangoFechas.UltimoMes))">
                    Este mes
                </MudChip>
                <MudChip T="string" Color="@(EsRangoActivoFiltroProveedores(RangoFechas.UltimoAno) ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                         Variant="@(EsRangoActivoFiltroProveedores(RangoFechas.UltimoAno) ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => CambiarRangoFiltroProveedoresAsync(RangoFechas.UltimoAno))">
                    Este año
                </MudChip>
                <MudChip T="string" Color="@(EsRangoActivoFiltroProveedores(RangoFechas.Todo) ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                         Variant="@(EsRangoActivoFiltroProveedores(RangoFechas.Todo) ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => CambiarRangoFiltroProveedoresAsync(RangoFechas.Todo))">
                    Todo
                </MudChip>
            </div>
            <div class="d-flex gap-4 flex-wrap align-end mb-4">
                @* PickerVariant.Dialog (no el Inline por defecto): el inline abre un desplegable anclado justo
                   bajo el campo, sin fondo oscurecido, que caía sobre la gráfica de debajo; el Dialog es un
                   modal centrado con fondo atenuado y no puede solaparse con nada.
                   El max-width va en un <div> envolvente, NO en Style="" del MudDatePicker: MudPicker reutiliza
                   su Style para el campo de texto y para la propia MudPaper del calendario, que heredaría el
                   ancho y encogería la cuadrícula de días. *@
                <div style="max-width:180px;">
                    <MudDatePicker Label="Desde" @bind-Date="_fechaDesdeFiltroProveedores" @bind-Date:after="OnFiltroLibreProveedoresAsync"
                                   PickerVariant="PickerVariant.Dialog" Editable="true" Clearable="true"/>
                </div>
                <div style="max-width:180px;">
                    <MudDatePicker Label="Hasta" @bind-Date="_fechaHastaFiltroProveedores" @bind-Date:after="OnFiltroLibreProveedoresAsync"
                                   PickerVariant="PickerVariant.Dialog" Editable="true" Clearable="true"/>
                </div>
                <MudSelect T="int?" @bind-Value="_proveedorIdFiltroProveedores" @bind-Value:after="OnFiltroLibreProveedoresAsync"
                           Label="Proveedor" Style="min-width:220px;">
                    <MudSelectItem T="int?" Value="@((int?)null)">Todos</MudSelectItem>
                    @foreach (var proveedor in _proveedores)
                    {
                        <MudSelectItem T="int?" Value="@((int?)proveedor.Id)">@proveedor.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </div>

            @if (!_gastoPorProveedor.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-6">No hay compras registradas en este rango.</MudAlert>
            }
            else
            {
                <MudPaper Class="pa-4 mb-6 informe-grafico" Elevation="2">
                    <ApexChart TItem="PuntoDato" @ref="_chartGastoProveedor" Title="Gasto por proveedor" Options="_opcionesBarrasGastoProveedor">
                        <ApexPointSeries TItem="PuntoDato"
                                         Items="_gastoPorProveedor"
                                         Name="Gasto"
                                         SeriesType="SeriesType.Bar"
                                         XValue="e => e.Etiqueta"
                                         YValue="e => (decimal?)e.Valor"/>
                    </ApexChart>
                </MudPaper>
            }

            <h2 class="informes-subtitulo">Productos con más peso en el gasto</h2>
            @if (!_productosPorGastoTotal.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-6">No hay compras registradas todavía.</MudAlert>
            }
            else
            {
                <MudPaper Class="pa-4 mb-6 informe-grafico" Elevation="2">
                    <ApexChart TItem="PuntoDato" Title="Los 10 productos que más gasto suman" Options="_opcionesBarrasProductosGasto">
                        <ApexPointSeries TItem="PuntoDato"
                                         Items="_productosPorGastoTotal"
                                         Name="Gasto total"
                                         SeriesType="SeriesType.Bar"
                                         XValue="e => e.Etiqueta"
                                         YValue="e => (decimal?)e.Valor"/>
                    </ApexChart>
                </MudPaper>
            }

            <h2 class="informes-subtitulo">Presupuesto vs real</h2>
            <div class="d-flex gap-4 flex-wrap mb-4" style="align-items:flex-end;">
                <MudSelect T="int" @bind-Value="_mesPresupuestoVsReal" @bind-Value:after="RecalcularPresupuestoVsRealAsync" Label="Mes" Style="min-width:160px;">
                    @for (var i = 1; i <= 12; i++)
                    {
                        var mes = i;
                        <MudSelectItem Value="mes">@NombresMesesInformes[mes - 1]</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int" @bind-Value="_anioPresupuestoVsReal" @bind-Value:after="RecalcularPresupuestoVsRealAsync" Label="Año" Min="2024" Style="max-width:120px;"/>
            </div>

            @if (!_presupuestoVsReal.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-6">No hay compras registradas en este mes.</MudAlert>
            }
            else
            {
                @if (_presupuestoVsRealChartReal.Any())
                {
                    <MudPaper Class="pa-4 mb-4 informe-grafico" Elevation="2">
                        <ApexChart TItem="PuntoDato" @ref="_chartPresupuestoVsReal" Title="Presupuesto vs real (proveedores con presupuesto asignado)" Options="_opcionesBarrasPresupuestoVsReal">
                            <ApexPointSeries TItem="PuntoDato"
                                             Items="_presupuestoVsRealChartPresupuesto"
                                             Name="Presupuesto"
                                             SeriesType="SeriesType.Bar"
                                             XValue="e => e.Etiqueta"
                                             YValue="e => (decimal?)e.Valor"/>
                            <ApexPointSeries TItem="PuntoDato"
                                             Items="_presupuestoVsRealChartReal"
                                             Name="Real"
                                             SeriesType="SeriesType.Bar"
                                             XValue="e => e.Etiqueta"
                                             YValue="e => (decimal?)e.Valor"/>
                        </ApexChart>
                    </MudPaper>
                }

                <MudTable Items="_presupuestoVsReal" Hover="true" Dense="true" Striped="true" Elevation="2" Class="mb-6" Style="max-width:700px;">
                    <HeaderContent>
                        <MudTh>Proveedor</MudTh>
                        <MudTh>Presupuesto</MudTh>
                        <MudTh>Real</MudTh>
                        <MudTh>% Desviación</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Proveedor">@context.Proveedor</MudTd>
                        <MudTd DataLabel="Presupuesto">
                            @(context.SinPresupuesto ? "Sin presupuesto" : $"{context.Presupuesto!.Value.ToString("F2")} €")
                        </MudTd>
                        <MudTd DataLabel="Real">@context.Real.ToString("F2") €</MudTd>
                        <MudTd DataLabel="% Desviación">
                            @if (context.PorcentajeDesviacion is decimal pct)
                            {
                                <MudText Style="@($"color:{(pct > 0 ? "var(--color-bad)" : "var(--color-good)")}; font-weight:600;")">
                                    @pct.ToString("F1") %
                                </MudText>
                            }
                            else
                            {
                                <MudText Style="color:#9E9E9E;">—</MudText>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }

            @* Lo que solo importa a la gestoría, recogido y cerrado por defecto. *@
            <MudExpansionPanels Class="mb-6" Elevation="0">
                <MudExpansionPanel Text="Para la gestoría">
                    <h3 class="informes-subtitulo informes-subtitulo--menor">Gasto por método de pago</h3>
                    @if (!_gastoPorMetodoPago.Any())
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">No hay compras registradas todavía.</MudAlert>
                    }
                    else
                    {
                        <MudPaper Class="pa-4 mb-4 informe-grafico" Elevation="0">
                            <ApexChart TItem="PuntoDato" Title="Gasto por método de pago" Options="_opcionesDonutMetodoPago">
                                <ApexPointSeries TItem="PuntoDato"
                                                 Items="_gastoPorMetodoPago"
                                                 Name="Gasto"
                                                 SeriesType="SeriesType.Donut"
                                                 XValue="e => e.Etiqueta"
                                                 YValue="e => (decimal?)e.Valor"/>
                            </ApexChart>
                        </MudPaper>
                    }

                    <h3 class="informes-subtitulo informes-subtitulo--menor">Supermercado genérico frente a proveedores habituales</h3>
                    @if (!_gastoPorTipoProveedor.Any())
                    {
                        <MudAlert Severity="Severity.Info">No hay compras con proveedor asignado todavía.</MudAlert>
                    }
                    else
                    {
                        <MudPaper Class="pa-4 informe-grafico" Elevation="0">
                            <ApexChart TItem="PuntoDato" Title="Gasto por tipo de proveedor" Options="_opcionesDonutTipoProveedor">
                                <ApexPointSeries TItem="PuntoDato"
                                                 Items="_gastoPorTipoProveedor"
                                                 Name="Gasto"
                                                 SeriesType="SeriesType.Donut"
                                                 XValue="e => e.Etiqueta"
                                                 YValue="e => (decimal?)e.Valor"/>
                            </ApexChart>
                        </MudPaper>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudTabPanel>

        @* ============================== PRECIOS ============================== *@
        <MudTabPanel Text="Precios" Icon="@Icons.Material.Filled.PriceChange">
            <h2 class="informes-subtitulo">¿Te suben o te bajan los precios?</h2>
            <p class="informes-ayuda">Compara el precio de la última compra de cada producto con el de la compra anterior. El importe es lo que ha supuesto en esa última compra.</p>
            @if (!_variacionesPrecio.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-6">Todavía no hay productos con dos compras a precios distintos que comparar.</MudAlert>
            }
            else
            {
                <section class="kpi-rejilla kpi-rejilla--dos" aria-label="Resumen de las variaciones de precio">
                    <article class="kpi">
                        <p class="kpi-etiqueta">Pagado de más por subidas</p>
                        <p class="kpi-valor kpi-valor--alerta">@_sobrecostePrecio.ToString("F2") €</p>
                        <p class="kpi-detalle">@Productos(_variacionesPrecio.Count(v => v.ImpactoEuros > 0), "más caro", "más caros") que en la compra anterior</p>
                    </article>
                    <article class="kpi">
                        <p class="kpi-etiqueta">Ahorrado por bajadas</p>
                        <p class="kpi-valor kpi-valor--bueno">@_ahorroPrecio.ToString("F2") €</p>
                        <p class="kpi-detalle">@Productos(_variacionesPrecio.Count(v => v.ImpactoEuros < 0), "más barato", "más baratos") que en la compra anterior</p>
                    </article>
                </section>

                <MudTable Items="_variacionesPrecio" Hover="true" Dense="true" Striped="true" Elevation="2" Class="mb-6" Style="max-width:760px;" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh>Producto</MudTh>
                        <MudTh>Antes</MudTh>
                        <MudTh>Ahora</MudTh>
                        <MudTh>Variación</MudTh>
                        <MudTh>Impacto</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Producto">@context.Producto</MudTd>
                        <MudTd DataLabel="Antes">@context.PrecioAnterior.ToString("F2") €</MudTd>
                        <MudTd DataLabel="Ahora">@context.PrecioActual.ToString("F2") €</MudTd>
                        <MudTd DataLabel="Variación">
                            <MudText Style="@($"color:{(context.PorcentajeVariacion > 0 ? "var(--color-bad)" : "var(--color-good)")}; font-weight:600;")">
                                @(context.PorcentajeVariacion > 0 ? "+" : string.Empty)@context.PorcentajeVariacion.ToString("F1") %
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Impacto">
                            <MudText Style="@($"color:{(context.ImpactoEuros > 0 ? "var(--color-bad)" : "var(--color-good)")}; font-weight:600;")">
                                @(context.ImpactoEuros > 0 ? "+" : string.Empty)@context.ImpactoEuros.ToString("F2") €
                            </MudText>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new[] { 10 }" RowsPerPageString="Filas por página" InfoFormat="{first_item}-{last_item} de {all_items}"/>
                    </PagerContent>
                </MudTable>
            }

            <h2 class="informes-subtitulo">Evolución del precio de un producto</h2>
            <MudAutocomplete T="Producto" @bind-Value="_productoSeleccionado" @bind-Value:after="OnCambioProductoSeleccionadoAsync"
                              Label="Producto"
                              Placeholder="Escribe el nombre del producto..."
                              SearchFunc="BuscarProductos"
                              ToStringFunc="@(p => p?.Nombre)"
                              Clearable="true"
                              Variant="Variant.Outlined"
                              Style="max-width:300px;"
                              Class="mb-4"/>
            @if (_productoSeleccionado is null)
            {
                <MudAlert Severity="Severity.Info" Class="mb-6">Elige un producto para ver la evolución de su precio.</MudAlert>
            }
            else if (_evolucionPrecioProducto.Count < 2)
            {
                <MudAlert Severity="Severity.Info" Class="mb-6">No hay suficiente historial para este producto.</MudAlert>
            }
            else
            {
                <MudPaper Class="pa-4 mb-6 informe-grafico" Elevation="2">
                    <ApexChart TItem="PuntoDato" @ref="_chartEvolucionPrecio" Title="Evolución de precio" Options="_opcionesLineaEvolucionPrecio">
                        <ApexPointSeries TItem="PuntoDato"
                                         Items="_evolucionPrecioProducto"
                                         Name="Precio unitario"
                                         SeriesType="SeriesType.Line"
                                         XValue="e => e.Etiqueta"
                                         YValue="e => (decimal?)e.Valor"/>
                    </ApexChart>
                </MudPaper>
            }

            <h2 class="informes-subtitulo">Frente al precio de referencia</h2>
            <p class="informes-ayuda">Cuánto se ha pagado de más o de menos respecto al precio de referencia que tiene cada producto. Solo aparecen los que se desvían.</p>
            @if (!_ppvPorProducto.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-6">No hay productos con precio de referencia y compras que se desvíen.</MudAlert>
            }
            else
            {
                <MudPaper Class="pa-4 mb-4 informe-grafico" Elevation="2">
                    <ApexChart TItem="PuntoDatoPpv" Title="Desviación por producto (€)" Options="_opcionesBarrasPpv">
                        <ApexPointSeries TItem="PuntoDatoPpv"
                                         Items="_ppvPorProducto"
                                         Name="Desviación"
                                         SeriesType="SeriesType.Bar"
                                         XValue="e => e.Etiqueta"
                                         YValue="e => (decimal?)e.Valor"
                                         PointColor='e => e.Valor > 0 ? "#993C1D" : "#3B6D11"'/>
                    </ApexChart>
                </MudPaper>
                <MudTable Items="_ppvPorProducto" Hover="true" Dense="true" Striped="true" Elevation="2" Class="mb-6" Style="max-width:600px;">
                    <HeaderContent>
                        <MudTh>Producto</MudTh>
                        <MudTh>Diferencia</MudTh>
                        <MudTh>% Desviación</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Producto">@context.Etiqueta</MudTd>
                        <MudTd DataLabel="Diferencia">
                            <MudText Style="@($"color:{(context.Valor > 0 ? "var(--color-bad)" : "var(--color-good)")}; font-weight:600;")">
                                @context.Valor.ToString("F2") €
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="% Desviación">@context.PorcentajeDesviacion.ToString("F1") %</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        @* ============================== INVENTARIO Y PROVEEDORES ============================== *@
        <MudTabPanel Text="Inventario y proveedores" Icon="@Icons.Material.Filled.Inventory2">
            <h2 class="informes-subtitulo">Valor del inventario</h2>
            @if (!_snapshotsInventario.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-6">Todavía no hay ninguna foto del inventario — el historial empieza a acumularse desde hoy.</MudAlert>
            }
            else
            {
                <section class="kpi-rejilla kpi-rejilla--uno" aria-label="Valor actual del inventario">
                    <article class="kpi">
                        <p class="kpi-etiqueta">Valor del inventario actual</p>
                        <p class="kpi-valor">@_snapshotsInventario[^1].ValorTotal.ToString("F2") €</p>
                        <p class="kpi-detalle">@_snapshotsInventario[^1].Fecha.ToString("dd/MM/yyyy")</p>
                    </article>
                </section>

                @if (_snapshotsInventario.Count < 2)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-6">Aún no hay suficiente historial para ver una evolución — vuelve en unos días.</MudAlert>
                }
                else
                {
                    <MudPaper Class="pa-4 mb-6 informe-grafico" Elevation="2">
                        <ApexChart TItem="PuntoDato" Title="Evolución del valor del inventario" Options="_opcionesLineaValorInventario">
                            <ApexPointSeries TItem="PuntoDato"
                                             Items="_evolucionValorInventario"
                                             Name="Valor de inventario"
                                             SeriesType="SeriesType.Line"
                                             XValue="e => e.Etiqueta"
                                             YValue="e => (decimal?)e.Valor"/>
                        </ApexChart>
                    </MudPaper>
                }
            }

            <h2 class="informes-subtitulo">Proveedores sin compra reciente</h2>
            @if (!_proveedoresSinCompraReciente.Any())
            {
                <MudAlert Severity="Severity.Success" Class="mb-6">Todos los proveedores con reparto asignado tienen compras recientes.</MudAlert>
            }
            else
            {
                <div class="mb-6">
                    @foreach (var alerta in _proveedoresSinCompraReciente)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-2" Style="max-width:600px;">
                            <b>@alerta.Nombre</b> — @(alerta.DiasDesdeUltimaCompra is int dias ? $"Última compra: hace {dias} días" : "Sin compras registradas")
                        </MudAlert>
                    }
                </div>
            }

            <h2 class="informes-subtitulo">Frecuencia de compra frente al reparto esperado</h2>
            @if (!_frecuenciaRepartoVsEsperado.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-6">Ningún proveedor tiene día de reparto definido.</MudAlert>
            }
            else
            {
                <MudTable Items="_frecuenciaRepartoVsEsperado" Hover="true" Dense="true" Striped="true" Elevation="2" Class="mb-6" Style="max-width:700px;">
                    <HeaderContent>
                        <MudTh>Proveedor</MudTh>
                        <MudTh>Reparto esperado</MudTh>
                        <MudTh>Compras (en día esperado / total)</MudTh>
                        <MudTh>% Cumplimiento</MudTh>
                        <MudTh>Indicador</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Proveedor">@context.Proveedor</MudTd>
                        <MudTd DataLabel="Reparto esperado">@context.DiaRepartoEsperado</MudTd>
                        <MudTd DataLabel="Compras">@context.ComprasEnDiaEsperado / @context.TotalCompras</MudTd>
                        <MudTd DataLabel="% Cumplimiento">@(context.TotalCompras > 0 ? $"{context.PorcentajeCumplimiento:F0} %" : "—")</MudTd>
                        <MudTd DataLabel="Indicador">
                            @if (context.TotalCompras == 0)
                            {
                                <MudText Style="color:#9E9E9E;">Sin compras registradas</MudText>
                            }
                            else if (context.Desviacion)
                            {
                                <MudChip T="string" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.Warning">Desviación</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="MudBlazor.Color.Success" Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.Check">Cumple</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }

            <h2 class="informes-subtitulo">Recepciones que superaron el stock máximo</h2>
            @if (!_recepcionesConExcedente.Any())
            {
                <MudAlert Severity="Severity.Info" Class="mb-6">No hay recepciones que hayan superado el máximo configurado.</MudAlert>
            }
            else
            {
                @* MudTable no tiene "Pageable": la paginación se activa solo con <PagerContent>; RowsPerPage fija
                   el tamaño inicial. El texto del pager hay que darlo a mano (sin localización de MudBlazor). *@
                <MudTable Items="_recepcionesConExcedente" Hover="true" Dense="true" Striped="true" Elevation="2" Class="mb-6" Style="max-width:700px;"
                          RowsPerPage="10">
                    <HeaderContent>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Producto</MudTh>
                        <MudTh>Proveedor</MudTh>
                        <MudTh>Cantidad recibida</MudTh>
                        <MudTh>Excedente</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Fecha">@context.Fecha.ToString("dd/MM/yyyy")</MudTd>
                        <MudTd DataLabel="Producto">@context.Producto</MudTd>
                        <MudTd DataLabel="Proveedor">@context.Proveedor</MudTd>
                        <MudTd DataLabel="Cantidad recibida">@context.Cantidad</MudTd>
                        <MudTd DataLabel="Excedente">@context.Excedente.ToString("F2")</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new[] { 10 }" RowsPerPageString="Filas por página" InfoFormat="{first_item}-{last_item} de {all_items}"/>
                    </PagerContent>
                </MudTable>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    private bool _cargando = true;
    private List<Compra> _compras = [];
    private List<Producto> _productos = [];
    private List<Proveedor> _proveedores = [];
    private List<Presupuesto> _presupuestos = [];

    // Resumen
    private ResumenInforme _resumen = new(0, null, null, null, 0, 0, 0);
    private decimal _gastoMesAnterior;
    private List<AvisoInforme> _avisos = [];

    // Gasto
    private List<PuntoDato> _evolucionGastoMensual = [];

    // Gasto por proveedor — filtro: rango de fechas (chips o libre) + proveedor.
    // Por defecto "Este año": con una cafetería que no compra a diario, "Este mes" suele empezar vacío.
    private RangoFechas _rangoFiltroProveedores = RangoFechas.UltimoAno;
    private DateTime? _fechaDesdeFiltroProveedores;
    private DateTime? _fechaHastaFiltroProveedores;
    private int? _proveedorIdFiltroProveedores;
    private List<PuntoDato> _gastoPorProveedor = [];
    private ApexChart<PuntoDato>? _chartGastoProveedor;

    private List<PuntoDato> _productosPorGastoTotal = [];
    private List<PuntoDato> _gastoPorMetodoPago = [];
    private List<PuntoDato> _gastoPorTipoProveedor = [];

    // Presupuesto vs real
    private static readonly string[] NombresMesesInformes =
    [
        "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
    ];
    private int _mesPresupuestoVsReal = DateTime.Now.Month;
    private int _anioPresupuestoVsReal = DateTime.Now.Year;
    private List<PresupuestoVsRealFila> _presupuestoVsReal = [];
    private List<PuntoDato> _presupuestoVsRealChartPresupuesto = [];
    private List<PuntoDato> _presupuestoVsRealChartReal = [];
    private ApexChart<PuntoDato>? _chartPresupuestoVsReal;

    // Precios
    private List<VariacionPrecio> _variacionesPrecio = [];
    private decimal _sobrecostePrecio;
    private decimal _ahorroPrecio;
    private Producto? _productoSeleccionado;
    private List<PuntoDato> _evolucionPrecioProducto = [];
    private ApexChart<PuntoDato>? _chartEvolucionPrecio;
    private List<PuntoDatoPpv> _ppvPorProducto = [];

    // Inventario y proveedores
    // Ordenada por Fecha ascendente: [^1] es el snapshot más reciente y el orden natural es el que
    // necesita la gráfica de línea.
    private List<SnapshotInventario> _snapshotsInventario = [];
    private List<PuntoDato> _evolucionValorInventario = [];
    private List<ProveedorAlerta> _proveedoresSinCompraReciente = [];
    private List<InformeReparto> _frecuenciaRepartoVsEsperado = [];
    private List<LineaExcedenteStock> _recepcionesConExcedente = [];

    // Formatters de ApexCharts (tooltip.y y yaxis.labels): se ejecutan en JS en el navegador, así que no
    // pueden reutilizar el ToString("F2") de C#; replican la misma regla (coma decimal, 2 decimales + "€").
    // Sin formatter, ApexCharts muestra el número JS en crudo sin redondear.
    private const string FormatterEuros =
        "function(val) { return (typeof val === 'number' ? val.toFixed(2).replace('.', ',') : val) + ' €'; }";

    // Una instancia de opciones por gráfica (no una compartida): dos ApexChart montados a la vez
    // reutilizando el mismo objeto Options daban un gráfico en blanco sin excepción alguna.
    private readonly ApexChartOptions<PuntoDato> _opcionesBarrasGastoMensual = new()
    {
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    private readonly ApexChartOptions<PuntoDato> _opcionesBarrasGastoProveedor = new()
    {
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true }
        },
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    private readonly ApexChartOptions<PuntoDato> _opcionesLineaEvolucionPrecio = new()
    {
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    private readonly ApexChartOptions<PuntoDato> _opcionesBarrasProductosGasto = new()
    {
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true }
        },
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    private readonly ApexChartOptions<PuntoDato> _opcionesDonutMetodoPago = new()
    {
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } }
        // Los donut no tienen eje Y — no aplica Yaxis.Labels.Formatter aquí.
    };

    private readonly ApexChartOptions<PuntoDatoPpv> _opcionesBarrasPpv = new()
    {
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true }
        },
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    private readonly ApexChartOptions<PuntoDato> _opcionesDonutTipoProveedor = new()
    {
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } }
    };

    private readonly ApexChartOptions<PuntoDato> _opcionesBarrasPresupuestoVsReal = new()
    {
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    private readonly ApexChartOptions<PuntoDato> _opcionesLineaValorInventario = new()
    {
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    protected override async Task OnInitializedAsync()
    {
        // No depende de JS ni del circuito interactivo (solo lee/escribe en la base de datos por debajo),
        // así que va aquí y no en OnAfterRenderAsync.
        await SnapshotInventarioService.AsegurarSnapshotDeHoyAsync();

        _compras = (await FacturaService.GetAllAsync()).ToList();
        _productos = (await ProductoService.GetAllAsync()).OrderBy(p => p.Nombre).ToList();
        _proveedores = (await ProveedorService.GetAllAsync()).ToList();
        _presupuestos = (await PresupuestoService.GetAllAsync()).ToList();
        _snapshotsInventario = (await SnapshotInventarioService.GetAllAsync()).OrderBy(s => s.Fecha).ToList();

        // Los cálculos viven en InformeService (CafeStock.Back, con tests); esta página solo carga los
        // datos, guarda el estado de los filtros y pinta.
        _resumen = InformeService.CalcularResumen(_compras, _presupuestos, _proveedores, _productos);
        _avisos = InformeService.CalcularAvisos(_compras, _presupuestos, _proveedores, _productos);

        _evolucionGastoMensual = InformeService.CalcularEvolucionGastoMensual(_compras, 12);
        _gastoMesAnterior = _evolucionGastoMensual.Count >= 2 ? _evolucionGastoMensual[^2].Valor : 0m;

        var comprasFiltradasProveedores = InformeService.FiltrarCompras(
            _compras, _rangoFiltroProveedores, _fechaDesdeFiltroProveedores, _fechaHastaFiltroProveedores, _proveedorIdFiltroProveedores).ToList();
        _gastoPorProveedor = InformeService.CalcularGastoPorProveedor(comprasFiltradasProveedores);
        _productosPorGastoTotal = InformeService.CalcularProductosPorGastoTotal(_compras);
        _gastoPorMetodoPago = InformeService.CalcularGastoPorMetodoPago(_compras);
        _gastoPorTipoProveedor = InformeService.CalcularGastoPorTipoProveedor(_compras, _proveedores);
        RecalcularPresupuestoVsReal();

        _variacionesPrecio = InformeService.CalcularVariacionesPrecio(_compras);
        _sobrecostePrecio = _variacionesPrecio.Where(v => v.ImpactoEuros > 0).Sum(v => v.ImpactoEuros);
        _ahorroPrecio = -_variacionesPrecio.Where(v => v.ImpactoEuros < 0).Sum(v => v.ImpactoEuros);

        // Solo las desviaciones reales (distintas de 0) y las 10 mayores: una lista de 49 filas a 0,00 € es ruido.
        _ppvPorProducto = InformeService.CalcularPpvPorProducto(_compras, _productos)
            .Where(p => p.Valor != 0)
            .Take(10)
            .ToList();

        _proveedoresSinCompraReciente = InformeService.CalcularProveedoresSinCompraReciente(_compras, _proveedores);
        _frecuenciaRepartoVsEsperado = InformeService.CalcularFrecuenciaRepartoVsEsperado(_compras, _proveedores);
        _recepcionesConExcedente = InformeService.CalcularRecepcionesConExcedente(_compras);
        _evolucionValorInventario = _snapshotsInventario.Select(s => new PuntoDato(s.Fecha.ToString("dd/MM/yy"), s.ValorTotal)).ToList();

        _cargando = false;
    }

    // ---- Resumen ----

    // "1 producto más caro" / "3 productos más caros".
    private static string Productos(int cantidad, string singular, string plural) =>
        cantidad == 1 ? $"1 producto {singular}" : $"{cantidad} productos {plural}";

    // Presupuesto: cuanto más consumido, peor. Verde por debajo del 80 %, ámbar hasta el 100 %, rojo por encima.
    private static string ClaseBarraPresupuesto(decimal consumido) =>
        consumido > 100 ? "kpi-barra--rojo" : consumido >= 80 ? "kpi-barra--ambar" : "kpi-barra--verde";

    private static Severity SeveridadDe(NivelAviso nivel) => nivel switch
    {
        NivelAviso.Alerta => Severity.Error,
        NivelAviso.Atencion => Severity.Warning,
        _ => Severity.Info
    };

    // ---- Gasto por proveedor (filtro) ----

    /// <summary>
    /// Cambia el rango a un chip preestablecido — descarta el rango libre que hubiera activo, son mutuamente
    /// excluyentes (ver EsRangoActivoFiltroProveedores, que solo marca un chip como seleccionado cuando no hay
    /// rango libre completo).
    /// </summary>
    private async Task CambiarRangoFiltroProveedoresAsync(RangoFechas rango)
    {
        _rangoFiltroProveedores = rango;
        _fechaDesdeFiltroProveedores = null;
        _fechaHastaFiltroProveedores = null;
        await RecalcularGastoPorProveedorAsync();
    }

    private async Task OnFiltroLibreProveedoresAsync() => await RecalcularGastoPorProveedorAsync();

    private bool EsRangoActivoFiltroProveedores(RangoFechas rango) =>
        _rangoFiltroProveedores == rango && !InformeService.HayRangoLibre(_fechaDesdeFiltroProveedores, _fechaHastaFiltroProveedores);

    private async Task RecalcularGastoPorProveedorAsync()
    {
        var comprasFiltradas = InformeService.FiltrarCompras(
            _compras, _rangoFiltroProveedores, _fechaDesdeFiltroProveedores, _fechaHastaFiltroProveedores, _proveedorIdFiltroProveedores).ToList();

        _gastoPorProveedor = InformeService.CalcularGastoPorProveedor(comprasFiltradas);

        // StateHasChanged() ANTES de UpdateSeriesAsync: sin él, la gráfica pedía sus datos actuales antes de que
        // Blazor propagara el nuevo _gastoPorProveedor al <ApexPointSeries> hijo y se quedaba con el filtro anterior.
        StateHasChanged();

        // Guarda defensiva: si ya no queda ningún dato el gráfico se desmonta (rama else del marcado), así que no
        // se llama a UpdateSeriesAsync sobre una instancia que va a morir.
        if (_gastoPorProveedor.Any() && _chartGastoProveedor is not null)
            await _chartGastoProveedor.UpdateSeriesAsync();
    }

    // ---- Evolución de precio por producto ----

    private Task<IEnumerable<Producto>> BuscarProductos(string valor, CancellationToken token)
    {
        var resultado = string.IsNullOrWhiteSpace(valor)
            ? _productos.AsEnumerable()
            : _productos.Where(p => p.Nombre.Contains(valor, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(resultado);
    }

    private async Task OnCambioProductoSeleccionadoAsync()
    {
        _evolucionPrecioProducto = InformeService.CalcularEvolucionPrecio(_compras, _productoSeleccionado?.Id);
        // Misma guarda defensiva: si no hay suficiente historial el gráfico no se monta (rama else del marcado).
        if (_evolucionPrecioProducto.Count >= 2 && _chartEvolucionPrecio is not null)
            await _chartEvolucionPrecio.UpdateSeriesAsync();
    }

    // ---- Presupuesto vs real ----

    private async Task RecalcularPresupuestoVsRealAsync()
    {
        RecalcularPresupuestoVsReal();
        // Si ya no queda ningún proveedor con presupuesto la gráfica se desmonta, así que no se llama a
        // UpdateSeriesAsync sobre una instancia que va a morir.
        if (_presupuestoVsRealChartReal.Any() && _chartPresupuestoVsReal is not null)
            await _chartPresupuestoVsReal.UpdateSeriesAsync();
    }

    private void RecalcularPresupuestoVsReal()
    {
        var resultado = InformeService.CalcularPresupuestoVsReal(
            _compras, _presupuestos, _mesPresupuestoVsReal, _anioPresupuestoVsReal);

        _presupuestoVsReal = resultado.Filas;
        _presupuestoVsRealChartPresupuesto = resultado.SeriePresupuesto;
        _presupuestoVsRealChartReal = resultado.SerieReal;
    }
}
