@page "/informes"
@using System.Globalization
@using System.Text.Json
@using ApexCharts
@inject CafeStock.Back.Services.Facturas.IFacturaService FacturaService
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject CafeStock.Back.Services.SnapshotsInventario.ISnapshotInventarioService SnapshotInventarioService
@inject CafeStock.Back.Services.Presupuestos.IPresupuestoService PresupuestoService

<PageTitle>Informes</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Informes</MudText>
</div>

@if (_cargando)
{
    <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true"/>
}
else
{
    @* 1. Gasto del mes actual *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Gasto del mes actual</MudText>
    <MudPaper Class="pa-6 mb-8" Elevation="2" Style="max-width:400px;">
        <MudText Typo="Typo.h3" Style="color:#3E2723; font-weight:700;">@_gastoMesActual.ToString("F2") €</MudText>
        @if (_variacionPct is decimal variacion)
        {
            <div class="d-flex align-center mt-2">
                <MudIcon Icon="@(variacion <= 0 ? Icons.Material.Filled.TrendingDown : Icons.Material.Filled.TrendingUp)"
                         Style="@($"color:{(variacion <= 0 ? "#3B6D11" : "#993C1D")};")"
                         Class="mr-1"/>
                <MudText Typo="Typo.body2" Style="@($"color:{(variacion <= 0 ? "#3B6D11" : "#993C1D")}; font-weight:600;")">
                    @(Math.Abs(variacion).ToString("F1"))% respecto al mes anterior
                </MudText>
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-2" Style="color:#9E9E9E;">Sin compras el mes anterior para comparar</MudText>
        }
    </MudPaper>

    @* 2. Gasto por proveedor *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Gasto por proveedor</MudText>
    <div class="d-flex gap-2 mb-3">
        <MudChip T="string" Color="@(_rangoGastoProveedor == RangoFechas.EsteMes ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                 Variant="@(_rangoGastoProveedor == RangoFechas.EsteMes ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => CambiarRangoGastoProveedorAsync(RangoFechas.EsteMes))">
            Este mes
        </MudChip>
        <MudChip T="string" Color="@(_rangoGastoProveedor == RangoFechas.Ultimos3Meses ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                 Variant="@(_rangoGastoProveedor == RangoFechas.Ultimos3Meses ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => CambiarRangoGastoProveedorAsync(RangoFechas.Ultimos3Meses))">
            Últimos 3 meses
        </MudChip>
        <MudChip T="string" Color="@(_rangoGastoProveedor == RangoFechas.Todo ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                 Variant="@(_rangoGastoProveedor == RangoFechas.Todo ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => CambiarRangoGastoProveedorAsync(RangoFechas.Todo))">
            Todo
        </MudChip>
    </div>
    @if (!_gastoPorProveedor.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">No hay compras registradas en este rango.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
            <ApexChart TItem="PuntoDato" @ref="_chartGastoProveedor" Title="Gasto por proveedor" Options="_opcionesBarrasGastoProveedor">
                <ApexPointSeries TItem="PuntoDato"
                                 Items="_gastoPorProveedor"
                                 Name="Gasto"
                                 SeriesType="SeriesType.Bar"
                                 XValue="e => e.Etiqueta"
                                 YValue="e => (decimal?)e.Valor"/>
            </ApexChart>
        </MudPaper>
    }

    @* 3. Evolución de precio por producto *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Evolución de precio por producto</MudText>
    <MudAutocomplete T="Producto" @bind-Value="_productoSeleccionado" @bind-Value:after="OnCambioProductoSeleccionadoAsync"
                      Label="Producto"
                      Placeholder="Escribe el nombre del producto..."
                      SearchFunc="BuscarProductos"
                      ToStringFunc="@(p => p?.Nombre)"
                      Clearable="true"
                      Variant="Variant.Outlined"
                      Style="max-width:300px;"
                      Class="mb-4"/>
    @if (_productoSeleccionado is null)
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">Elige un producto para ver la evolución de su precio.</MudAlert>
    }
    else if (_evolucionPrecioProducto.Count < 2)
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">No hay suficiente historial para este producto.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
            <ApexChart TItem="PuntoDato" @ref="_chartEvolucionPrecio" Title="Evolución de precio" Options="_opcionesLineaEvolucionPrecio">
                <ApexPointSeries TItem="PuntoDato"
                                 Items="_evolucionPrecioProducto"
                                 Name="Precio unitario"
                                 SeriesType="SeriesType.Line"
                                 XValue="e => e.Etiqueta"
                                 YValue="e => (decimal?)e.Valor"/>
            </ApexChart>
        </MudPaper>
    }

    @* 4. Productos con más peso en el gasto (por gasto TOTAL, no por cantidad) *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Productos con más peso en el gasto</MudText>
    @if (!_productosPorGastoTotal.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">No hay compras registradas todavía.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
            <ApexChart TItem="PuntoDato" Title="Productos con más peso en el gasto" Options="_opcionesBarrasProductosGasto">
                <ApexPointSeries TItem="PuntoDato"
                                 Items="_productosPorGastoTotal"
                                 Name="Gasto total"
                                 SeriesType="SeriesType.Bar"
                                 XValue="e => e.Etiqueta"
                                 YValue="e => (decimal?)e.Valor"/>
            </ApexChart>
        </MudPaper>
    }

    @* 5. Gasto por método de pago *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Gasto por método de pago</MudText>
    @if (!_gastoPorMetodoPago.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">No hay compras registradas todavía.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
            <ApexChart TItem="PuntoDato" Title="Gasto por método de pago" Options="_opcionesDonutMetodoPago">
                <ApexPointSeries TItem="PuntoDato"
                                 Items="_gastoPorMetodoPago"
                                 Name="Gasto"
                                 SeriesType="SeriesType.Donut"
                                 XValue="e => e.Etiqueta"
                                 YValue="e => (decimal?)e.Valor"/>
            </ApexChart>
        </MudPaper>
    }

    @* 6. Proveedores sin compra reciente (aviso, no gráfico) *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Proveedores sin compra reciente</MudText>
    @if (!_proveedoresSinCompraReciente.Any())
    {
        <MudAlert Severity="Severity.Success" Class="mb-8">Todos los proveedores con reparto asignado tienen compras recientes.</MudAlert>
    }
    else
    {
        <div class="mb-8">
            @foreach (var alerta in _proveedoresSinCompraReciente)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2" Style="max-width:600px;">
                    <b>@alerta.Nombre</b> — @(alerta.DiasDesdeUltimaCompra is int dias ? $"Última compra: hace {dias} días" : "Sin compras registradas")
                </MudAlert>
            }
        </div>
    }

    @* 7. PPV (Purchase Price Variance) por producto *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Desviación de precio de compra (PPV)</MudText>
    @if (!_ppvPorProducto.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">No hay productos con precio de referencia y compras registradas para comparar.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:600px;">
            <ApexChart TItem="PuntoDatoPpv" Title="PPV por producto (€)" Options="_opcionesBarrasPpv">
                <ApexPointSeries TItem="PuntoDatoPpv"
                                 Items="_ppvPorProducto"
                                 Name="PPV"
                                 SeriesType="SeriesType.Bar"
                                 XValue="e => e.Etiqueta"
                                 YValue="e => (decimal?)e.Valor"
                                 PointColor='e => e.Valor > 0 ? "#993C1D" : "#3B6D11"'/>
            </ApexChart>
        </MudPaper>
        <MudTable Items="_ppvPorProducto" Hover="true" Dense="true" Striped="true" Elevation="2" Class="mb-8" Style="max-width:600px;">
            <HeaderContent>
                <MudTh>Producto</MudTh>
                <MudTh>PPV</MudTh>
                <MudTh>% Desviación</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Producto">@context.Etiqueta</MudTd>
                <MudTd DataLabel="PPV">
                    <MudText Style="@($"color:{(context.Valor > 0 ? "#993C1D" : "#3B6D11")}; font-weight:600;")">
                        @context.Valor.ToString("F2") €
                    </MudText>
                </MudTd>
                <MudTd DataLabel="% Desviación">@context.PorcentajeDesviacion.ToString("F1") %</MudTd>
            </RowTemplate>
        </MudTable>
    }

    @* 8. Gasto en supermercado genérico vs proveedores habituales *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Gasto: supermercado genérico vs proveedores habituales</MudText>
    @if (!_gastoPorTipoProveedor.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">No hay compras con proveedor asignado todavía.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
            <ApexChart TItem="PuntoDato" Title="Gasto por tipo de proveedor" Options="_opcionesDonutTipoProveedor">
                <ApexPointSeries TItem="PuntoDato"
                                 Items="_gastoPorTipoProveedor"
                                 Name="Gasto"
                                 SeriesType="SeriesType.Donut"
                                 XValue="e => e.Etiqueta"
                                 YValue="e => (decimal?)e.Valor"/>
            </ApexChart>
        </MudPaper>
    }

    @* 9. Concentración de gasto por proveedor *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Concentración de gasto por proveedor (%)</MudText>
    @if (!_concentracionGastoPorProveedor.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">No hay compras registradas todavía.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
            <ApexChart TItem="PuntoDato" Title="Concentración de gasto por proveedor" Options="_opcionesBarrasConcentracion">
                <ApexPointSeries TItem="PuntoDato"
                                 Items="_concentracionGastoPorProveedor"
                                 Name="% del gasto total"
                                 SeriesType="SeriesType.Bar"
                                 XValue="e => e.Etiqueta"
                                 YValue="e => (decimal?)e.Valor"/>
            </ApexChart>
        </MudPaper>
    }

    @* 10. Ticket medio de compra por proveedor *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Ticket medio de compra por proveedor</MudText>
    @if (!_ticketMedioPorProveedor.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">No hay compras registradas todavía.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
            <ApexChart TItem="PuntoDato" Title="Ticket medio por proveedor (€)" Options="_opcionesBarrasTicketMedio">
                <ApexPointSeries TItem="PuntoDato"
                                 Items="_ticketMedioPorProveedor"
                                 Name="Ticket medio"
                                 SeriesType="SeriesType.Bar"
                                 XValue="e => e.Etiqueta"
                                 YValue="e => (decimal?)e.Valor"/>
            </ApexChart>
        </MudPaper>
    }

    @* 11. Frecuencia real de compra vs día de reparto esperado (tabla, no gráfica) *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Frecuencia de compra vs reparto esperado</MudText>
    @if (!_frecuenciaRepartoVsEsperado.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">Ningún proveedor tiene día de reparto definido.</MudAlert>
    }
    else
    {
        <MudTable Items="_frecuenciaRepartoVsEsperado" Hover="true" Dense="true" Striped="true" Elevation="2" Class="mb-8" Style="max-width:700px;">
            <HeaderContent>
                <MudTh>Proveedor</MudTh>
                <MudTh>Reparto esperado</MudTh>
                <MudTh>Compras (en día esperado / total)</MudTh>
                <MudTh>% Cumplimiento</MudTh>
                <MudTh>Indicador</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Proveedor">@context.Proveedor</MudTd>
                <MudTd DataLabel="Reparto esperado">@context.DiaRepartoEsperado</MudTd>
                <MudTd DataLabel="Compras">@context.ComprasEnDiaEsperado / @context.TotalCompras</MudTd>
                <MudTd DataLabel="% Cumplimiento">@(context.TotalCompras > 0 ? $"{context.PorcentajeCumplimiento:F0} %" : "—")</MudTd>
                <MudTd DataLabel="Indicador">
                    @if (context.TotalCompras == 0)
                    {
                        <MudText Style="color:#9E9E9E;">Sin compras registradas</MudText>
                    }
                    else if (context.Desviacion)
                    {
                        <MudChip T="string" Color="MudBlazor.Color.Error" Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.Warning">Desviación</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="MudBlazor.Color.Success" Size="MudBlazor.Size.Small" Icon="@Icons.Material.Filled.Check">Cumple</MudChip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @* 12. Presupuesto vs Real *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Presupuesto vs Real</MudText>
    <div class="d-flex gap-4 flex-wrap mb-4" style="align-items:flex-end;">
        <MudSelect T="int" @bind-Value="_mesPresupuestoVsReal" @bind-Value:after="RecalcularPresupuestoVsRealAsync" Label="Mes" Style="min-width:160px;">
            @for (var i = 1; i <= 12; i++)
            {
                var mes = i;
                <MudSelectItem Value="mes">@NombresMesesInformes[mes - 1]</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="int" @bind-Value="_anioPresupuestoVsReal" @bind-Value:after="RecalcularPresupuestoVsRealAsync" Label="Año" Min="2024" Style="max-width:120px;"/>
    </div>

    @if (!_presupuestoVsReal.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">No hay compras registradas en este mes.</MudAlert>
    }
    else
    {
        @if (_presupuestoVsRealChartReal.Any())
        {
            <MudPaper Class="pa-4 mb-4" Elevation="2" Style="max-width:600px;">
                <ApexChart TItem="PuntoDato" @ref="_chartPresupuestoVsReal" Title="Presupuesto vs Real (proveedores con presupuesto asignado)" Options="_opcionesBarrasPresupuestoVsReal">
                    <ApexPointSeries TItem="PuntoDato"
                                     Items="_presupuestoVsRealChartPresupuesto"
                                     Name="Presupuesto"
                                     SeriesType="SeriesType.Bar"
                                     XValue="e => e.Etiqueta"
                                     YValue="e => (decimal?)e.Valor"/>
                    <ApexPointSeries TItem="PuntoDato"
                                     Items="_presupuestoVsRealChartReal"
                                     Name="Real"
                                     SeriesType="SeriesType.Bar"
                                     XValue="e => e.Etiqueta"
                                     YValue="e => (decimal?)e.Valor"/>
                </ApexChart>
            </MudPaper>
        }

        <MudTable Items="_presupuestoVsReal" Hover="true" Dense="true" Striped="true" Elevation="2" Class="mb-8" Style="max-width:700px;">
            <HeaderContent>
                <MudTh>Proveedor</MudTh>
                <MudTh>Presupuesto</MudTh>
                <MudTh>Real</MudTh>
                <MudTh>% Desviación</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Proveedor">@context.Proveedor</MudTd>
                <MudTd DataLabel="Presupuesto">
                    @(context.SinPresupuesto ? "Sin presupuesto" : $"{context.Presupuesto!.Value.ToString("F2")} €")
                </MudTd>
                <MudTd DataLabel="Real">@context.Real.ToString("F2") €</MudTd>
                <MudTd DataLabel="% Desviación">
                    @if (context.PorcentajeDesviacion is decimal pct)
                    {
                        <MudText Style="@($"color:{(pct > 0 ? "#993C1D" : "#3B6D11")}; font-weight:600;")">
                            @pct.ToString("F1") %
                        </MudText>
                    }
                    else
                    {
                        <MudText Style="color:#9E9E9E;">—</MudText>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    @* 13. Evolución de valor de inventario *@
    <MudText Typo="Typo.h5" Class="mb-2" Style="color:#3E2723;">Evolución de valor de inventario</MudText>
    @if (!_snapshotsInventario.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-8">Todavía no hay ningún snapshot de inventario — el historial empieza a acumularse desde hoy.</MudAlert>
    }
    else
    {
        <MudPaper Class="pa-6 mb-4" Elevation="2" Style="max-width:400px;">
            <MudText Typo="Typo.h3" Style="color:#3E2723; font-weight:700;">
                Valor de inventario actual: @_snapshotsInventario[^1].ValorTotal.ToString("F2") €
            </MudText>
            <MudText Typo="Typo.body2" Class="mt-2" Style="color:#9E9E9E;">
                @_snapshotsInventario[^1].Fecha.ToString("dd/MM/yyyy")
            </MudText>
        </MudPaper>

        @if (_snapshotsInventario.Count < 2)
        {
            <MudAlert Severity="Severity.Info" Class="mb-8">Aún no hay suficiente historial para ver una evolución — vuelve en unos días.</MudAlert>
        }
        else
        {
            <MudPaper Class="pa-4 mb-8" Elevation="2" Style="max-width:600px;">
                <ApexChart TItem="PuntoDato" Title="Evolución de valor de inventario" Options="_opcionesLineaValorInventario">
                    <ApexPointSeries TItem="PuntoDato"
                                     Items="_evolucionValorInventario"
                                     Name="Valor de inventario"
                                     SeriesType="SeriesType.Line"
                                     XValue="e => e.Etiqueta"
                                     YValue="e => (decimal?)e.Valor"/>
                </ApexChart>
            </MudPaper>
        }
    }
}

@code {
    private const int UmbralDiasSinCompra = 14;

    private enum RangoFechas { EsteMes, Ultimos3Meses, Todo }

    private bool _cargando = true;
    private List<Compra> _compras = [];
    private List<Producto> _productos = [];
    private List<Proveedor> _proveedores = [];
    private List<Presupuesto> _presupuestos = [];

    // 1. Gasto del mes actual
    private decimal _gastoMesActual;
    private decimal? _variacionPct;

    // 2. Gasto por proveedor
    private RangoFechas _rangoGastoProveedor = RangoFechas.Todo;
    private List<PuntoDato> _gastoPorProveedor = [];
    private ApexChart<PuntoDato>? _chartGastoProveedor;

    // 3. Evolución de precio por producto
    private Producto? _productoSeleccionado;
    private List<PuntoDato> _evolucionPrecioProducto = [];
    private ApexChart<PuntoDato>? _chartEvolucionPrecio;

    // 4. Productos con más peso en el gasto
    private List<PuntoDato> _productosPorGastoTotal = [];

    // 5. Gasto por método de pago
    private List<PuntoDato> _gastoPorMetodoPago = [];

    // 6. Proveedores sin compra reciente
    private List<ProveedorAlerta> _proveedoresSinCompraReciente = [];

    // 7. PPV (Purchase Price Variance) por producto
    private List<PuntoDatoPpv> _ppvPorProducto = [];

    // 8. Gasto en supermercado genérico vs proveedores habituales
    private List<PuntoDato> _gastoPorTipoProveedor = [];

    // 9. Concentración de gasto por proveedor
    private List<PuntoDato> _concentracionGastoPorProveedor = [];

    // 10. Ticket medio de compra por proveedor
    private List<PuntoDato> _ticketMedioPorProveedor = [];

    // 11. Frecuencia real de compra vs día de reparto esperado
    private const decimal UmbralPorcentajeCumplimientoReparto = 50m;
    private List<InformeReparto> _frecuenciaRepartoVsEsperado = [];

    // 12. Presupuesto vs Real
    private static readonly string[] NombresMesesInformes =
    [
        "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
        "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
    ];
    private int _mesPresupuestoVsReal = DateTime.Now.Month;
    private int _anioPresupuestoVsReal = DateTime.Now.Year;
    private List<PresupuestoVsRealFila> _presupuestoVsReal = [];
    private List<PuntoDato> _presupuestoVsRealChartPresupuesto = [];
    private List<PuntoDato> _presupuestoVsRealChartReal = [];
    private ApexChart<PuntoDato>? _chartPresupuestoVsReal;

    // 13. Evolución de valor de inventario
    // Ordenada por Fecha ascendente: [^1] es el snapshot más reciente (tarjeta destacada) y el
    // orden natural de la lista es el que necesita la gráfica de línea (igual que
    // CalcularEvolucionPrecio hace .OrderBy(x => x.Fecha) para el informe 3).
    private List<SnapshotInventario> _snapshotsInventario = [];
    private List<PuntoDato> _evolucionValorInventario = [];

    // Formatters de ApexCharts (tooltip.y y yaxis.labels): ApexCharts los ejecuta en JS en el
    // navegador, así que no pueden reutilizar el ToString("F2")/("F1") de C# directamente —
    // se replica aquí la MISMA regla que ya usa la tabla de PPV (coma decimal, 2 decimales +
    // "€" para importes, 1 decimal + "%" para porcentajes), y un único formatter de cada tipo
    // compartido por todas las gráficas que lo necesitan, no uno distinto por gráfica.
    // Sin formatter, ApexCharts muestra el número JS en crudo sin redondear (comprobado: así
    // estaban las 4 gráficas de € ya existentes antes de este cambio, ninguna tenía formatter).
    private const string FormatterEuros =
        "function(val) { return (typeof val === 'number' ? val.toFixed(2).replace('.', ',') : val) + ' €'; }";

    private const string FormatterPorcentaje =
        "function(val) { return (typeof val === 'number' ? val.toFixed(1).replace('.', ',') : val) + ' %'; }";

    // Dos instancias separadas (no una compartida): dos ApexChart montados a la vez
    // reutilizando el mismo objeto Options daba un gráfico en blanco sin excepción alguna.
    private readonly ApexChartOptions<PuntoDato> _opcionesBarrasGastoProveedor = new()
    {
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true }
        },
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    private readonly ApexChartOptions<PuntoDato> _opcionesLineaEvolucionPrecio = new()
    {
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    private readonly ApexChartOptions<PuntoDato> _opcionesBarrasProductosGasto = new()
    {
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true }
        },
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    private readonly ApexChartOptions<PuntoDato> _opcionesDonutMetodoPago = new()
    {
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } }
        // Los donut no tienen eje Y — no aplica Yaxis.Labels.Formatter aquí.
    };

    private readonly ApexChartOptions<PuntoDatoPpv> _opcionesBarrasPpv = new()
    {
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true }
        },
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    private readonly ApexChartOptions<PuntoDato> _opcionesDonutTipoProveedor = new()
    {
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } }
    };

    // El Tooltip.Y.Formatter de esta gráfica es un caso especial (problema 2): no es uno de
    // los dos formatters genéricos de arriba porque necesita mostrar el € además del % —
    // se construye en OnInitializedAsync (ConstruirFormatterConcentracion), una vez que se
    // conoce _gastoPorProveedorEuros, y se asigna aquí abajo. El Yaxis sí usa el formatter de
    // porcentaje genérico, porque el eje solo muestra el %.
    private readonly ApexChartOptions<PuntoDato> _opcionesBarrasConcentracion = new()
    {
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true }
        },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterPorcentaje } }]
    };

