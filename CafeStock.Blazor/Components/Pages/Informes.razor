    {
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
    };

    // Mismo patrón que _opcionesLineaEvolucionPrecio (informe 3): línea, sin PlotOptions.Bar.
    private readonly ApexChartOptions<PuntoDato> _opcionesLineaValorInventario = new()
    {
        Tooltip = new Tooltip { Y = new TooltipY { Formatter = FormatterEuros } },
        Yaxis = [new YAxis { Labels = new YAxisLabels { Formatter = FormatterEuros } }]
