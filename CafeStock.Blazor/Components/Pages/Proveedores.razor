@page "/proveedores"
@inject IProveedorService ProveedorService
@inject IProductoService ProductoService
@inject NavigationManager Navigation

<PageTitle>Proveedores</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Proveedores</MudText>
</div>

<div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Href="/proveedores/nuevo"
               Class="mb-4">
        Añadir proveedor
    </MudButton>
</div>

<div class="d-flex justify-center mb-4">
    <MudPaper Elevation="3" Style="border-radius:9999px; max-width:400px; width:100%; padding:2px 20px;">
        <MudTextField T="string"
                      @bind-Value="_busqueda"
                      Immediate="true"
                      Placeholder="Buscar por producto..."
                      Variant="Variant.Text"
                      Underline="false"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"/>
    </MudPaper>
</div>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_proveedoresFiltrados.Any())
{
    <MudAlert Severity="Severity.Info">No hay proveedores que coincidan con esta búsqueda.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var proveedor in _proveedoresFiltrados)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2"
                         Style="height:100%; cursor:pointer;"
                         @onclick="@(() => Navigation.NavigateTo($"/proveedores/{proveedor.Id}"))">
                    @if (!string.IsNullOrWhiteSpace(proveedor.ImagenUrl))
                    {
                        <div style="height:160px; overflow:hidden; background-color:#F5F0EB;">
                            <img src="@proveedor.ImagenUrl" alt="@proveedor.Nombre"
                                 style="width:100%; height:100%; object-fit:contain; object-position:center; display:block;"/>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-center justify-center"
                             style="height:160px; background-color:#F5F0EB;">
                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size:3rem; color:#6D4C41;"/>
                        </div>
                    }
                    <MudCardContent Style="padding:0;">
                        <div style="background-color:rgba(109,76,65,0.22); text-align:center; padding:8px 12px;">
                            <MudText Typo="Typo.h6" Style="color:#3E2723;">
                                @proveedor.Nombre
                            </MudText>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private IEnumerable<Proveedor> _proveedores = [];
    private IEnumerable<Producto> _productos = [];
    private bool _cargando = true;
    private string _busqueda = string.Empty;

    private IEnumerable<Proveedor> _proveedoresFiltrados =>
        _proveedores.Where(p =>
            string.IsNullOrWhiteSpace(_busqueda) ||
            _productos.Any(prod => prod.ProveedorId == p.Id && prod.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await ProveedorService.GetAllAsync();
        _productos = await ProductoService.GetAllAsync();
        _cargando = false;
    }
}
