@page "/facturas/{Id:int}"
@inject CafeStock.Back.Services.Facturas.IFacturaService FacturaService
@inject CafeStock.Back.Services.Compras.ICompraService CompraService
@inject IProveedorService ProveedorService
@inject ISnackbar Snackbar

<PageTitle>Factura</PageTitle>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (_factura is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se ha encontrado esta factura.</MudAlert>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/facturas">
        Volver al listado
    </MudButton>
}
else
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/facturas"
               Class="mb-4">
        Volver al listado
    </MudButton>

    <div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:8px 16px; width:fit-content;">
        <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">
            @(_factura.ProveedorNombre ?? "Sin proveedor asignado")
        </MudText>
    </div>

    <div class="mb-4">
        @if (!string.IsNullOrWhiteSpace(_proveedor?.ImagenUrl))
        {
            <div style="width:160px; height:160px; border-radius:8px; overflow:hidden; background-color:#F5F0EB;">
                <img src="@_proveedor.ImagenUrl" alt="@_proveedor.Nombre"
                     style="width:100%; height:100%; object-fit:contain; object-position:center; display:block;"/>
            </div>
        }
        else
        {
            <div class="d-flex align-center justify-center"
                 style="width:160px; height:160px; background-color:#F5F0EB; border-radius:8px;">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size:4rem; color:#6D4C41;"/>
            </div>
        }
    </div>

    <MudPaper Class="pa-4 mb-4" Elevation="1" Style="max-width:400px;">
        @if (!string.IsNullOrWhiteSpace(_proveedor?.Telefono))
        {
            <div class="d-flex align-center mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                <MudText Typo="Typo.body1">@_proveedor.Telefono</MudText>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_proveedor?.Email))
        {
            <div class="d-flex align-center mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
                <MudText Typo="Typo.body1">@_proveedor.Email</MudText>
            </div>
        }
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-2" Style="color:#6D4C41;"/>
            <MudText Typo="Typo.body1">@_factura.Fecha.ToString("dd/MM/yyyy HH:mm")</MudText>
        </div>
    </MudPaper>

    <MudTable Items="_factura.Lineas" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh Style="background-color:#6D4C41; color:#FFFFFF;">Producto</MudTh>
            <MudTh Style="background-color:#6D4C41; color:#FFFFFF;">Cantidad</MudTh>
            <MudTh Style="background-color:#6D4C41; color:#FFFFFF;">Precio unitario</MudTh>
            <MudTh Style="background-color:#6D4C41; color:#FFFFFF;">Subtotal</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Producto">@(context.ProductoNombre ?? $"Producto #{context.ProductoId}")</MudTd>
            <MudTd DataLabel="Cantidad">@context.Cantidad</MudTd>
            <MudTd DataLabel="Precio unitario">
                @if (_editandoLineaId == context.Id)
                {
                    <div class="d-flex align-center" style="gap:4px;">
                        <MudNumericField T="decimal" @bind-Value="_precioEnEdicion"
                                          Min="0" Format="F2" Variant="Variant.Outlined"
                                          Style="max-width:110px;"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small"
                                       OnClick="@(() => GuardarPrecioLineaAsync(context))"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       OnClick="@(() => _editandoLineaId = null)"/>
                    </div>
                }
                else
                {
                    <div class="d-flex align-center" style="gap:4px;">
                        <span>@context.PrecioUnitario.ToString("F2") €</span>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       title="Editar precio"
                                       OnClick="@(() => EmpezarEdicionPrecio(context))"/>
                    </div>
                }
            </MudTd>
            <MudTd DataLabel="Subtotal">@((context.Cantidad * context.PrecioUnitario).ToString("F2")) €</MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTd colspan="3" Style="text-align:right; font-weight:700;">Total</MudTd>
            <MudTd Style="font-weight:700; color:#993C1D;">@_total.ToString("F2") €</MudTd>
        </FooterContent>
    </MudTable>

    <MudPaper Class="pa-4 mt-6" Elevation="1" Style="max-width:600px;">
        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:#6D4C41; text-transform:uppercase; letter-spacing:0.5px; font-weight:600;">
            Notas
        </MudText>

        <MudTextField @bind-Value="_notas"
                      Variant="Variant.Outlined"
                      Lines="3"
                      Class="mb-4"/>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="GuardarNotasAsync">
            Guardar
        </MudButton>
    </MudPaper>
}

@code {
    [Parameter] public int Id { get; set; }

    private Compra? _factura;
    private Proveedor? _proveedor;
    private bool _cargando = true;

    // string? porque el TextField puede dejarlo a null; se normaliza a "" al guardar.
    private string? _notas = string.Empty;

    // Id de la LineaCompra en edición inline (null = ninguna fila en modo edición) y buffer
    // del precio mientras se edita, igual de patrón que ListaCompra.razor con las cantidades.
    private int? _editandoLineaId;
    private decimal _precioEnEdicion;

    private decimal _total => _factura?.Lineas.Sum(l => l.Cantidad * l.PrecioUnitario) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var facturas = await FacturaService.GetAllAsync();
        _factura = facturas.FirstOrDefault(f => f.Id == Id);
        if (_factura is not null)
        {
            _notas = _factura.Notas;

            if (_factura.ProveedorId is int proveedorId)
            {
                var resultadoProveedor = await ProveedorService.GetByIdAsync(proveedorId);
                if (resultadoProveedor.IsSuccess)
                    _proveedor = resultadoProveedor.Value;
            }
        }
        _cargando = false;
    }

    private async Task GuardarNotasAsync()
    {
        if (_factura is null) return;

        var notas = _notas ?? string.Empty;
        var resultado = await CompraService.ActualizarNotasAsync(_factura.Id, notas);

        if (resultado.IsSuccess)
        {
            _factura = _factura with { Notas = notas };
            Snackbar.Add("Notas guardadas", Severity.Success);
        }
        else
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
        }
    }

    private void EmpezarEdicionPrecio(LineaCompra linea)
    {
        _editandoLineaId = linea.Id;
        _precioEnEdicion = linea.PrecioUnitario;
    }

    /// <summary>
    /// Corrige el precio real de una línea ya guardada. El servicio ya decide si además hay
    /// que sincronizar Producto.PrecioUnitario (solo si esta es la compra más reciente con
    /// ese producto) — aquí solo se refleja el nuevo precio de la línea en la vista.
    /// </summary>
    private async Task GuardarPrecioLineaAsync(LineaCompra linea)
    {
        if (_factura is null) return;

        if (_precioEnEdicion <= 0)
        {
            Snackbar.Add("El precio unitario debe ser mayor que 0", Severity.Warning);
            return;
        }

        var resultado = await CompraService.ActualizarPrecioLineaAsync(linea.Id, _precioEnEdicion);
        if (resultado.IsSuccess)
        {
            var lineasActualizadas = _factura.Lineas
                .Select(l => l.Id == linea.Id ? l with { PrecioUnitario = _precioEnEdicion } : l)
                .ToList();
            _factura = _factura with { Lineas = lineasActualizadas };
            _editandoLineaId = null;
            Snackbar.Add("Precio corregido", Severity.Success);
        }
        else
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
        }
    }
}
