@page "/facturas/{Id:int}"
@inject CafeStock.Back.Services.Facturas.IFacturaService FacturaService
@inject CafeStock.Back.Services.Compras.ICompraService CompraService
@inject ISnackbar Snackbar

<PageTitle>Factura</PageTitle>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (_factura is null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">No se ha encontrado esta factura.</MudAlert>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/facturas">
        Volver al listado
    </MudButton>
}
else
{
    <MudButton Variant="Variant.Text"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/facturas"
               Class="mb-4">
        Volver al listado
    </MudButton>

    <div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
        <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">
            @(_factura.ProveedorNombre ?? "Sin proveedor asignado")
        </MudText>
    </div>

    <MudPaper Class="pa-4 mb-4" Elevation="1" Style="max-width:300px;">
        <div class="d-flex align-center mb-2">
            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Class="mr-2"/>
            <MudText Typo="Typo.body1">Fecha: <b>@_factura.Fecha.ToString("dd/MM/yyyy HH:mm")</b></MudText>
        </div>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Euro" Class="mr-2"/>
            <MudText Typo="Typo.body1">Total: <b>@_total.ToString("F2") €</b></MudText>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1" Style="max-width:400px;">
        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color:#6D4C41; text-transform:uppercase; letter-spacing:0.5px; font-weight:600;">
            Datos de factura
        </MudText>

        <MudSelect T="string" @bind-Value="_metodoPago"
                   Label="Método de pago"
                   Variant="Variant.Outlined"
                   Clearable="true"
                   Class="mb-4">
            <MudSelectItem T="string" Value="@("Efectivo")">Efectivo</MudSelectItem>
            <MudSelectItem T="string" Value="@("Transferencia")">Transferencia</MudSelectItem>
            <MudSelectItem T="string" Value="@("Domiciliado")">Domiciliado</MudSelectItem>
        </MudSelect>

        <MudTextField @bind-Value="_numeroFacturaProveedor"
                      Label="Número de factura del proveedor"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        <MudTextField @bind-Value="_facturaAdjuntaUrl"
                      Label="Factura adjunta (ruta relativa, p.ej. /facturas/nombre.pdf)"
                      Variant="Variant.Outlined"
                      Class="mb-4"/>

        @if (!string.IsNullOrWhiteSpace(_factura.FacturaAdjuntaUrl))
        {
            <MudLink Href="@_factura.FacturaAdjuntaUrl" Target="_blank" Class="mb-4 d-block">
                Ver factura adjunta
            </MudLink>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="GuardarDatosFacturaAsync">
            Guardar
        </MudButton>
    </MudPaper>

    <MudTable Items="_factura.Lineas" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh>Producto</MudTh>
            <MudTh>Cantidad</MudTh>
            <MudTh>Precio unitario</MudTh>
            <MudTh>Subtotal</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Producto">@(context.ProductoNombre ?? $"Producto #{context.ProductoId}")</MudTd>
            <MudTd DataLabel="Cantidad">@context.Cantidad</MudTd>
            <MudTd DataLabel="Precio unitario">@context.PrecioUnitario.ToString("F2") €</MudTd>
            <MudTd DataLabel="Subtotal">@((context.Cantidad * context.PrecioUnitario).ToString("F2")) €</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter] public int Id { get; set; }

    private Compra? _factura;
    private bool _cargando = true;

    // string? porque MudSelect Clearable puede dejarlos a null; se normalizan a "" al guardar.
    private string? _metodoPago = string.Empty;
    private string? _numeroFacturaProveedor = string.Empty;
    private string? _facturaAdjuntaUrl = string.Empty;

    private decimal _total => _factura?.Lineas.Sum(l => l.Cantidad * l.PrecioUnitario) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var facturas = await FacturaService.GetAllAsync();
        _factura = facturas.FirstOrDefault(f => f.Id == Id);
        if (_factura is not null)
        {
            _metodoPago = _factura.MetodoPago;
            _numeroFacturaProveedor = _factura.NumeroFacturaProveedor;
            _facturaAdjuntaUrl = _factura.FacturaAdjuntaUrl;
        }
        _cargando = false;
    }

    private async Task GuardarDatosFacturaAsync()
    {
        if (_factura is null) return;

        var metodoPago = _metodoPago ?? string.Empty;
        var numeroFacturaProveedor = _numeroFacturaProveedor ?? string.Empty;
        var facturaAdjuntaUrl = _facturaAdjuntaUrl ?? string.Empty;

        var resultado = await CompraService.ActualizarDatosFacturaAsync(
            _factura.Id, metodoPago, numeroFacturaProveedor, facturaAdjuntaUrl);

        if (resultado.IsSuccess)
        {
            _factura = _factura with
            {
                MetodoPago = metodoPago,
                NumeroFacturaProveedor = numeroFacturaProveedor,
                FacturaAdjuntaUrl = facturaAdjuntaUrl
            };
            Snackbar.Add("Datos de factura guardados", Severity.Success);
        }
        else
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
        }
    }
}
