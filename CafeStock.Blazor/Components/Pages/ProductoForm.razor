@page "/productos/nuevo"
@page "/productos/editar/{Id:int}"
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@(_esNuevo ? "Nuevo producto" : "Editar producto")</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">
        @(_esNuevo ? "Nuevo producto" : "Editar producto")
    </MudText>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudPaper Class="pa-6" Elevation="2" Style="max-width:500px;">
    <MudTextField @bind-Value="_nombre"
                  Label="Nombre"
                  Variant="Variant.Outlined"
                  Class="mb-4"/>

    <MudNumericField @bind-Value="_stockActual"
                     Label="Stock actual"
                     Variant="Variant.Outlined"
                     Min="0"
                     Class="mb-4"/>

    <MudNumericField @bind-Value="_stockMaximo"
                     Label="Stock máximo"
                     Variant="Variant.Outlined"
                     Min="0"
                     Class="mb-4"/>

    <MudNumericField @bind-Value="_precioUnitario"
                     Label="Precio unitario"
                     Variant="Variant.Outlined"
                     Min="0"
                     Format="F2"
                     Adornment="Adornment.End"
                     AdornmentText="€"
                     Class="mb-4"/>

    <MudSelect @bind-Value="_unidad"
               Label="Unidad"
               Variant="Variant.Outlined"
               Class="mb-4">
        @foreach (var unidad in Enum.GetValues<UnidadMedida>())
        {
            <MudSelectItem Value="@unidad">@FormatearUnidad(unidad)</MudSelectItem>
        }
    </MudSelect>

    <MudTextField @bind-Value="_descripcion"
                  Label="Descripción"
                  Variant="Variant.Outlined"
                  Lines="3"
                  Class="mb-4"/>

    <MudTextField @bind-Value="_imagenUrl"
                  Label="Imagen (ruta relativa, p.ej. /images/nombre.jpg)"
                  Variant="Variant.Outlined"
                  Class="mb-4"/>

    @if (_cargandoProveedores)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" Class="mb-4"/>
    }
    else if (!_proveedores.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            No hay proveedores todavía — créalos primero en la pestaña Proveedores.
        </MudAlert>
    }
    else
    {
        <MudSelect T="int?" @bind-Value="_proveedorId"
                   Label="Proveedor"
                   Variant="Variant.Outlined"
                   Clearable="true"
                   Class="mb-4">
            @foreach (var proveedor in _proveedores)
            {
                <MudSelectItem T="int?" Value="@proveedor.Id">@proveedor.Nombre</MudSelectItem>
            }
        </MudSelect>
    }

    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="GuardarAsync">
            Guardar
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Href="/productos">
            Cancelar
        </MudButton>
        @if (!_esNuevo)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="ConfirmarEliminarAsync">
                Eliminar producto
            </MudButton>
        }
    </div>
</MudPaper>

@code {
    [Parameter] public int? Id { get; set; }

    private string _nombre = string.Empty;
    private int _stockActual;
    private int _stockMaximo;
    private decimal _precioUnitario;
    private UnidadMedida _unidad = UnidadMedida.SinEspecificar;
    private string _descripcion = string.Empty;
    private string _imagenUrl = string.Empty;
    private int? _proveedorId;
    private IEnumerable<Proveedor> _proveedores = [];
    private bool _cargandoProveedores = true;
    private string? _error;
    private bool _esNuevo => Id is null;

    private static string FormatearUnidad(UnidadMedida unidad) =>
        unidad == UnidadMedida.SinEspecificar ? "— Sin especificar —" : unidad.ToString();

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await ProveedorService.GetAllAsync();
        _cargandoProveedores = false;

        if (!_esNuevo)
        {
            var resultado = await ProductoService.GetByIdAsync(Id!.Value);
            if (resultado.IsSuccess)
            {
                _nombre = resultado.Value.Nombre;
                _stockActual = resultado.Value.StockActual;
                _stockMaximo = resultado.Value.StockMaximo;
                _precioUnitario = resultado.Value.PrecioUnitario;
                _unidad = resultado.Value.Unidad;
                _descripcion = resultado.Value.Descripcion;
                _imagenUrl = resultado.Value.ImagenUrl;
                _proveedorId = resultado.Value.ProveedorId;
            }
            else
            {
                _error = resultado.Error.Message;
            }
        }
    }

    private async Task GuardarAsync()
    {
        var producto = new Producto
        {
            Id = Id ?? 0,
            Nombre = _nombre,
            StockActual = _stockActual,
            StockMaximo = _stockMaximo,
            PrecioUnitario = _precioUnitario,
            Unidad = _unidad,
            Descripcion = _descripcion,
            ImagenUrl = _imagenUrl,
            ProveedorId = _proveedorId
        };

        var resultado = _esNuevo
            ? await ProductoService.CreateAsync(producto)
            : await ProductoService.UpdateAsync(Id!.Value, producto);

        if (resultado.IsSuccess)
            Navigation.NavigateTo("/productos");
        else
        {
            _error = resultado.Error.Message;
            StateHasChanged();
        }
    }

    private async Task ConfirmarEliminarAsync()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"¿Seguro que quieres eliminar '{_nombre}'? Esta acción no se puede deshacer." },
            { x => x.ConfirmText, "Eliminar" },
            { x => x.CancelText, "Cancelar" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Eliminar producto", parameters);
        var resultado = await dialog.Result;

        if (resultado is not null && !resultado.Canceled)
            await EliminarAsync();
    }

    private async Task EliminarAsync()
    {
        var resultado = await ProductoService.DeleteAsync(Id!.Value);
        if (resultado.IsSuccess)
        {
            Snackbar.Add($"Producto '{_nombre}' eliminado correctamente", Severity.Success);
            Navigation.NavigateTo("/productos");
        }
        else
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
        }
    }
}
