@page "/vender"
@page "/cafe"
@attribute [Authorize(Policy = Politicas.Trabajador)]
@inject IHojaCafeService HojaCafeService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Venta</PageTitle>

<div class="mb-4 vender-cabecera">
    <div style="background-color:rgba(var(--rgb-borde),0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
        <MudText Typo="Typo.h4" Style="color:var(--color-dark); margin:0;">Venta</MudText>
        @if (_actual is not null)
        {
            <MudText Typo="Typo.body2" Style="color:var(--text-muted); margin:0;">
                Hoja @_actual.Id · desde el @_actual.FechaApertura.ToString("dd/MM/yyyy")
            </MudText>
        }
    </div>

    <div class="vender-acciones">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Inventory"
                   Disabled="_recepcionando" OnClick="RecepcionarAsync">
            Recepcionar café
        </MudButton>
        @* Un café que aún no existe (p. ej. el especial de esta semana): formulario propio, no el de producto. Alta solo para encargados. *@
        <AuthorizeView Policy="@Politicas.Encargado">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/cafes/nuevo">
                Añadir nuevo café
            </MudButton>
        </AuthorizeView>
    </div>
</div>

@* Venta es la hoja de café vigente: un recuadro por cada paquete, en tres columnas como la hoja a mano (casa,
   especial, descafeinado). Se vende tocando un recuadro. Al llegar el pedido se recepciona: la hoja se cierra y
   pasa al historial, y se abre la siguiente con el café nuevo y los sobrantes. /cafe sigue como enlace antiguo. *@
<MapaCafe @key="_version" OnCambio="CargarAsync"/>

<MudExpansionPanels Class="mt-6" MultiExpansion="true">
    <MudExpansionPanel Text="Historial">
        @if (_cerradas.Count == 0)
        {
            <MudText Typo="Typo.body2" Style="color:var(--text-muted); font-style:italic;">
                Todavía no hay hojas cerradas. La hoja actual pasa aquí cuando recepciones el siguiente pedido.
            </MudText>
        }
        else
        {
            <MudTable Items="_cerradas" Hover="true" Dense="true" Striped="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Hoja</MudTh>
                    <MudTh>Abierta</MudTh>
                    <MudTh>Cerrada</MudTh>
                    <MudTh>Paquetes</MudTh>
                    <MudTh>Usados</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Hoja">Hoja @context.Hoja.Id</MudTd>
                    <MudTd DataLabel="Abierta">@context.Hoja.FechaApertura.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Cerrada">@(context.Hoja.FechaCierre?.ToString("dd/MM/yyyy") ?? "—")</MudTd>
                    <MudTd DataLabel="Paquetes">@context.Paquetes</MudTd>
                    <MudTd DataLabel="Usados">@context.Usados</MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="@($"/cafe/hoja/{context.Hoja.Id}")">Ver hoja</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    private HojaCafe? _actual;
    private List<ResumenHojaCafe> _cerradas = [];
    private int _version;
    private bool _recepcionando;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        _actual = await HojaCafeService.GetActualAsync();
        _cerradas = (await HojaCafeService.GetResumenesAsync()).Where(r => !r.Hoja.Abierta).ToList();
    }

    private async Task RecepcionarAsync()
    {
        var dialogo = await DialogService.ShowAsync<RecepcionCafeDialog>("Recepcionar café",
            new DialogParameters(), new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        var resultado = await dialogo.Result;
        if (resultado is not { Canceled: false, Data: List<NuevoPaqueteCafe> paquetes } || paquetes.Count == 0)
            return;

        var estado = EstadoAutenticacion is null ? null : await EstadoAutenticacion;
        var quien = estado?.User.Identity?.Name ?? string.Empty;

        _recepcionando = true;
        try
        {
            var recepcion = await HojaCafeService.RecepcionarAsync(paquetes, quien);
            if (recepcion.IsFailure)
            {
                Snackbar.Add(recepcion.Error.Message, Severity.Error);
                return;
            }

            Snackbar.Add($"Café recepcionado: {paquetes.Count} {(paquetes.Count == 1 ? "paquete" : "paquetes")} en la hoja {recepcion.Value.Id}", Severity.Success);
            await CargarAsync();
            _version++; // vuelve a pintar el mapa con la hoja nueva
        }
        finally
        {
            _recepcionando = false;
        }
    }
}
