@page "/proveedores/nuevo"
@page "/proveedores/editar/{Id:int}"
@inject IProveedorService ProveedorService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@(_esNuevo ? "Nuevo proveedor" : "Editar proveedor")</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">
        @(_esNuevo ? "Nuevo proveedor" : "Editar proveedor")
    </MudText>
</div>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudPaper Class="pa-6" Elevation="2" Style="max-width:500px;">
    <MudTextField @bind-Value="_nombre"
                  Label="Nombre"
                  Variant="Variant.Outlined"
                  Class="mb-4"/>

    <MudTextField @bind-Value="_imagenUrl"
                  Label="Imagen (ruta relativa, p.ej. /images/nombre.jpg)"
                  Variant="Variant.Outlined"
                  Class="mb-4"/>

    <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2" Style="color:#6D4C41; text-transform:uppercase; letter-spacing:0.5px; font-weight:600;">
        Contacto
    </MudText>

    <MudTextField @bind-Value="_telefono"
                  Label="Teléfono"
                  Variant="Variant.Outlined"
                  Class="mb-4"/>

    <MudTextField @bind-Value="_personaContacto"
                  Label="Persona de contacto"
                  Variant="Variant.Outlined"
                  Class="mb-4"/>

    <MudTextField @bind-Value="_email"
                  Label="Email"
                  Variant="Variant.Outlined"
                  Class="mb-4"/>

    <MudTextField @bind-Value="_diaReparto"
                  Label="Día de reparto"
                  Placeholder="p.ej. Martes y viernes"
                  Variant="Variant.Outlined"
                  Class="mb-4"/>

    <MudTextField @bind-Value="_notas"
                  Label="Notas"
                  Variant="Variant.Outlined"
                  Lines="3"
                  Class="mb-4"/>

    <MudCheckBox @bind-Value="_esSupermercadoGenerico"
                 Label="Es supermercado genérico (compra suelta, no proveedor con acuerdo)"
                 Color="Color.Primary"
                 Class="mb-4"/>

    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="GuardarAsync">
            Guardar
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   Href="/proveedores">
            Cancelar
        </MudButton>
        @if (!_esNuevo)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="ConfirmarEliminarAsync">
                Eliminar proveedor
            </MudButton>
        }
    </div>
</MudPaper>

@code {
    [Parameter] public int? Id { get; set; }

    private string _nombre = string.Empty;
    private string _imagenUrl = string.Empty;
    private string _telefono = string.Empty;
    private string _personaContacto = string.Empty;
    private string _email = string.Empty;
    private string _diaReparto = string.Empty;
    private string _notas = string.Empty;
    private bool _esSupermercadoGenerico;
    private string? _error;
    private bool _esNuevo => Id is null;

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo)
        {
            var resultado = await ProveedorService.GetByIdAsync(Id!.Value);
            if (resultado.IsSuccess)
            {
                _nombre = resultado.Value.Nombre;
                _imagenUrl = resultado.Value.ImagenUrl;
                _telefono = resultado.Value.Telefono;
                _personaContacto = resultado.Value.PersonaContacto;
                _email = resultado.Value.Email;
                _diaReparto = resultado.Value.DiaReparto;
                _notas = resultado.Value.Notas;
                _esSupermercadoGenerico = resultado.Value.EsSupermercadoGenerico;
            }
            else
            {
                _error = resultado.Error.Message;
            }
        }
    }

    private async Task GuardarAsync()
    {
        var proveedor = new Proveedor
        {
            Id = Id ?? 0,
            Nombre = _nombre,
            ImagenUrl = _imagenUrl,
            Telefono = _telefono,
            PersonaContacto = _personaContacto,
            Email = _email,
            DiaReparto = _diaReparto,
            Notas = _notas,
            EsSupermercadoGenerico = _esSupermercadoGenerico
        };

        var resultado = _esNuevo
            ? await ProveedorService.CreateAsync(proveedor)
            : await ProveedorService.UpdateAsync(Id!.Value, proveedor);

        if (resultado.IsSuccess)
            Navigation.NavigateTo("/proveedores");
        else
        {
            _error = resultado.Error.Message;
            StateHasChanged();
        }
    }

    private async Task ConfirmarEliminarAsync()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"¿Seguro que quieres eliminar '{_nombre}'? Esta acción no se puede deshacer." },
            { x => x.ConfirmText, "Eliminar" },
            { x => x.CancelText, "Cancelar" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Eliminar proveedor", parameters);
        var resultado = await dialog.Result;

        if (resultado is not null && !resultado.Canceled)
            await EliminarAsync();
    }

    private async Task EliminarAsync()
    {
        var resultado = await ProveedorService.DeleteAsync(Id!.Value);
        if (resultado.IsSuccess)
        {
            Snackbar.Add($"Proveedor '{_nombre}' eliminado correctamente", Severity.Success);
            Navigation.NavigateTo("/proveedores");
        }
        else
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
        }
    }
}
