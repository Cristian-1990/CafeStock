@page "/productos"
@using System.Text
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject CafeStock.Blazor.Services.PdfService PdfService
@inject CafeStock.Blazor.Services.EmailService EmailService

<PageTitle>Stock</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Stock</MudText>
</div>

<div class="d-flex gap-2 mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Href="/productos/nuevo">
        Añadir producto
    </MudButton>
    @if (_productosParaComprar.Any())
    {
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Email"
                   OnClick="EnviarPorEmail"
                   Disabled="_enviandoEmail">
            @(_enviandoEmail ? "Enviando..." : "Enviar por email")
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Storefront"
                   OnClick="GenerarPedido"
                   Disabled="_generandoPedido">
            @(_generandoPedido ? "Generando..." : "Generar pedido")
        </MudButton>
    }
</div>

<div class="d-flex justify-center mb-4">
    <MudPaper Elevation="3" Style="border-radius:9999px; max-width:400px; width:100%; padding:2px 20px;">
        <MudTextField T="string"
                      @bind-Value="_busqueda"
                      Immediate="true"
                      Placeholder="Buscar producto..."
                      Variant="Variant.Text"
                      Underline="false"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"/>
    </MudPaper>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <MudChip T="string" Color="@(_proveedorSeleccionado is null ? Color.Primary : Color.Default)"
             Variant="@(_proveedorSeleccionado is null ? Variant.Filled : Variant.Outlined)"
             OnClick="@(() => _proveedorSeleccionado = null)">
        Todos
    </MudChip>
    @foreach (var proveedor in _proveedores)
    {
        <MudChip T="string" Color="@(_proveedorSeleccionado == proveedor.Id ? Color.Primary : Color.Default)"
                 Variant="@(_proveedorSeleccionado == proveedor.Id ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => _proveedorSeleccionado = proveedor.Id)">
            @proveedor.Nombre
        </MudChip>
    }
</div>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_productosFiltrados.Any())
{
    <MudAlert Severity="Severity.Info">No hay productos que coincidan con estos filtros.</MudAlert>
}
else
{
    <MudTable Items="_productosFiltrados" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Stock actual</MudTh>
            <MudTh>Stock máximo</MudTh>
            <MudTh>Cantidad a comprar</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Stock actual">@context.StockActual</MudTd>
            <MudTd DataLabel="Stock máximo">@context.StockMaximo</MudTd>
            <MudTd DataLabel="Cantidad a comprar">
                <MudText Style="@($"color:{(context.CantidadAComprar > 0 ? "#993C1D" : "#3B6D11")}; font-weight:500;")">
                    @context.CantidadAComprar
                </MudText>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Href="@($"/productos/editar/{context.Id}")"
                           Class="mr-2">
                    Editar
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="() => ConfirmarEliminarAsync(context.Id, context.Nombre)">
                    Eliminar
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IEnumerable<Producto> _productos = [];
    private IEnumerable<Proveedor> _proveedores = [];
    private IEnumerable<Producto> _productosParaComprar = [];
    private bool _cargando = true;
    private bool _enviandoEmail;
    private bool _generandoPedido;
    private string _busqueda = string.Empty;
    private int? _proveedorSeleccionado;

    private IEnumerable<Producto> _productosFiltrados =>
        _productos
            .Where(p => string.IsNullOrWhiteSpace(_busqueda) || p.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
            .Where(p => _proveedorSeleccionado is null || p.ProveedorId == _proveedorSeleccionado);

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await ProveedorService.GetAllAsync();
        _productos = await ProductoService.GetAllAsync();
        _productosParaComprar = await ProductoService.GetProductosBajoMinimoAsync();
        _cargando = false;
    }

    private async Task EnviarPorEmail()
    {
        _enviandoEmail = true;
        try
        {
            var pdf = PdfService.GenerarListaCompra(_productosParaComprar);
            await EmailService.EnviarListaCompraAsync(pdf);
            Snackbar.Add("Lista de la compra enviada por email", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _enviandoEmail = false;
        }
    }

    private async Task GenerarPedido()
    {
        _generandoPedido = true;
        try
        {
            var cuerpo = ConstruirInformePedido(_productosParaComprar, _proveedores);
            await EmailService.EnviarInformePedidoAsync(cuerpo);
            Snackbar.Add("Pedido agrupado por proveedor enviado por email", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _generandoPedido = false;
        }
    }

    private static string ConstruirInformePedido(IEnumerable<Producto> productos, IEnumerable<Proveedor> proveedores)
    {
        var proveedoresPorId = proveedores.ToDictionary(p => p.Id);
        var grupos = productos
            .GroupBy(p => p.ProveedorId.HasValue && proveedoresPorId.ContainsKey(p.ProveedorId.Value) ? p.ProveedorId : null)
            .OrderBy(g => g.Key is null)
            .ThenBy(g => proveedoresPorId[g.Key!.Value].Nombre);

        var texto = new StringBuilder();
        texto.AppendLine("Pedido agrupado por proveedor:");
        texto.AppendLine();

        foreach (var grupo in grupos)
        {
            var titulo = grupo.Key.HasValue ? proveedoresPorId[grupo.Key.Value].Nombre : "Sin proveedor asignado";
            texto.AppendLine(titulo);
            foreach (var producto in grupo)
                texto.AppendLine($"  - {producto.Nombre} — {producto.CantidadAComprar}");
            texto.AppendLine();
        }

        return texto.ToString();
    }

    private async Task ConfirmarEliminarAsync(int id, string nombre)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, $"¿Seguro que quieres eliminar '{nombre}'? Esta acción no se puede deshacer." },
            { x => x.ConfirmText, "Eliminar" },
            { x => x.CancelText, "Cancelar" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Eliminar producto", parameters);
        var resultado = await dialog.Result;

        if (resultado is not null && !resultado.Canceled)
            await EliminarAsync(id, nombre);
    }

    private async Task EliminarAsync(int id, string nombre)
    {
        var resultado = await ProductoService.DeleteAsync(id);
        if (resultado.IsSuccess)
        {
            Snackbar.Add($"Producto '{nombre}' eliminado correctamente", Severity.Success);
            _productos = await ProductoService.GetAllAsync();
        }
        else
        {
            Snackbar.Add(resultado.Error.Message, Severity.Error);
        }
    }
}
