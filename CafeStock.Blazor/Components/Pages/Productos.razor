@page "/productos"
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject CafeStock.Blazor.Services.PdfService PdfService
@inject CafeStock.Blazor.Services.EmailService EmailService

<PageTitle>Stock</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Stock</MudText>
</div>

<div class="d-flex gap-2 mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Checklist"
               Href="/stock/realizar">
        Realizar stock
    </MudButton>
    @if (_productosParaComprar.Any())
    {
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Storefront"
                   OnClick="GenerarPedido"
                   Disabled="_generandoPedido">
            @(_generandoPedido ? "Generando..." : "Generar pedido")
        </MudButton>
    }
</div>

<div class="d-flex justify-center mb-4">
    <MudPaper Elevation="3" Style="border-radius:9999px; max-width:400px; width:100%; padding:2px 20px;">
        <MudTextField T="string"
                      @bind-Value="_busqueda"
                      Immediate="true"
                      Placeholder="Buscar producto..."
                      Variant="Variant.Text"
                      Underline="false"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"/>
    </MudPaper>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <MudChip T="string" Color="@(_todosSeleccionado ? Color.Primary : Color.Default)"
             Variant="@(_todosSeleccionado ? Variant.Filled : Variant.Outlined)"
             OnClick="@(() => { _proveedorSeleccionado = null; _todosSeleccionado = true; })">
        Todos
    </MudChip>
    @foreach (var proveedor in _proveedores)
    {
        <MudChip T="string" Color="@(_proveedorSeleccionado == proveedor.Id ? Color.Primary : Color.Default)"
                 Variant="@(_proveedorSeleccionado == proveedor.Id ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => { _proveedorSeleccionado = proveedor.Id; _todosSeleccionado = false; })">
            @proveedor.Nombre
        </MudChip>
    }
</div>

@if (_proveedorSeleccionadoObj is not null)
{
    <div class="d-flex align-center mb-4" style="gap:1rem;">
        @if (!string.IsNullOrWhiteSpace(_proveedorSeleccionadoObj.ImagenUrl))
        {
            <div style="width:144px; height:144px; border-radius:8px; overflow:hidden; flex-shrink:0; background-color:#F5F0EB;">
                <img src="@_proveedorSeleccionadoObj.ImagenUrl" alt="@_proveedorSeleccionadoObj.Nombre"
                     style="width:100%; height:100%; object-fit:contain; object-position:center; display:block;"/>
            </div>
        }
        else
        {
            <div class="d-flex align-center justify-center flex-shrink-0"
                 style="width:144px; height:144px; background-color:#F5F0EB; border-radius:8px;">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size:4rem; color:#6D4C41;"/>
            </div>
        }
        <MudText Typo="Typo.h6" Style="color:#3E2723;">@_proveedorSeleccionadoObj.Nombre</MudText>
    </div>
}

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_filtroActivo)
{
    <MudAlert Severity="Severity.Info">Elige "Todos" o un proveedor para ver los productos.</MudAlert>
}
else if (!_productosFiltrados.Any())
{
    <MudAlert Severity="Severity.Info">No hay productos que coincidan con estos filtros.</MudAlert>
}
else
{
    <MudTable Items="_productosFiltrados" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Actual</MudTh>
            <MudTh>Necesario</MudTh>
            <MudTh>Máximo</MudTh>
            <MudTh>Precio</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Actual">@context.StockActual</MudTd>
            <MudTd DataLabel="Necesario">
                <MudText Style="@($"color:{(context.CantidadAComprar > 0 ? "#993C1D" : "#3B6D11")}; font-weight:500;")">
                    @context.CantidadAComprar
                </MudText>
            </MudTd>
            <MudTd DataLabel="Máximo">@context.StockMaximo</MudTd>
            <MudTd DataLabel="Precio">@context.PrecioUnitario.ToString("F2") €</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    // Permite llegar a esta página ya filtrada por proveedor (p.ej. desde el botón
    // "Ver productos" de Facturas), reutilizando el mismo filtro por chips de siempre.
    [SupplyParameterFromQuery(Name = "proveedorId")]
    [Parameter]
    public int? ProveedorIdInicial { get; set; }

    private IEnumerable<Producto> _productos = [];
    private IEnumerable<Proveedor> _proveedores = [];
    private IEnumerable<Producto> _productosParaComprar = [];
    private bool _cargando = true;
    private bool _generandoPedido;
    private string _busqueda = string.Empty;
    private int? _proveedorSeleccionado;
    private bool _todosSeleccionado;

    private Proveedor? _proveedorSeleccionadoObj =>
        _proveedores.FirstOrDefault(p => p.Id == _proveedorSeleccionado);

    private bool _filtroActivo => _todosSeleccionado || _proveedorSeleccionado is not null;

    private IEnumerable<Producto> _productosFiltrados =>
        !_filtroActivo
            ? []
            : _productos
                .Where(p => string.IsNullOrWhiteSpace(_busqueda) || p.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
                .Where(p => _proveedorSeleccionado is null || p.ProveedorId == _proveedorSeleccionado);

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await ProveedorService.GetAllAsync();
        _productos = await ProductoService.GetAllAsync();
        _productosParaComprar = await ProductoService.GetProductosBajoMinimoAsync();

        if (ProveedorIdInicial is not null)
        {
            _proveedorSeleccionado = ProveedorIdInicial;
        }

        _cargando = false;
    }

    private async Task GenerarPedido()
    {
        _generandoPedido = true;
        try
        {
            var pdf = PdfService.GenerarInformePedido(_productosParaComprar, _proveedores);
            await EmailService.EnviarInformePedidoAsync(pdf);
            Snackbar.Add("Pedido agrupado por proveedor enviado por email", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _generandoPedido = false;
        }
    }

}
