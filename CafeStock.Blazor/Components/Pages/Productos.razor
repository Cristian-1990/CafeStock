@page "/productos"
@rendermode InteractiveServer
@inject IProductoService ProductoService
@inject NavigationManager Navigation

<PageTitle>Productos</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4" Style="color:#3E2723;">Productos</MudText>

<MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Add"
           Href="/productos/nuevo"
           Class="mb-4">
    Añadir producto
</MudButton>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_productos.Any())
{
    <MudAlert Severity="Severity.Info">No hay productos registrados.</MudAlert>
}
else
{
    <MudTable Items="_productos" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Stock actual</MudTh>
            <MudTh>Stock máximo</MudTh>
            <MudTh>Cantidad a comprar</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Stock actual">@context.StockActual</MudTd>
            <MudTd DataLabel="Stock máximo">@context.StockMaximo</MudTd>
            <MudTd DataLabel="Cantidad a comprar">
                <MudText Style="@($"color:{(context.CantidadAComprar > 0 ? "#993C1D" : "#3B6D11")}; font-weight:500;")">
                    @context.CantidadAComprar
                </MudText>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Href="@($"/productos/editar/{context.Id}")"
                           Class="mr-2">
                    Editar
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="() => EliminarAsync(context.Id)">
                    Eliminar
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IEnumerable<Producto> _productos = [];
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        _productos = await ProductoService.GetAllAsync();
        _cargando = false;
    }

    private async Task EliminarAsync(int id)
    {
        var resultado = await ProductoService.DeleteAsync(id);
        if (resultado.IsSuccess)
            _productos = await ProductoService.GetAllAsync();
    }
}