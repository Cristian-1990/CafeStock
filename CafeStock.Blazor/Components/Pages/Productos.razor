@page "/productos"
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject NavigationManager Navigation

<PageTitle>Productos</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Productos</MudText>
</div>

<div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Href="/productos/nuevo"
               Class="mb-4">
        Añadir producto
    </MudButton>
</div>

<div class="d-flex justify-center mb-4">
    <MudPaper Elevation="3" Style="border-radius:9999px; max-width:400px; width:100%; padding:2px 20px;">
        <MudTextField T="string"
                      @bind-Value="_busqueda"
                      Immediate="true"
                      Placeholder="Buscar producto..."
                      Variant="Variant.Text"
                      Underline="false"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"/>
    </MudPaper>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <MudChip T="string" Color="@(_proveedorSeleccionado is null ? Color.Primary : Color.Default)"
             Variant="@(_proveedorSeleccionado is null ? Variant.Filled : Variant.Outlined)"
             OnClick="@(() => _proveedorSeleccionado = null)">
        Todos
    </MudChip>
    @foreach (var proveedor in _proveedores)
    {
        <MudChip T="string" Color="@(_proveedorSeleccionado == proveedor.Id ? Color.Primary : Color.Default)"
                 Variant="@(_proveedorSeleccionado == proveedor.Id ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => _proveedorSeleccionado = proveedor.Id)">
            @proveedor.Nombre
        </MudChip>
    }
</div>

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_productosFiltrados.Any())
{
    <MudAlert Severity="Severity.Info">No hay productos que coincidan con estos filtros.</MudAlert>
}
else
{
    <MudTable Items="_productosFiltrados" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Stock actual</MudTh>
            <MudTh>Stock máximo</MudTh>
            <MudTh>Cantidad a comprar</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Stock actual">@context.StockActual</MudTd>
            <MudTd DataLabel="Stock máximo">@context.StockMaximo</MudTd>
            <MudTd DataLabel="Cantidad a comprar">
                <MudText Style="@($"color:{(context.CantidadAComprar > 0 ? "#993C1D" : "#3B6D11")}; font-weight:500;")">
                    @context.CantidadAComprar
                </MudText>
            </MudTd>
            <MudTd DataLabel="Acciones">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit"
                           Href="@($"/productos/editar/{context.Id}")"
                           Class="mr-2">
                    Editar
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="() => EliminarAsync(context.Id)">
                    Eliminar
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IEnumerable<Producto> _productos = [];
    private IEnumerable<Proveedor> _proveedores = [];
    private bool _cargando = true;
    private string _busqueda = string.Empty;
    private int? _proveedorSeleccionado;

    private IEnumerable<Producto> _productosFiltrados =>
        _productos
            .Where(p => string.IsNullOrWhiteSpace(_busqueda) || p.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
            .Where(p => _proveedorSeleccionado is null || p.ProveedorId == _proveedorSeleccionado);

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await ProveedorService.GetAllAsync();
        _productos = await ProductoService.GetAllAsync();
        _cargando = false;
    }

    private async Task EliminarAsync(int id)
    {
        var resultado = await ProductoService.DeleteAsync(id);
        if (resultado.IsSuccess)
            _productos = await ProductoService.GetAllAsync();
    }
}
