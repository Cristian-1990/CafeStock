@page "/productos"
@attribute [Authorize(Policy = Politicas.Trabajador)]
@inject IProductoService ProductoService
@inject IProveedorService ProveedorService
@inject NavigationManager Navigation

<PageTitle>Stock</PageTitle>

<div class="mb-4" style="background-color:rgba(109,76,65,0.10); border-radius:12px; padding:16px 24px; display:inline-block;">
    <MudText Typo="Typo.h4" Style="color:#3E2723; margin:0;">Stock</MudText>
</div>

@* Acceso directo a hacer el stock de cada proveedor: un toque en su logo abre Realizar stock ya
   con ese proveedor elegido. El número indica cuántos productos suyos hay por reponer. *@
@if (!_cargando && _proveedores.Any())
{
    <section class="stock-proveedores" aria-labelledby="stock-proveedores-titulo">
        <h2 id="stock-proveedores-titulo" class="stock-proveedores-titulo">Hacer stock de…</h2>
        <div class="stock-proveedores-lista">
            @foreach (var proveedor in _proveedoresOrdenados)
            {
                var porReponer = _porReponerPorProveedor.GetValueOrDefault(proveedor.Id);
                <a class="logo-proveedor" href="/stock/realizar?proveedorId=@proveedor.Id"
                   style="--proveedor-color:@PaletaProveedores.ColorDe(proveedor)"
                   aria-label="Hacer stock de @proveedor.Nombre">
                    <span class="logo-proveedor-imagen">
                        @if (!string.IsNullOrWhiteSpace(proveedor.ImagenUrl))
                        {
                            <img src="@proveedor.ImagenUrl" alt="" loading="lazy" decoding="async"/>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="logo-proveedor-icono"/>
                        }
                        @if (porReponer > 0)
                        {
                            <span class="logo-proveedor-cuenta">@porReponer</span>
                        }
                    </span>
                    <span class="logo-proveedor-nombre">@proveedor.Nombre</span>
                </a>
            }
        </div>
    </section>
}

<div class="d-flex justify-center mb-4">
    <MudPaper Elevation="3" Style="border-radius:9999px; max-width:400px; width:100%; padding:2px 20px;">
        <MudTextField T="string"
                      @bind-Value="_busqueda"
                      Immediate="true"
                      Placeholder="Buscar producto..."
                      Variant="Variant.Text"
                      Underline="false"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"/>
    </MudPaper>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <MudChip T="string" Color="@(_todosSeleccionado ? Color.Primary : Color.Default)"
             Variant="@(_todosSeleccionado ? Variant.Filled : Variant.Outlined)"
             OnClick="@(() => { _proveedorSeleccionado = null; _todosSeleccionado = true; })">
        Todos
    </MudChip>
    @foreach (var proveedor in _proveedoresOrdenados)
    {
        <MudChip T="string" Color="@(_proveedorSeleccionado == proveedor.Id ? Color.Primary : Color.Default)"
                 Variant="@(_proveedorSeleccionado == proveedor.Id ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => { _proveedorSeleccionado = proveedor.Id; _todosSeleccionado = false; })">
            <span class="punto-proveedor" style="background-color:@PaletaProveedores.ColorDe(proveedor)"></span>@proveedor.Nombre
        </MudChip>
    }
</div>

@* Orden de la tabla: A–Z o por urgencia (los productos por reponer primero, del más urgente al menos). *@
@if (_filtroActivo)
{
    <div class="d-flex flex-wrap align-center gap-2 mb-4">
        <MudText Typo="Typo.overline" Style="color:#6D4C41;">Orden</MudText>
        <MudChip T="string" Color="@(_ordenUrgencia ? Color.Default : Color.Primary)"
                 Variant="@(_ordenUrgencia ? Variant.Outlined : Variant.Filled)"
                 OnClick="@(() => _ordenUrgencia = false)">
            A–Z
        </MudChip>
        <MudChip T="string" Color="@(_ordenUrgencia ? Color.Primary : Color.Default)"
                 Variant="@(_ordenUrgencia ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => _ordenUrgencia = true)">
            Más urgentes primero
        </MudChip>
    </div>
}

@if (_proveedorSeleccionadoObj is not null)
{
    <div class="d-flex align-center mb-4" style="gap:1rem;">
        @if (!string.IsNullOrWhiteSpace(_proveedorSeleccionadoObj.ImagenUrl))
        {
            <div style="width:144px; height:144px; border-radius:8px; overflow:hidden; flex-shrink:0; background-color:#F5F0EB;">
                <img src="@_proveedorSeleccionadoObj.ImagenUrl" alt="@_proveedorSeleccionadoObj.Nombre"
                     style="width:100%; height:100%; object-fit:contain; object-position:center; display:block;"/>
            </div>
        }
        else
        {
            <div class="d-flex align-center justify-center flex-shrink-0"
                 style="width:144px; height:144px; background-color:#F5F0EB; border-radius:8px;">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="font-size:4rem; color:#6D4C41;"/>
            </div>
        }
        <MudText Typo="Typo.h6" Style="color:#3E2723;">@_proveedorSeleccionadoObj.Nombre</MudText>
    </div>

    @* Supermercados (Alcampo...): por defecto A–Z; el orden por pasillo, que sigue el recorrido de la
       tienda, queda a un toque. *@
    @if (_proveedorSeleccionadoObj.EsSupermercadoGenerico)
    {
        <div class="d-flex flex-wrap align-center gap-2 mb-4">
            <MudText Typo="Typo.overline" Style="color:#6D4C41;">Orden</MudText>
            <MudChip T="string" Color="@(_ordenPasillo && !_ordenUrgencia ? Color.Default : Color.Primary)"
                     Variant="@(_ordenPasillo && !_ordenUrgencia ? Variant.Outlined : Variant.Filled)"
                     OnClick="@(() => { _ordenPasillo = false; _ordenUrgencia = false; })">
                A–Z
            </MudChip>
            <MudChip T="string" Color="@(_ordenPasillo && !_ordenUrgencia ? Color.Primary : Color.Default)"
                     Variant="@(_ordenPasillo && !_ordenUrgencia ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => { _ordenPasillo = true; _ordenUrgencia = false; })">
                Por pasillo
            </MudChip>
        </div>
    }
}

@if (_cargando)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else if (!_filtroActivo)
{
    <MudAlert Severity="Severity.Info">Elige "Todos" o un proveedor para ver los productos.</MudAlert>
}
else if (!_productosFiltrados.Any())
{
    <MudAlert Severity="Severity.Info">No hay productos que coincidan con estos filtros.</MudAlert>
}
else
{
    <MudTable Items="_productosFiltrados" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Nivel</MudTh>
            <MudTh>Actual</MudTh>
            <MudTh>Necesario</MudTh>
            <MudTh>Máximo</MudTh>
            <MudTh>Precio</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
            <MudTd DataLabel="Nivel">
                <span class="medidor @NivelStock.Clase(context.StockActual, context.StockMaximo)" style="display:inline-block; width:90px; vertical-align:middle;"
                      role="img" aria-label="Stock @context.StockActual de @context.StockMaximo">
                    <span class="medidor-relleno" style="width:@(NivelStock.Porcentaje(context.StockActual, context.StockMaximo))%"></span>
                </span>
            </MudTd>
            <MudTd DataLabel="Actual">@context.StockActual</MudTd>
            <MudTd DataLabel="Necesario">
                <MudText Style="@($"color:{(context.CantidadAComprar > 0 ? "#993C1D" : "#3B6D11")}; font-weight:500;")">
                    @context.CantidadAComprar
                </MudText>
            </MudTd>
            <MudTd DataLabel="Máximo">@context.StockMaximo</MudTd>
            <MudTd DataLabel="Precio">@context.PrecioUnitario.ToString(FormatoPrecio(context)) €</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    // Permite llegar a esta página ya filtrada por proveedor (p.ej. desde el botón
    // "Ver productos" de Facturas), reutilizando el mismo filtro por chips de siempre.
    [SupplyParameterFromQuery(Name = "proveedorId")]
    [Parameter]
    public int? ProveedorIdInicial { get; set; }

    private IEnumerable<Producto> _productos = [];
    private IEnumerable<Proveedor> _proveedores = [];
    private List<Proveedor> _proveedoresOrdenados = [];
    private Dictionary<int, int> _porReponerPorProveedor = [];
    private bool _cargando = true;
    private string _busqueda = string.Empty;
    private int? _proveedorSeleccionado;
    private bool _todosSeleccionado;
    private bool _ordenPasillo;
    private bool _ordenUrgencia;

    // ?orden=urgencia: llega con "Todos" elegido y los productos por orden de urgencia.
    [SupplyParameterFromQuery(Name = "orden")]
    [Parameter]
    public string? OrdenInicial { get; set; }

    private Proveedor? _proveedorSeleccionadoObj =>
        _proveedores.FirstOrDefault(p => p.Id == _proveedorSeleccionado);

    private bool _filtroActivo => _todosSeleccionado || _proveedorSeleccionado is not null;

    /// <summary>
    /// "F4" (4 decimales) para productos de un proveedor con Proveedor.PrecioUnitarioAltaPrecision
    /// activo (p.ej. Priegola), "F2" (los 2 habituales) para el resto (p.ej. Alcampo).
    /// </summary>
    private string FormatoPrecio(Producto producto) =>
        _proveedores.FirstOrDefault(p => p.Id == producto.ProveedorId)?.PrecioUnitarioAltaPrecision == true
            ? "F4"
            : "F2";

    // Siempre A–Z (ver OrdenAlfabetico), salvo que se pida el orden por pasillo en un supermercado:
    // entonces por pasillo (los sin pasillo al final), posición dentro del pasillo y nombre.
    private IEnumerable<Producto> _productosFiltrados
    {
        get
        {
            if (!_filtroActivo) return [];

            var filtrados = _productos
                .Where(p => string.IsNullOrWhiteSpace(_busqueda) || p.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
                .Where(p => _proveedorSeleccionado is null || p.ProveedorId == _proveedorSeleccionado)
                .ToList();

            // Por urgencia (viene de "Ver todos" en Inicio): primero los que hay que reponer, del más urgente
            // al menos (ver NivelStock.PorUrgencia), y detrás los que están completos, A–Z.
            if (_ordenUrgencia)
            {
                var urgentes = NivelStock.PorUrgencia(filtrados);
                var resto = filtrados.Except(urgentes).OrdenarAlfabeticamente(p => p.Nombre);
                return urgentes.Concat(resto).ToList();
            }

            var porPasillo = _ordenPasillo && _proveedorSeleccionadoObj?.EsSupermercadoGenerico == true;
            return porPasillo
                ? filtrados
                    .OrderBy(p => p.Pasillo ?? int.MaxValue)
                    .ThenBy(p => p.OrdenEnPasillo)
                    .LuegoAlfabeticamente(p => p.Nombre)
                    .ToList()
                : filtrados.OrdenarAlfabeticamente(p => p.Nombre).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _proveedores = await ProveedorService.GetAllAsync();
        _proveedoresOrdenados = _proveedores.OrdenarAlfabeticamente(p => p.Nombre).ToList();
        _productos = await ProductoService.GetAllAsync();
        _porReponerPorProveedor = _productos
            .Where(p => p.ProveedorId is not null && p.CantidadAComprar > 0)
            .GroupBy(p => p.ProveedorId!.Value)
            .ToDictionary(g => g.Key, g => g.Count());

        if (ProveedorIdInicial is not null)
        {
            _proveedorSeleccionado = ProveedorIdInicial;
        }

        if (string.Equals(OrdenInicial, "urgencia", StringComparison.OrdinalIgnoreCase))
        {
            _ordenUrgencia = true;
            if (_proveedorSeleccionado is null) _todosSeleccionado = true;
        }

        _cargando = false;
    }
}
