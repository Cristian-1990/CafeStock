<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["CafeStock.Blazor.styles.css"]"/>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet"/>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <link rel="icon" type="image/png" sizes="192x192" href="icons/icon-192.png"/>
    <link rel="apple-touch-icon" href="icons/icon-192.png"/>
    <link rel="manifest" href="/manifest.json"/>
    <meta name="theme-color" content="#6F4E37"/>
    <script>try{var t=localStorage.getItem("cafestock.tema");if(t)document.documentElement.setAttribute("data-tema",t)}catch(e){}</script>
    <HeadOutlet/>
</head>

<body>
<Routes @rendermode="InteractiveServer"/>
<ReconnectModal/>
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="_content/MudBlazor/MudBlazor.min.js"></script>
<script>
    // Foto que no carga (fichero que no existe en este equipo, borrado...): se sustituye por una
    // imagen de reserva en vez de enseñar el icono de imagen rota con su texto alternativo.
    // Los eventos "error" no burbujean: se captura en el documento. data-sin-imagen evita un
    // bucle si la propia imagen de reserva fallara.
    document.addEventListener('error', (e) => {
        const img = e.target;
        if (img && img.tagName === 'IMG' && !img.dataset.sinImagen) {
            img.dataset.sinImagen = '1';
            img.src = '/images/sin-imagen.svg';
        }
    }, true);
</script>
<script>
    // Registra el service worker mínimo (ver wwwroot/service-worker.js) que
    // permite instalar CafeStock como PWA con ventana propia.
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/service-worker.js');
        });
    }
</script>
<script>
    // Recuerda qué tarjeta de producto se abrió desde el listado para poder
    // volver a su misma posición al pulsar "atrás" (ver ListaDetallada.razor).
    window.cafeStock = {
        recordarProducto: (id) => {
            try { sessionStorage.setItem('lista-detallada:ultimo', String(id)); } catch (e) { }
        },
        irAlProducto: () => {
            try {
                const id = sessionStorage.getItem('lista-detallada:ultimo');
                if (!id) return;
                sessionStorage.removeItem('lista-detallada:ultimo');
                const el = document.getElementById('prod-' + id);
                if (el) el.scrollIntoView({ block: 'center' });
            } catch (e) { }
        }
    };
</script>
<script>
    // Login: recuerda el USUARIO (nunca la contraseña) en este navegador si la casilla "Recordar contraseña en
    // este equipo" está marcada, y lo rellena la próxima vez. Se engancha al cargar y también tras una
    // navegación mejorada de Blazor, por si se llega al login sin recargar la página.
    (function () {
        const CLAVE = 'cafestock.usuario';
        function iniciar() {
            const form = document.getElementById('formulario-login');
            if (!form || form.dataset.recordar) return;
            form.dataset.recordar = '1';
            const usuario = form.querySelector('#usuario');
            const casilla = form.querySelector('#recordar');
            const password = form.querySelector('#password');
            try {
                const guardado = localStorage.getItem(CLAVE);
                if (guardado && usuario && !usuario.value) {
                    usuario.value = guardado;
                    if (password) password.focus();
                }
            } catch (e) { }
            form.addEventListener('submit', () => {
                try {
                    if (casilla && casilla.checked && usuario && usuario.value.trim()) localStorage.setItem(CLAVE, usuario.value.trim());
                    else localStorage.removeItem(CLAVE);
                } catch (e) { }
            });
        }
        document.addEventListener('DOMContentLoaded', iniciar);
        document.addEventListener('enhancedload', iniciar);
        if (document.readyState !== 'loading') iniciar();
    })();
</script>
<script>
    window.descargarArchivo = (nombreArchivo, base64) => {
        const enlace = document.createElement('a');
        enlace.href = "data:application/pdf;base64," + base64;
        enlace.download = nombreArchivo;
        document.body.appendChild(enlace);
        enlace.click();
        document.body.removeChild(enlace);
    };
</script>
</body>

</html>