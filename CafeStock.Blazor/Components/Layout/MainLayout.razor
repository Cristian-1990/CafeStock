@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1">
        <img src="LogoCafeteria.png" alt="Logo" style="height:40px; margin-right:12px; background-color:white; border-radius:50%; padding:2px;"/>
        <MudText Typo="Typo.h5" Style="color:#FFFFFF;">CafeStock</MudText>
    </MudAppBar>

    <MudDrawer Open="true" Elevation="2" Variant="@DrawerVariant.Persistent">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Inicio</MudNavLink>
            <MudNavLink Href="proveedores" Icon="@Icons.Material.Filled.LocalShipping">Proveedores</MudNavLink>
            <MudNavLink Href="lista-detallada" Icon="@Icons.Material.Filled.ViewModule">Productos</MudNavLink>
            <MudNavLink Href="productos" Icon="@Icons.Material.Filled.Inventory2">Stock</MudNavLink>
            <MudNavLink Href="vender" Icon="@Icons.Material.Filled.LocalCafe">Vender</MudNavLink>
            <MudNavLink Href="lista-compra" Icon="@Icons.Material.Filled.ShoppingCart">Compra</MudNavLink>
            <MudNavLink Href="facturas" Icon="@Icons.Material.Filled.Receipt">Facturas</MudNavLink>
            <MudNavLink Href="informes" Icon="@Icons.Material.Filled.Insights">Informes</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6D4C41",
            Secondary = "#8D6E63",
            AppbarBackground = "#6D4C41",
            Background = "#EFE6DA",
            Surface = "#FFFBF5",
            DrawerBackground = "#B8956A",
            DrawerText = "#3E2723",
            DrawerIcon = "#3E2723",
            TextPrimary = "#2C2C2A",
            Error = "#993C1D",
            Dark = "#3E2723"
        }
    };
}