@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Elevation="1" Style="background-color:#1A1A1A;">
        <img src="LogoCafeteria.png" alt="Logo" style="height:40px; margin-right:12px; background-color:white; border-radius:50%; padding:2px;"/>
        <MudText Typo="Typo.h5" Style="color:#FFFFFF;">CafeStock</MudText>
    </MudAppBar>

    <MudDrawer Open="true" Elevation="2" Variant="@DrawerVariant.Persistent">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Inicio</MudNavLink>
            <MudNavLink Href="productos" Icon="@Icons.Material.Filled.Inventory2">Productos</MudNavLink>
            <MudNavLink Href="lista-compra" Icon="@Icons.Material.Filled.ShoppingCart">Lista de la compra</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6D4C41",
            Secondary = "#8D6E63",
            AppbarBackground = "#1A1A1A",
            Background = "#FFFFFF",
            Surface = "#FFFFFF",
            DrawerBackground = "#F5F0EB",
            DrawerText = "#3E2723",
            TextPrimary = "#2C2C2A",
            Error = "#993C1D"
        }
    };
}