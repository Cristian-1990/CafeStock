@inherits LayoutComponentBase
@inject IWebHostEnvironment WebHostEnvironment

<MudThemeProvider Theme="_theme"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    @* Aviso de modo pruebas en Development (dotnet run, ver Program.cs) — usa cafestock-test.db,
       NUNCA la base de datos real, pero no debe confundirse a simple vista con la app de
       producción cuando ambas corren a la vez en la Pi. Antes era toda la barra en rojo, que
       desentonaba con el diseño; ahora la barra es la misma y el aviso son una pastilla terracota
       junto al nombre y una franja terracota bajo la barra: se sigue viendo de lejos, pero
       dentro de la paleta. *@
    <MudAppBar Elevation="1" Class="@(WebHostEnvironment.IsDevelopment() ? "appbar--pruebas" : null)">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Class="d-md-none mr-2"
                       aria-label="Abrir menú" OnClick="@(() => _menuAbierto = !_menuAbierto)"/>
        <img src="LogoCafeteria.png" alt="Logo" class="d-none d-sm-inline" style="height:40px; margin-right:12px; background-color:white; border-radius:50%; padding:2px;"/>
        <MudText Typo="Typo.h5" Style="color:#FFFFFF; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
            CafeStock
        </MudText>
        @if (WebHostEnvironment.IsDevelopment())
        {
            @* Texto corto en pantallas estrechas: el largo partía la cabecera en varias líneas. *@
            <span class="pastilla-pruebas" role="status">
                <span class="d-none d-sm-inline">Modo pruebas · datos no reales</span>
                <span class="d-sm-none">Pruebas</span>
            </span>
        }
        <MudSpacer/>
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Style="color:#FFFFFF;" Class="mr-3 d-none d-sm-block">
                    @context.User.Identity?.Name · @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                </MudText>
                @* POST normal a /auth/logout: cerrar sesión borra la cookie, algo que solo se puede
                   hacer en una respuesta HTTP, no desde el circuito interactivo. *@
                <form method="post" action="/auth/logout" style="margin:0;">
                    <AntiforgeryToken/>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Logout" Style="color:#FFFFFF; border-color:#FFFFFF;">
                        Salir
                    </MudButton>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    @* Width 320px (por defecto 240px): sitio para que AppMascot quepa dentro de la columna
       de navegación sin invadir la zona de contenido — ver AppMascot.razor.css. *@
    @* Responsive: fijo a la izquierda desde el breakpoint Md (≥960 px) y, en tablet vertical y
       móvil, un panel que se abre con el botón de la cabecera y deja el contenido a ancho completo. *@
    <MudDrawer @bind-Open="_menuAbierto" Elevation="2" Variant="@DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md" Width="min(320px, 85vw)">
        <MudNavMenu>
            @* Cada enlace solo aparece si el rol del usuario puede entrar (ver Politicas). Ocultar el
               enlace es comodidad; la protección real está en el atributo [Authorize] de cada página. *@
            <AuthorizeView Policy="@Politicas.Trabajador">
                <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Inicio</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Politicas.Encargado">
                <MudNavLink Href="proveedores" Icon="@Icons.Material.Filled.LocalShipping">Proveedores</MudNavLink>
                <MudNavLink Href="lista-detallada" Icon="@Icons.Material.Filled.ViewModule">Productos</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Politicas.Trabajador">
                <MudNavLink Href="productos" Icon="@Icons.Material.Filled.Inventory2">Stock</MudNavLink>
                <MudNavLink Href="vender" Icon="@CustomIcons.CoffeeBean">Venta</MudNavLink>
                <MudNavLink Href="lista-compra" Icon="@Icons.Material.Filled.MoveToInbox">Recepcionar</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Politicas.Encargado">
                <MudNavLink Href="facturas" Icon="@Icons.Material.Filled.Receipt">Facturas</MudNavLink>
                <MudNavLink Href="informes" Icon="@Icons.Material.Filled.Insights">Informes</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Policy="@Politicas.Admin">
                <MudNavLink Href="admin/usuarios" Icon="@Icons.Material.Filled.ManageAccounts">Usuarios</MudNavLink>
            </AuthorizeView>
        </MudNavMenu>
        @* .mud-drawer-content ya es flex column a toda la altura del drawer — AppMascot se
           ancla abajo con margin-top:auto en su propio contenedor, sin envoltorio extra. *@
        <AppMascot/>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly MudTheme _theme = TemaCafeStock.Tema;

    // En pantallas anchas el menú siempre está a la vista; en estrechas empieza cerrado.
    private bool _menuAbierto = true;
}