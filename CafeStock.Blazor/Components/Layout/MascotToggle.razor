@implements IDisposable
@inject MascotSettingsService MascotSettings

@* Botón único para activar/desactivar la mascota guía. Va justo debajo del león en TODAS las
   pantallas (Inicio y el resto, ver AppMascot). Con la mascota desactivada se queda solo este pequeño
   botón, visible, para poder volver a llamarla desde la misma pantalla. El estado vive en
   MascotSettingsService (localStorage), así que apagarla en una pantalla la apaga en todas. *@
<div class="mascota-toggle" @onclick:stopPropagation="true">
    @* Solo el botón, sin texto visible: un interruptor (encendido / apagado). El nombre accesible y el
       tooltip ("Desactivar / Activar mascota guía") siguen ahí para lectores de pantalla y para el ratón. *@
    <button type="button" class="mascota-interruptor @(MascotSettings.Enabled ? "mascota-interruptor--on" : "mascota-interruptor--off")"
            title="@(MascotSettings.Enabled ? "Desactivar mascota guía" : "Activar mascota guía")"
            aria-label="@(MascotSettings.Enabled ? "Desactivar mascota guía" : "Activar mascota guía")"
            @onclick="AlternarAsync">
        <MudIcon Icon="@(MascotSettings.Enabled ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"/>
        <span>@(MascotSettings.Enabled ? "ON" : "OFF")</span>
    </button>
</div>

@code {
    protected override void OnInitialized()
    {
        MascotSettings.EnabledChanged += OnEnabledChanged;
    }

    private async Task AlternarAsync() => await MascotSettings.SetEnabledAsync(!MascotSettings.Enabled);

    private void OnEnabledChanged(bool enabled) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        MascotSettings.EnabledChanged -= OnEnabledChanged;
    }
}
