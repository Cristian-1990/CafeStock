@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject IUsuarioService Usuarios
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión · CafeStock</PageTitle>

<div class="acceso-tarjeta">
    <img src="LogoCafeteria.png" alt="CafeStock" class="acceso-logo"/>
    <p class="acceso-eyebrow">Café de especialidad</p>
    <h1 class="acceso-titulo">CafeStock</h1>
    <p class="acceso-subtitulo">Inicia sesión para continuar</p>

    @if (Error is not null)
    {
        <div class="acceso-error" role="alert">
            @(Error == "bloqueado"
                ? "Demasiados intentos fallidos. Espera 5 minutos e inténtalo de nuevo."
                : "Usuario o contraseña incorrectos.")
        </div>
    }

    @* POST normal a un endpoint (no un formulario de Blazor): la cookie de sesión solo se
       puede escribir en una respuesta HTTP, no dentro del circuito interactivo. *@
    <form id="formulario-login" method="post" action="/auth/login">
        <AntiforgeryToken/>
        <input type="hidden" name="returnUrl" value="@ReturnUrl"/>

        <label for="usuario">Usuario</label>
        <input id="usuario" name="usuario" type="text" autocomplete="username" autocapitalize="none" required autofocus/>

        <label for="password">Contraseña</label>
        @* Botón para ver lo que se escribe (útil en el móvil, donde es fácil equivocarse). Es JavaScript de
           toda la vida y no C#: el formulario es un POST normal y, así, funciona también antes de que
           arranque el circuito interactivo de Blazor. *@
        <div class="acceso-campo-password">
            <input id="password" name="password" type="password" autocomplete="current-password" required/>
            <button type="button" class="acceso-ojo" aria-controls="password" aria-pressed="false"
                    onclick="var i=document.getElementById('password'),v=i.type==='password';i.type=v?'text':'password';this.textContent=v?'Ocultar':'Mostrar';this.setAttribute('aria-pressed',v);">Mostrar</button>
        </div>

        @* Recordar contraseña en este equipo: marcada (por defecto, como siempre), la sesión sigue al cerrar el
           navegador; sin marcar, termina al cerrarlo (ver /auth/login). Además recuerda el usuario en este
           navegador. La contraseña NUNCA se guarda: de eso se encarga, si quiere, el gestor del navegador. El
           usuario se guarda con JavaScript de toda la vida (en App.razor), no con C#, porque el
           formulario es un POST normal. *@
        <label class="acceso-recordar" for="recordar">
            <input id="recordar" name="recordar" type="checkbox" value="true" checked/>
            Recordar contraseña en este equipo
        </label>

        <button type="submit">Entrar</button>

        @* Sin correo asociado a las cuentas no hay recuperación automática: se pide a un administrador, que
           puede restablecerla desde Usuarios. *@
        <details class="acceso-olvido">
            <summary>¿Has olvidado tu contraseña?</summary>
            <p>Pide a un administrador que te la restablezca desde <strong>Usuarios</strong>. Te dará una nueva y podrás entrar con ella.</p>
        </details>
    </form>
</div>

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Sin ningún usuario todavía: es la primera vez que se arranca la app.
        if (!await Usuarios.HayUsuariosAsync())
        {
            Navigation.NavigateTo("/primer-acceso", forceLoad: true);
            return;
        }

        // Ya con sesión iniciada no tiene sentido ver el formulario.
        var estado = EstadoAutenticacion is null ? null : await EstadoAutenticacion;
        if (estado?.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/", forceLoad: true);
    }
}
