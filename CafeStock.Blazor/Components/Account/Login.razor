@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject IUsuarioService Usuarios
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión · CafeStock</PageTitle>

<div class="acceso-tarjeta">
    <img src="LogoCafeteria.png" alt="CafeStock" class="acceso-logo"/>
    <h1 class="acceso-titulo">CafeStock</h1>
    <p class="acceso-subtitulo">Inicia sesión para continuar</p>

    @if (Error is not null)
    {
        <div class="acceso-error" role="alert">
            @(Error == "bloqueado"
                ? "Demasiados intentos fallidos. Espera 5 minutos e inténtalo de nuevo."
                : "Usuario o contraseña incorrectos.")
        </div>
    }

    @* POST normal a un endpoint (no un formulario de Blazor): la cookie de sesión solo se
       puede escribir en una respuesta HTTP, no dentro del circuito interactivo. *@
    <form method="post" action="/auth/login">
        <AntiforgeryToken/>
        <input type="hidden" name="returnUrl" value="@ReturnUrl"/>

        <label for="usuario">Usuario</label>
        <input id="usuario" name="usuario" type="text" autocomplete="username" autocapitalize="none" required autofocus/>

        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required/>

        <button type="submit">Entrar</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery] private string? Error { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Sin ningún usuario todavía: es la primera vez que se arranca la app.
        if (!await Usuarios.HayUsuariosAsync())
        {
            Navigation.NavigateTo("/primer-acceso", forceLoad: true);
            return;
        }

        // Ya con sesión iniciada no tiene sentido ver el formulario.
        var estado = EstadoAutenticacion is null ? null : await EstadoAutenticacion;
        if (estado?.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/", forceLoad: true);
    }
}
